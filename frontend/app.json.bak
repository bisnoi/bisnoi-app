{
  "expo": {
    "name": "Bisnoi",
    "slug": "bisnoi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bisnoi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bisnoi.app",
      "config": {
        "googleMapsApiKey": "AIzaSyAnhIwEtUdoxNKXQzepzMiImy8qxQKkkkM"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Bisnoi needs photo access so you can upload menu images, restaurant photos and documents.",
        "NSCameraUsageDescription": "Bisnoi needs camera access so you can capture menu photos and documents.",
        "NSLocationWhenInUseUsageDescription": "Bisnoi uses your location to show nearby restaurants and enable live order tracking.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "bhim",
          "credpay",
          "mobikwik",
          "amazonpay",
          "upi"
        ]
      }
    },
    "android": {
      "package": "com.bisnoi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#287939"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#287939"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bisnoi needs photo access so you can upload menu images, restaurant photos and documents.",
          "cameraPermission": "Bisnoi needs camera access so you can capture menu photos and documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bisnoi uses your location to show nearby restaurants and enable live order tracking."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "./plugins/withRemovePermissions",
        [
          "android.permission.READ_EXTERNAL_STORAGE",
          "android.permission.WRITE_EXTERNAL_STORAGE"
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8843505-ee0a-48f6-9bdd-e63a401bfadb"
      }
    },
    "owner": "manub0001"
  }
}
