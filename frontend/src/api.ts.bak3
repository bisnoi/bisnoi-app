  createPayment: (body: { purpose: "customer_order" | "dinein_bill" | "onboarding_fee" | "wallet_topup"; order_id?: string; dinein_order_id?: string; restaurant_id?: string; amount?: number }) =>
    api("/payments/create-order", { method: "POST", body }),
  verifyPayment: (body: { payment_id: string; razorpay_order_id: string; razorpay_payment_id: string; razorpay_signature: string }) =>
    api("/payments/verify", { method: "POST", body }),

  // ---- Platform config (commission / per-km / onboarding) ----
  platformPublic: () => api("/settings/platform-public", { auth: false }),
  adminGetPlatform: () => api("/admin/settings/platform"),
  adminPatchPlatform: (body: Record<string, any>) => api("/admin/settings/platform", { method: "PATCH", body }),
  adminLedger: (limit = 500) => api(`/admin/ledger?limit=${limit}`),
  adminCommissionSummary: () => api("/admin/commission-summary"),

  // ---- Dine-in (customer) ----
  dineinContext: (restaurant_id: string, table_id: string, token: string) =>
    api(`/dinein/context?restaurant_id=${encodeURIComponent(restaurant_id)}&table_id=${encodeURIComponent(table_id)}&token=${encodeURIComponent(token)}`, { auth: false }),
  createDineinOrder: (body: {
    restaurant_id: string;
    table_id?: string;
    table_number?: number;
    table_label?: string;
    items: { menu_item_id: string; quantity: number }[];
    note?: string;
  }, dineinToken: string) => api("/dinein/order", { method: "POST", body, headers: { "X-Dinein-Token": dineinToken } }),
  getDineinOrder: (oid: string) => api(`/dinein/order/${oid}`),
  myDineinOrders: () => api("/dinein/mine"),
  dineinPayCounter: (oid: string) => api(`/dinein/order/${oid}/pay-counter`, { method: "POST" }),

  // ---- Dine-in (owner) ----
  ownerDineinOrders: (status?: string) =>
    api(`/owner/dinein/orders${status ? `?status=${encodeURIComponent(status)}` : ""}`),
  ownerAcceptDineinOrder: (oid: string) =>
    api(`/owner/dinein/orders/${oid}/accept`, { method: "POST" }),

  // ---- Admin: notification settings & manual broadcasts ----
  adminGetNotifSettings: () => api("/admin/settings/notifications"),
  adminUpdateNotifSettings: (body: any) =>
    api("/admin/settings/notifications", { method: "PATCH", body }),
  adminBroadcastPush: (body: { title: string; body: string; url?: string; roles: string[] }) =>
    api("/admin/push/broadcast", { method: "POST", body }),
  adminListBroadcasts: () => api("/admin/push/broadcasts"),

  // ---- Admin: menu price policy (owner hike/drop caps) ----
  adminGetPricePolicy: () => api("/admin/settings/price-policy"),
  adminSetPricePolicy: (body: any) => api("/admin/settings/price-policy", { method: "PATCH", body }),
  adminGetRestaurantPricePolicy: (rid: string) => api(`/admin/restaurants/${rid}/price-policy`),
  adminSetRestaurantPricePolicy: (rid: string, body: any) =>
    api(`/admin/restaurants/${rid}/price-policy`, { method: "PATCH", body }),
  adminClearRestaurantPricePolicy: (rid: string) =>
    api(`/admin/restaurants/${rid}/price-policy`, { method: "DELETE" }),
  // ---- Owner: read-only view of applicable price policy ----
  ownerPricePolicy: () => api("/owner/menu/price-policy"),

  // ---- Staff management (owner-side) ----
  ownerListStaff: () => api("/owner/staff"),
  ownerCreateStaff: (body: any) => api("/owner/staff", { method: "POST", body }),
  ownerCreateStaffPreset: (body: any) => api("/owner/staff/preset", { method: "POST", body }),
  ownerUpdateStaff: (sid: string, body: any) => api(`/owner/staff/${sid}`, { method: "PATCH", body }),
  ownerDeleteStaff: (sid: string) => api(`/owner/staff/${sid}`, { method: "DELETE" }),

  // ---- Staff management (admin-side) ----
  adminListStaff: () => api("/admin/staff"),
  adminCreateStaff: (body: any) => api("/admin/staff", { method: "POST", body }),
  adminCreateStaffPreset: (body: any) => api("/admin/staff/preset", { method: "POST", body }),
  adminUpdateStaff: (sid: string, body: any) => api(`/admin/staff/${sid}`, { method: "PATCH", body }),
  adminDeleteStaff: (sid: string) => api(`/admin/staff/${sid}`, { method: "DELETE" }),

  // ---- Staff self-service (both sides) ----
  meStaff: () => api("/me/staff"),
  staffModulesCatalog: () => api("/staff/modules"),

  // ---- Policy & Compliance (legal pages, cancellation, COD) ----
  // Legal content
  getLegal: (audience: "customer" | "restaurant" | "rider", key: string) =>
    api(`/legal/${audience}/${key}`, { auth: false }),
  listLegal: (audience: "customer" | "restaurant" | "rider") =>
    api(`/legal/${audience}`, { auth: false }),
  adminListLegal: () => api("/admin/legal"),
  adminUpdateLegal: (audience: string, key: string, content: any) =>
    api(`/admin/legal/${audience}/${key}`, { method: "PATCH", body: { content } }),
  adminResetLegal: (audience: string, key: string) =>
    api(`/admin/legal/${audience}/${key}/reset`, { method: "POST" }),

  // Cancellation rules
  publicCancellationRules: () => api("/settings/cancellation", { auth: false }),
  adminGetCancellationRules: () => api("/admin/settings/cancellation"),
  adminUpdateCancellationRules: (body: any) =>
    api("/admin/settings/cancellation", { method: "PATCH", body }),

  // COD rules
  adminGetCodRules: () => api("/admin/settings/cod-rules"),
  adminUpdateCodRules: (body: any) => api("/admin/settings/cod-rules", { method: "PATCH", body }),

  // Restaurant performance
  ownerPerformance: () => api("/owner/performance"),
  adminRestaurantPerformance: (rid: string) => api(`/admin/restaurants/${rid}/performance`),
  adminAllRestaurantsPerformance: () => api("/admin/restaurants-performance"),

  // Cancellation preview + execute
  previewCancelOrder: (oid: string) => api(`/orders/${oid}/cancel-preview`),
  cancelOrder: (oid: string, body: { reason?: string; reason_code?: string; genuine_reason?: boolean }) =>
    api(`/orders/${oid}/cancel`, { method: "POST", body: body || {} }),

  // Payment options (COD availability for current user)
  myPaymentOptions: () => api("/me/payment-options"),

  // Admin: customer payment status / overrides
  adminGetCustomerPayment: (uid: string) => api(`/admin/customers/${uid}/payment-status`),
  adminUpdateCustomerPayment: (uid: string, body: any) =>
    api(`/admin/customers/${uid}/payment-status`, { method: "PATCH", body }),
  adminListCustomersPayments: () => api("/admin/customers-payments"),

  // ---- Marketing (WhatsApp campaigns funded by a per-restaurant prepaid wallet) ----
  // Owner side
  marketingOverview: (restaurant_id?: string) =>
    api(`/marketing/overview${restaurant_id ? `?restaurant_id=${encodeURIComponent(restaurant_id)}` : ""}`),
  marketingCustomers: (opts: { restaurant_id?: string; segment?: string; q?: string } = {}) => {
    const p = new URLSearchParams();
    if (opts.restaurant_id) p.set("restaurant_id", opts.restaurant_id);
    if (opts.segment) p.set("segment", opts.segment);
    if (opts.q) p.set("q", opts.q);
    const qs = p.toString();
    return api(`/marketing/customers${qs ? `?${qs}` : ""}`);
  },
  marketingWallet: (restaurant_id?: string) =>
    api(`/marketing/wallet${restaurant_id ? `?restaurant_id=${encodeURIComponent(restaurant_id)}` : ""}`),
  marketingCampaigns: (restaurant_id?: string) =>
    api(`/marketing/campaigns${restaurant_id ? `?restaurant_id=${encodeURIComponent(restaurant_id)}` : ""}`),
  marketingSendCampaign: (body: { restaurant_id?: string; message: string; phones?: string[]; segment?: string }) =>
    api("/marketing/campaigns", { method: "POST", body }),
  // Customer directory (owner)
  ownerCustomersUpload: (body: { restaurant_id?: string; customers: { name?: string; phone: string; tag?: boolean }[]; replace?: boolean }) =>
    api("/owner/customers/upload", { method: "POST", body }),
  ownerCustomersDelete: (phone: string, restaurant_id?: string) =>
    api(`/owner/customers/${encodeURIComponent(phone)}${restaurant_id ? `?restaurant_id=${encodeURIComponent(restaurant_id)}` : ""}`, { method: "DELETE" }),
  ownerCustomersTemplateUrl: (restaurant_id?: string) => {
    const base = process.env.EXPO_PUBLIC_BACKEND_URL || "";
    const q = restaurant_id ? `?restaurant_id=${encodeURIComponent(restaurant_id)}` : "";
    return `${base}/api/owner/customers/template${q}`;
  },
  // Marketing templates (owner + admin) — pre-approved library + submit for approval flow
  marketingTemplates: (opts: { restaurant_id?: string; kind?: string } = {}) => {
    const p = new URLSearchParams();
    if (opts.restaurant_id) p.set("restaurant_id", opts.restaurant_id);
    if (opts.kind)          p.set("kind", opts.kind);
    const qs = p.toString();
    return api(`/marketing/templates${qs ? `?${qs}` : ""}`);
  },
  marketingSubmitTemplate: (body: { restaurant_id?: string; kind: string; name: string; body: string; submit_for_approval?: boolean }) =>
    api("/marketing/templates", { method: "POST", body }),
  marketingDeleteTemplate: (tid: string) =>
    api(`/marketing/templates/${encodeURIComponent(tid)}`, { method: "DELETE" }),
  // Admin
  adminListTemplates: (opts: { status?: string; kind?: string } = {}) => {
    const p = new URLSearchParams();
    if (opts.status) p.set("status", opts.status);
    if (opts.kind)   p.set("kind", opts.kind);
    const qs = p.toString();
    return api(`/admin/marketing/templates${qs ? `?${qs}` : ""}`);
  },
  adminCreateTemplate: (body: { kind: string; name: string; body: string }) =>
    api("/admin/marketing/templates", { method: "POST", body }),
  adminPatchTemplate: (tid: string, body: { name?: string; body?: string; kind?: string; status?: string; reject_reason?: string }) =>
    api(`/admin/marketing/templates/${encodeURIComponent(tid)}`, { method: "PATCH", body }),
  adminDeleteTemplate: (tid: string) =>
    api(`/admin/marketing/templates/${encodeURIComponent(tid)}`, { method: "DELETE" }),
  // Admin side
  adminMarketingSettings: () => api("/admin/marketing/settings"),
  adminUpdateMarketingSettings: (body: {
    per_message_rate?: number; currency?: string;
    marketing_template?: string; marketing_template_lang?: string; enabled?: boolean;
  }) => api("/admin/marketing/settings", { method: "PUT", body }),
  adminMarketingWallets: () => api("/admin/marketing/wallets"),
  adminCreditMarketingWallet: (restaurant_id: string, body: { amount: number; note?: string }) =>
    api(`/admin/marketing/wallets/${restaurant_id}/credit`, { method: "POST", body }),
  adminMarketingUsage: () => api("/admin/marketing/usage"),
};
