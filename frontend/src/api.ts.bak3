  adminDeleteAd: (id: string) => api(`/admin/ads/${id}`, { method: "DELETE" }),
  // Media upload (banner images / GIFs / videos) — admin only
  adminUploadMedia: async (fileUri: string, fileName?: string, mimeType?: string): Promise<{ url: string; media_type: string }> => {
    const token = await storage.getItem<string>("auth_token", "");
    const resp = await fetch(fileUri);
    const blob = await resp.blob();
    const mt = mimeType || (blob as any).type || "application/octet-stream";
    const extFromMime = (mt.split("/")[1] || "bin").split(";")[0];
    const name = fileName && /\.[a-z0-9]{2,5}$/i.test(fileName) ? fileName : `upload.${extFromMime}`;
    const fd = new FormData();
    fd.append("file", blob as any, name);
    const res = await fetch(`${BASE}/api/admin/media/upload`, {
      method: "POST",
      headers: token ? { Authorization: `Bearer ${token}` } : undefined,
      body: fd,
    });
    const text = await res.text();
    let data: any = null;
    try { data = text ? JSON.parse(text) : null; } catch { data = text; }
    if (!res.ok) throw new Error((data && (data.detail || data.message)) || `Upload failed (${res.status})`);
    return data;
  },
  // Checkout settings (admin-operated: cancellation policy + payment sections)
