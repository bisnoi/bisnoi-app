# Login is fully Message Central OTP now. Firebase auth endpoint,
# ID-token verifier, and FIREBASE_PROJECT_ID env var have been removed.


# ============================================================================
# Geocoding — keep restaurant location UP-TO-DATE with its address
# ============================================================================
# The bug: when an owner (or admin) sets a restaurant's address, the map often
# still points to the DEFAULT (12.9716, 77.5946 = Bangalore) because lat/lng
# were never updated to match the new address. This helper hits Google's
# Geocoding API using the same key the frontend uses (works for both Maps
# JavaScript API and Geocoding API), and returns (lat, lng, resolved_address)
# for a free-form address string. All failures return None so callers can
# gracefully keep the previous value.
# ---------------------------------------------------------------------------
import httpx  # noqa: E402

_GEOCODE_API_KEY = (
    os.environ.get("GOOGLE_MAPS_API_KEY")
    or os.environ.get("EXPO_PUBLIC_GOOGLE_MAPS_API_KEY")
    or "AIzaSyAhtMZDidZfE_0NEkVPwuEmNM2zdC76fXw"  # last-resort fallback (same as frontend .env)
)

# Sentinel default coords used by the old seed / Restaurant() model. Any
# restaurant still sitting on EXACTLY these coordinates while having a NON
# Bangalore address is a candidate for re-geocoding.
_DEFAULT_LAT = 12.9716
_DEFAULT_LNG = 77.5946


async def geocode_address(address: Optional[str], city: Optional[str] = None, pincode: Optional[str] = None) -> Optional[dict]:
    """Return {'lat', 'lng', 'formatted'} for the given address using Google Geocoding API.

    Returns None if the API key is missing / no result / any error — callers
    must keep the previous lat/lng in that case.
    """
    if not address or not _GEOCODE_API_KEY:
        return None
    parts = [address.strip()]
    if city and city.lower() not in address.lower():
        parts.append(city.strip())
    if pincode and pincode not in address:
        parts.append(pincode.strip())
    parts.append("India")
    q = ", ".join(p for p in parts if p)
    try:
        async with httpx.AsyncClient(timeout=6.0) as client:
            resp = await client.get(
                "https://maps.googleapis.com/maps/api/geocode/json",
                params={"address": q, "key": _GEOCODE_API_KEY, "region": "in"},
            )
        data = resp.json()
        if data.get("status") != "OK":
            log.info("[geocode] status=%s query=%r", data.get("status"), q)
            return None
        results = data.get("results") or []
        if not results:
            return None
        top = results[0]
        loc = top["geometry"]["location"]
        return {
            "lat": float(loc["lat"]),
            "lng": float(loc["lng"]),
            "formatted": top.get("formatted_address") or q,
        }
    except Exception as e:  # network / json / etc.
        log.warning("[geocode] failed for %r: %s", q, e)
        return None


