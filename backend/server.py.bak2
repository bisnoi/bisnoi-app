@api.get("/admin/restaurants/{rid}/categories")
async def admin_list_categories(rid: str, user: dict = Depends(require_role("admin"))):
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    return await db.categories.find({"restaurant_id": rid}, {"_id": 0}).sort("sort_order", 1).to_list(500)


@api.post("/admin/restaurants/{rid}/categories")
async def admin_create_category(rid: str, body: CategoryCreate, user: dict = Depends(require_role("admin"))):
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    if body.sort_order == 0:
        count = await db.categories.count_documents({"restaurant_id": rid})
        sort_order = count + 1
    else:
        sort_order = body.sort_order
    cat = {
        "id": str(uuid.uuid4()),
        "restaurant_id": rid,
        "name": body.name,
        "sort_order": sort_order,
        "is_enabled": body.is_enabled,
    }
    await db.categories.insert_one(dict(cat))
    return cat


@api.patch("/admin/categories/{cid}")
async def admin_update_category(cid: str, body: CategoryUpdate, user: dict = Depends(require_role("admin"))):
    cat = await db.categories.find_one({"id": cid}, {"_id": 0})
    if not cat:
        raise HTTPException(404, "Category not found")
    updates = {k: v for k, v in body.dict().items() if v is not None}
    if updates:
        await db.categories.update_one({"id": cid}, {"$set": updates})
    return await db.categories.find_one({"id": cid}, {"_id": 0})


