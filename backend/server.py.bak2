async def admin_list_ads(user: dict = Depends(require_role("admin"))):
    return await db.ads.find({}, {"_id": 0}).sort("sort_order", 1).to_list(100)


@api.post("/admin/ads")
async def admin_create_ad(body: AdCreate, user: dict = Depends(require_role("admin"))):
    if body.link_restaurant_id:
        r = await db.restaurants.find_one({"id": body.link_restaurant_id}, {"_id": 0})
        if not r:
            raise HTTPException(400, "Linked restaurant not found")
    sort_order = body.sort_order if body.sort_order else (await db.ads.count_documents({}) + 1)
    ad = {
        "id": str(uuid.uuid4()),
        "title": body.title,
        "subtitle": body.subtitle or "",
        "image": body.image,
        "media_type": body.media_type or "image",
        "link_restaurant_id": body.link_restaurant_id,
        "active": body.active,
        "sort_order": sort_order,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    await db.ads.insert_one(dict(ad))
    return ad


