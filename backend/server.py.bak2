# ----------------------------- Orders -----------------------------
# Restaurant availability: manual master switch (is_open) AND weekly operating hours (IST).
IST = timezone(timedelta(hours=5, minutes=30))
_DAY_KEYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]


def _restaurant_open_now(rest: dict) -> bool:
    """Effective availability = manual switch ON *and* current IST time within today's hours."""
    if not rest.get("is_open", True):
        return False
    hours = rest.get("operating_hours") or []
    if not hours:
        return True  # no schedule configured -> open whenever online
    now = datetime.now(IST)
    daykey = _DAY_KEYS[now.weekday()]
    today = next((h for h in hours if (h.get("day") or "").lower()[:3] == daykey), None)
    if not today:
        return True
    if today.get("closed"):
        return False
    cur = now.strftime("%H:%M")
    op = (today.get("open") or "00:00")[:5]
    cl = (today.get("close") or "23:59")[:5]
    if op <= cl:
        return op <= cur <= cl
    # overnight window (e.g. 18:00 - 02:00)
    return cur >= op or cur <= cl


def _with_open(rest: Optional[dict]) -> Optional[dict]:
    if rest is not None:
        rest["open_now"] = _restaurant_open_now(rest)
    return rest


def fee_calc(subtotal: int):
    delivery = 29 if subtotal < 199 else 0
    return delivery


async def _enrich_items(items: List[CartItemIn]) -> List[dict]:
    # Batch-fetch all menu items in one query (avoids an N+1 query per cart item).
    ids = [it.menu_item_id for it in items]
    found = await db.menu_items.find({"id": {"$in": ids}}, {"_id": 0}).to_list(length=None)
    by_id = {m["id"]: m for m in found}
    out = []
    for it in items:
        m = by_id.get(it.menu_item_id)
        if not m:
            raise HTTPException(400, f"Invalid menu item {it.menu_item_id}")
        out.append({
            "menu_item_id": m["id"],
            "name": m["name"],
            "price": m["price"],
            "image": m["image"],
            "quantity": it.quantity,
            # Store prep_time on order items so the restaurant-side preparation
            # timer can compute the target minutes without a second lookup.
            "prep_time": int(m.get("prep_time") or 15),
        })
    return out


def _compute_order_prep_min(items: List[dict]) -> int:
    """Estimated total prep time for an order (in minutes).

    Items are prepared in parallel in most kitchens, so we take the MAX
    prep_time across items (with a sane floor of 5 mins).
    """
    if not items:
        return 15
    times = [int(it.get("prep_time") or 15) for it in items]
    return max(5, max(times) if times else 15)


# ---------------- Order number / handover code helpers ----------------
# Account-id helpers live in account_ids.py (shared with features.py) so there's
# no server.py <-> features.py circular import.


def _generate_order_number() -> str:
    """Generate a 10-digit, human-friendly, non-sequential order number.

    First digit is guaranteed to be 1-9 (so total length is exactly 10) and
    the last 4 digits — which act as the handover code — are always numeric
    and highlight-friendly.

    Uses ``secrets`` (not ``random``) because the last 4 digits double as the
    rider→customer handover verification code.
    """
    first = secrets.randbelow(9) + 1              # 1..9
    rest = secrets.randbelow(1000000000)          # 0..999999999
    return f"{first}{rest:09d}"


def _fallback_order_number_from_id(oid: str) -> str:
    """Deterministic 10-digit number for legacy orders that were created
    before order_number existed. We derive it from the UUID so the same
    legacy order always shows the same number.
    """
    digits = "".join(ch for ch in (oid or "") if ch.isdigit())
    if len(digits) < 10:
        # Fill with hash-derived digits so we always end up with 10.
        h = abs(hash(oid or "order")) % (10 ** 10)
        digits = f"{digits}{h}"
    d = digits[:10]
    # Avoid a leading zero — swap it with a stable digit further in.
    if d and d[0] == "0":
        d = "1" + d[1:]
    return d


def _ensure_order_number(o: dict) -> dict:
    """Backfill order_number/handover_code onto legacy order docs on read."""
    if not isinstance(o, dict):
        return o
    if not o.get("order_number"):
        o["order_number"] = _fallback_order_number_from_id(o.get("id", ""))
    if not o.get("handover_code"):
        num = o.get("order_number") or ""
        o["handover_code"] = num[-4:] if len(num) >= 4 else num.rjust(4, "0")
    if "handover_verified" not in o:
        o["handover_verified"] = False
    # Emergency-transfer fields — backfilled so legacy docs don't NPE the UI.
    if "transfer_requested" not in o:
        o["transfer_requested"] = False
    if "previous_riders" not in o:
        o["previous_riders"] = []
    return o


@api.post("/orders", response_model=Order)
async def create_order(body: OrderCreate, user: dict = Depends(get_current_user)):
    rest = await db.restaurants.find_one({"id": body.restaurant_id}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    if not _restaurant_open_now(rest):
        raise HTTPException(403, f"{rest.get('name', 'This restaurant')} is currently closed and not accepting orders.")
    # COD gate: block COD orders when disabled for this customer
    if body.payment_method == "cod":
        try:
            from policy_ext import resolve_cod_status
            u_fresh = await db.users.find_one({"id": user["id"]}, {"_id": 0}) or user
            cod_status = await resolve_cod_status(db, u_fresh)
            if not cod_status.get("cod_available", True):
                raise HTTPException(
                    403,
                    cod_status.get("reason") or "Cash on Delivery is not available for your account. Please choose Prepaid.",
                )
        except HTTPException:
            raise
        except Exception as _e:  # noqa: BLE001
            log.warning("cod gate check failed: %s", _e)
    enriched = await _enrich_items(body.items)
    subtotal = sum(i["price"] * i["quantity"] for i in enriched)
    discount = 0
    applied_offer = None
    if body.offer_id:
        offer = await db.offers.find_one({"id": body.offer_id, "active": True}, {"_id": 0})
        if offer and body.offer_id in (rest.get("offer_ids") or []) and subtotal >= (offer.get("min_order") or 0):
            if offer.get("type") == "percent":
                d = int(subtotal * offer["value"] // 100)
                if offer.get("max_discount"):
                    d = min(d, int(offer["max_discount"]))
                discount = d
            else:
                discount = min(int(offer["value"]), subtotal)
            applied_offer = {"id": offer["id"], "title": offer.get("title"), "code": offer.get("code")}
    elif body.coupon_code:
        c = await db.coupons.find_one({"code": body.coupon_code.upper()}, {"_id": 0})
        if c and subtotal >= c["min_order"]:
            discount = min(c["max_discount"], subtotal * c["discount_pct"] // 100)
    charges = await _get_charges()
    address_dict = body.address.dict()
    distance_km = compute_distance_km(rest, address_dict)
    if subtotal <= 0:
        delivery_fee = 0
    else:
        delivery_fee = compute_delivery_fee(subtotal, distance_km, charges)
    packing_charge = int(charges["packing_charge"]) if subtotal > 0 else 0
    gst_percent = float(charges["gst_percent"])
    taxable = max(0, subtotal - discount)
    gst_amount = int(round(taxable * gst_percent / 100))
    total = max(0, subtotal - discount + delivery_fee + packing_charge + gst_amount)
    # Rider payout (admin PAYS rider) + commission split (admin revenue)
    rider_payout = compute_rider_payout(distance_km, charges) if subtotal > 0 else 0
    comm = compute_commission(subtotal, rider_payout, charges)
    is_razorpay = body.payment_method == "razorpay"
    order_number = _generate_order_number()
    handover_code = order_number[-4:]
    # 4-digit customer-side delivery OTP — must be independent of the handover
    # code so a rider who peeks the pickup code can't reuse it at drop-off.
    delivery_code = f"{secrets.randbelow(9000) + 1000:04d}"
    # Owner-configured setting: if enabled, order jumps straight to "accepted"
    # instead of sitting in "placed" waiting for manual confirmation. Only for
    # non-razorpay (COD/PayU) since razorpay orders start "placed" until
    # payment is verified.
    auto_accept = bool(rest.get("auto_accept_orders")) and not is_razorpay
    initial_status = "accepted" if auto_accept else "placed"
    order = {
        "id": str(uuid.uuid4()),
        "customer_id": user["id"],
        "customer_name": user.get("name"),
        "customer_phone": user.get("phone"),
        "restaurant_id": rest["id"],
        "restaurant_name": rest["name"],
        "items": enriched,
        "subtotal": subtotal,
        "delivery_fee": delivery_fee,
        "packing_charge": packing_charge,
        "gst_percent": gst_percent,
        "gst_amount": gst_amount,
        "discount": discount,
        "total": total,
        "distance_km": distance_km,
        "rider_payout": comm["rider_payout_gross"],
        "rider_payout_net": comm["rider_payout_net"],
        "owner_commission": comm["owner_commission"],
        "owner_commission_percent": comm["owner_commission_percent"],
        "owner_net": comm["owner_net"],
        "rider_commission": comm["rider_commission"],
        "admin_earnings": comm["admin_earnings"],
        "address": address_dict,
        "status": initial_status,
        "payment_method": body.payment_method,
        # Razorpay orders start UNPAID and are marked paid only after server-side
        # signature verification (POST /api/payments/verify). COD is pending till delivery.
        "payment_status": "pending",
        # Online (razorpay) orders are HIDDEN from the owner/rider/admin until the
        # payment signature is verified. This ensures an order whose online payment
        # failed / was cancelled NEVER reaches the restaurant. COD orders are
        # visible (awaiting_payment=False) immediately.
        "awaiting_payment": is_razorpay,
        "rider_id": None,
        "rider_name": None,
        "rider_lat": rest["lat"] + 0.005,
        "rider_lng": rest["lng"] + 0.005,
        "restaurant_lat": rest["lat"],
        "restaurant_lng": rest["lng"],
        "placed_at": datetime.now(timezone.utc).isoformat(),
        "status_timestamps": (
            {"accepted": datetime.now(timezone.utc).isoformat()} if auto_accept else {}
        ),
        "coupon_code": body.coupon_code,
        "offer_id": body.offer_id,
        "offer": applied_offer,
        "note": body.note,
        "simulated": True,
        "order_number": order_number,
        "handover_code": handover_code,
        "handover_verified": False,
        "delivery_code": delivery_code,
        "delivery_verified": False,
        "dispatch_started_at": None,
        "dispatch_attempts": 0,
        "dispatch_stalled": False,
        "assigned_at": None,
        "prep_min": _compute_order_prep_min(enriched),
    }
    await db.orders.insert_one(dict(order))
    # For COD, the order is confirmed immediately: notify owner + record commission ledger.
    # For online (razorpay), we defer both until payment is verified.
    if not is_razorpay:
        await create_ledger_entry(
            db, entry_type="delivery_order", restaurant_id=rest["id"],
            owner_id=rest.get("owner_id"), rider_id=None, gross=subtotal,
            breakdown=comm, ref_id=order["id"], restaurant_name=rest["name"],
        )
        await _create_notification(
            rest.get("owner_id"),
            "new_order",
            "New order received",
            f"{user.get('name') or 'A customer'} placed an order \u2022 {len(enriched)} item(s) \u2022 \u20B9{total}",
            order_id=order["id"], restaurant_id=rest["id"],
        )
        # If the owner has auto-accept enabled, broadcast the pickup to riders
        # right away (same broadcast that runs when an owner manually accepts).
        if auto_accept:
            async for r in db.users.find({"role": "rider"}, {"_id": 0, "id": 1}):
                await _create_notification(
                    r["id"],
                    "pickup_available",
                    "New pickup available",
                    f"Order from {rest.get('name', 'a restaurant')} is ready for pickup \u2022 \u20B9{total}. First to accept gets it!",
                    order_id=order["id"], restaurant_id=rest["id"],
                )
    return Order(**order)


class OrderQuoteRequest(BaseModel):
    restaurant_id: str
    items: List[CartItemIn]
    address: Address
    coupon_code: Optional[str] = None
    offer_id: Optional[str] = None


@api.post("/orders/quote")
async def quote_order(body: OrderQuoteRequest, user: dict = Depends(get_current_user)):
    """Server-authoritative bill preview (incl. distance-based delivery fee) for the checkout screen."""
    rest = await db.restaurants.find_one({"id": body.restaurant_id}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    enriched = await _enrich_items(body.items)
    subtotal = sum(i["price"] * i["quantity"] for i in enriched)
    discount = 0
    if body.offer_id:
        offer = await db.offers.find_one({"id": body.offer_id, "active": True}, {"_id": 0})
        if offer and body.offer_id in (rest.get("offer_ids") or []) and subtotal >= (offer.get("min_order") or 0):
            if offer.get("type") == "percent":
                d = int(subtotal * offer["value"] // 100)
                if offer.get("max_discount"):
                    d = min(d, int(offer["max_discount"]))
                discount = d
            else:
                discount = min(int(offer["value"]), subtotal)
    elif body.coupon_code:
        c = await db.coupons.find_one({"code": body.coupon_code.upper()}, {"_id": 0})
        if c and subtotal >= c["min_order"]:
            discount = min(c["max_discount"], subtotal * c["discount_pct"] // 100)
    charges = await _get_charges()
    distance_km = compute_distance_km(rest, body.address.dict())
    delivery_fee = compute_delivery_fee(subtotal, distance_km, charges) if subtotal > 0 else 0
    packing_charge = int(charges["packing_charge"]) if subtotal > 0 else 0
    gst_percent = float(charges["gst_percent"])
    taxable = max(0, subtotal - discount)
    gst_amount = int(round(taxable * gst_percent / 100))
    total = max(0, subtotal - discount + delivery_fee + packing_charge + gst_amount)
    return {
        "subtotal": subtotal,
        "discount": discount,
        "delivery_fee": delivery_fee,
        "distance_km": distance_km,
        "delivery_mode": charges.get("delivery_mode"),
        "packing_charge": packing_charge,
        "gst_percent": gst_percent,
        "gst_amount": gst_amount,
        "total": total,
    }



@api.get("/orders/mine")
async def my_orders(user: dict = Depends(get_current_user)):
    # Orders still awaiting online payment (awaiting_payment=True) are hidden
    # from EVERY feed until the Razorpay signature is verified — so a failed /
    # cancelled online payment never surfaces to the owner, rider, admin, or
    # even the customer's own history.
    unpaid = {"awaiting_payment": {"$ne": True}}
    if user["role"] == "customer":
        cur = db.orders.find({"customer_id": user["id"], **unpaid}, {"_id": 0}).sort("placed_at", -1)
    elif user["role"] == "rider":
        cur = db.orders.find({"rider_id": user["id"], **unpaid}, {"_id": 0}).sort("placed_at", -1)
    elif user["role"] == "restaurant_owner":
        rest_ids = [r["id"] async for r in db.restaurants.find({"owner_id": user["id"]}, {"_id": 0, "id": 1})]
        cur = db.orders.find({"restaurant_id": {"$in": rest_ids}, **unpaid}, {"_id": 0}).sort("placed_at", -1)
    else:
        cur = db.orders.find({**unpaid}, {"_id": 0}).sort("placed_at", -1)
    docs = await cur.to_list(200)
    return [_ensure_order_number(d) for d in docs]


_SOURCE_LABEL = {"dine_in": "Dine-in", "takeaway": "Takeaway", "walk_in": "Walk-in"}


@api.get("/owner/recent-orders")
async def owner_recent_orders(limit: int = 200, user: dict = Depends(require_role("restaurant_owner"))):
    """Unified feed of ONLINE (customer app) + OFFLINE (POS dine-in/takeaway/walk-in) orders."""
    rest_ids = [r["id"] async for r in db.restaurants.find({"owner_id": user["id"]}, {"_id": 0, "id": 1})]
    out = []

    # Online — customer app orders (exclude orders still awaiting online payment
    # so failed/cancelled Razorpay orders never appear in the owner's feed).
    async for o in db.orders.find({"restaurant_id": {"$in": rest_ids}, "awaiting_payment": {"$ne": True}}, {"_id": 0}).sort("placed_at", -1).limit(limit):
        o = _ensure_order_number(o)
        out.append({
            "id": o["id"],
            "channel": "online",
            "order_type": "delivery",
            "source_label": "App Order",
            "customer_name": o.get("customer_name") or "Customer",
            "customer_phone": o.get("customer_phone"),
            "items": [{"name": it.get("name"), "qty": it.get("quantity", it.get("qty", 1)), "price": it.get("price", 0)} for it in o.get("items", [])],
            "subtotal": o.get("subtotal", 0),
            "discount": o.get("discount", 0),
            "delivery_fee": o.get("delivery_fee", 0),
            "packing_charge": o.get("packing_charge", 0),
            "gst_amount": o.get("gst_amount", 0),
            "total": o.get("total", 0),
            "status": o.get("status", "placed"),
            "payment_method": o.get("payment_method"),
            "table_label": None,
            "restaurant_name": o.get("restaurant_name"),
            "created_at": o.get("placed_at"),
            "rider_id": o.get("rider_id"),
            "rider_name": o.get("rider_name"),
            "order_number": o.get("order_number"),
            "handover_code": o.get("handover_code"),
            "handover_verified": o.get("handover_verified", False),
            # Preparation timer inputs: when the restaurant accepted the order
            # (start) + the estimated prep window in minutes (target).
            "status_timestamps": o.get("status_timestamps") or {},
            "prep_min": o.get("prep_min"),
            "placed_at": o.get("placed_at"),
        })

    # Offline — POS bills (dine-in / takeaway / walk-in)
    async for p in db.pos_orders.find({"restaurant_id": {"$in": rest_ids}}, {"_id": 0}).sort("created_at", -1).limit(limit):
        ot = p.get("order_type", "walk_in")
        out.append({
            "id": p["id"],
            "channel": "offline",
            "order_type": ot,
            "source_label": _SOURCE_LABEL.get(ot, "Counter"),
            "customer_name": p.get("customer_name") or "Walk-in",
            "customer_phone": p.get("customer_phone"),
            "items": [{"name": it.get("name"), "qty": it.get("qty", 1), "price": it.get("price", 0)} for it in p.get("items", [])],
            "subtotal": p.get("subtotal", 0),
            "discount": p.get("discount_amount", 0),
            "delivery_fee": 0,
            "packing_charge": 0,
            "gst_amount": p.get("tax_amount", 0),
            "total": p.get("total", 0),
            "status": "settled",
            "payment_method": p.get("payment_method"),
            "table_label": p.get("table_label"),
            "bill_number": p.get("bill_number"),
            "restaurant_name": p.get("restaurant_name"),
            "created_at": p.get("created_at"),
        })

    out.sort(key=lambda x: x.get("created_at") or "", reverse=True)
    return out[:limit]


@api.get("/orders/{oid}")
async def get_order(oid: str, user: dict = Depends(get_current_user)):
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    return _ensure_order_number(o)


# ------------------------ Rider dispatch (nearby-first + retry) ------------------------
# The old broadcast blasted every online rider on accept. That's noisy AND slow
# when a rider is 40 km away and can never realistically pick up. The new flow:
#   1. On accept -> _dispatch_pickup() picks online + fresh-heartbeat riders in
#      the smallest DISPATCH_RADIUS_KM bucket, notifies them, emits socket.
#   2. A background _dispatch_watchdog re-runs the picker every 15s with a
#      wider radius until someone accepts or we've exhausted the ladder.
#   3. When the ladder is exhausted the owner gets a "no rider found" ping
#      with a Retry button that hits POST /orders/{oid}/redispatch to restart.
#
# assign-rider clears dispatch_started_at / stalled so the watchdog exits cleanly.

async def _nearby_riders(
    rest_lat: float,
    rest_lng: float,
    radius_km: float,
    exclude_ids: Optional[set] = None,
) -> List[dict]:
    """Return online, verified riders with a fresh heartbeat and within `radius_km`
    of the restaurant, sorted by distance ascending. Falls back to the full
    online-verified pool when no rider has ever shared their location (fresh
    installs / demo data) so the broadcast never silently drops."""
    exclude_ids = exclude_ids or set()
    now = datetime.now(timezone.utc)
    stale_cutoff = (now - timedelta(seconds=HEARTBEAT_STALE_SECS)).isoformat()

    online_q = {"role": "rider", "is_online": {"$ne": False}}
    all_online = await db.users.find(
        online_q, {"_id": 0, "id": 1, "last_lat": 1, "last_lng": 1, "last_heartbeat_at": 1, "rider_verified": 1}
    ).to_list(2000)
    verified = [r for r in all_online if r.get("rider_verified") is not False and r["id"] not in exclude_ids]

    # Riders with a recent heartbeat we can distance-check.
    located: List[tuple] = []
    for r in verified:
        lat, lng, hb = r.get("last_lat"), r.get("last_lng"), r.get("last_heartbeat_at")
        if lat is None or lng is None or not hb or hb < stale_cutoff:
            continue
        try:
            d = haversine_km(float(rest_lat), float(rest_lng), float(lat), float(lng))
        except Exception:
            continue
        if d <= radius_km:
            located.append((d, r))
    if located:
        located.sort(key=lambda t: t[0])
        return [r for _, r in located]

    # Nobody in radius (or nobody sharing location) — fall back to all verified
    # online riders so demo installs / just-onboarded riders still get pinged.
    return verified


async def _dispatch_pickup(order: dict, attempt: int = 0, notify_rest_owner_on_final: bool = True) -> int:
    """One dispatch attempt: notify nearby riders + emit socket event.
    Returns the number of riders that got notified. Advances the retry ladder
    on every call by using DISPATCH_RADIUS_KM[attempt]."""
    if order.get("rider_id"):
        return 0  # already assigned
    idx = min(max(0, attempt), len(DISPATCH_RADIUS_KM) - 1)
    radius = DISPATCH_RADIUS_KM[idx]
    rest_lat = order.get("restaurant_lat")
    rest_lng = order.get("restaurant_lng")
    if rest_lat is None or rest_lng is None:
        rest = await db.restaurants.find_one({"id": order.get("restaurant_id")}, {"_id": 0, "lat": 1, "lng": 1})
        if rest:
            rest_lat, rest_lng = rest.get("lat"), rest.get("lng")

    # Riders who already held-and-released this order can't get re-pinged (else
    # the same rider takes it, releases, takes it, releases forever).
    exclude = {pr.get("rider_id") for pr in (order.get("previous_riders") or []) if pr.get("rider_id")}

    riders = []
    if rest_lat is not None and rest_lng is not None:
        riders = await _nearby_riders(rest_lat, rest_lng, radius, exclude_ids=exclude)

    # Fallback: no restaurant location -> just notify all verified online riders.
    if not riders:
        cur = db.users.find({"role": "rider", "is_online": {"$ne": False}, "rider_verified": {"$ne": False}}, {"_id": 0, "id": 1})
        riders = [r async for r in cur if r["id"] not in exclude]

    is_transfer = bool(order.get("transfer_requested"))
    for r in riders:
        await _create_notification(
            r["id"],
            "pickup_available",
            "\u26A0\uFE0F Order needs a new rider" if is_transfer else "New pickup available",
            (
                f"An assigned rider hit an issue. Order from {order.get('restaurant_name', 'a restaurant')} \u2022 \u20B9{order.get('total', 0)} is up for takeover."
                if is_transfer else
                f"Order from {order.get('restaurant_name', 'a restaurant')} is ready for pickup \u2022 \u20B9{order.get('total', 0)}. First to accept gets it!"
            ),
            order_id=order["id"], restaurant_id=order.get("restaurant_id"),
        )

    # Realtime fan-out via Socket.IO room "riders" so any subscriber (rider
    # apps in the foreground) gets an instant bell without waiting for the
    # 5-second poll cycle.
    try:
        await sio.emit(
            "pickup_available",
            {
                "order_id": order["id"],
                "restaurant_id": order.get("restaurant_id"),
                "restaurant_name": order.get("restaurant_name"),
                "total": order.get("total"),
                "radius_km": radius,
                "attempt": attempt + 1,
            },
            room="riders",
        )
    except Exception as e:  # noqa: BLE001
        log.warning("socket pickup_available emit failed: %s", e)

    # Notify the owner / admin room so their "waiting for rider" panel stays live.
    for room in (f"restaurant:{order.get('restaurant_id')}", "admin"):
        try:
            await sio.emit(
                "dispatch_progress",
                {
                    "order_id": order["id"],
                    "restaurant_id": order.get("restaurant_id"),
                    "restaurant_name": order.get("restaurant_name"),
                    "order_number": order.get("order_number"),
                    "attempt": attempt + 1,
                    "max_attempts": len(DISPATCH_RADIUS_KM),
                    "radius_km": radius,
                    "notified": len(riders),
                },
                room=room,
            )
        except Exception:  # noqa: BLE001
            pass

    await db.orders.update_one(
        {"id": order["id"]},
        {"$set": {
            "dispatch_attempts": attempt + 1,
            "dispatch_started_at": order.get("dispatch_started_at") or datetime.now(timezone.utc).isoformat(),
        }},
    )
    return len(riders)


async def _dispatch_watchdog(oid: str):
    """Background loop that re-broadcasts every DISPATCH_RETRY_SECS until a
    rider accepts OR the retry ladder is exhausted. On exhaustion the restaurant
    owner receives a 'no rider found' notification so they can hit Retry."""
    for attempt in range(1, len(DISPATCH_RADIUS_KM)):
        try:
            await asyncio.sleep(DISPATCH_RETRY_SECS)
        except asyncio.CancelledError:
            return
        o = await db.orders.find_one({"id": oid}, {"_id": 0})
        if not o:
            return
        if o.get("rider_id") or o.get("status") in ("cancelled", "delivered", "picked"):
            return  # assigned or moved on
        await _dispatch_pickup(o, attempt=attempt)

    # Final attempt done — still nobody. Ping the owner so they can retry.
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o or o.get("rider_id"):
        return
    await db.orders.update_one({"id": oid}, {"$set": {"dispatch_stalled": True}})
    rest = await db.restaurants.find_one({"id": o.get("restaurant_id")}, {"_id": 0})
    owner_id = rest.get("owner_id") if rest else None
    if owner_id:
        await _create_notification(
            owner_id,
            "dispatch_stalled",
            "\u26A0\uFE0F No rider accepted yet",
            f"Order #{o.get('order_number') or oid[:6]} is still waiting after {len(DISPATCH_RADIUS_KM)} tries. Tap to retry dispatch.",
            order_id=oid, restaurant_id=o.get("restaurant_id"),
        )
    try:
        for room in (f"restaurant:{o.get('restaurant_id')}", "admin"):
            await sio.emit(
                "dispatch_stalled",
                {
                    "order_id": oid,
                    "attempts": len(DISPATCH_RADIUS_KM),
                    "restaurant_id": o.get("restaurant_id"),
                    "restaurant_name": o.get("restaurant_name"),
                    "order_number": o.get("order_number"),
                },
                room=room,
            )
    except Exception:  # noqa: BLE001
        pass


def _start_dispatch(order: dict) -> None:
    """Kick off the first dispatch attempt + background watchdog. Non-blocking."""
    async def _run():
        try:
            await _dispatch_pickup(order, attempt=0)
            await _dispatch_watchdog(order["id"])
        except Exception as e:  # noqa: BLE001
            log.warning("dispatch failed for %s: %s", order.get("id"), e)
    asyncio.create_task(_run())


@api.patch("/orders/{oid}/status")
async def update_status(oid: str, body: StatusUpdate, user: dict = Depends(get_current_user)):
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    valid_flow = {
        "restaurant_owner": ["accepted", "preparing", "ready", "cancelled"],
        "rider": ["picked", "delivered"],
        "admin": ["accepted", "preparing", "ready", "picked", "delivered", "cancelled"],
        "customer": ["cancelled"],
    }
    allowed = valid_flow.get(user["role"], [])
    if body.status not in allowed:
        raise HTTPException(403, f"Role {user['role']} cannot set status {body.status}")
    # Anti-fraud: riders cannot flip a job to "delivered" via the generic status
    # endpoint. They MUST go through POST /orders/{oid}/verify-delivery with the
    # customer's 4-digit OTP + their current geo coords. This blocks the "mark
    # everything delivered from home" fraud pattern.
    if body.status == "delivered" and user["role"] == "rider":
        raise HTTPException(400, "Use /orders/{oid}/verify-delivery with the customer's OTP to complete this order")
    _now = datetime.now(timezone.utc).isoformat()
    status_ts = dict(o.get("status_timestamps") or {})
    status_ts[body.status] = _now
    await db.orders.update_one({"id": oid}, {"$set": {"status": body.status, "status_timestamps": status_ts}})
    # When the owner/admin ACCEPTS an order, run the nearby-first dispatch flow.
    # See _dispatch_pickup / _dispatch_watchdog — they fan out to nearby riders,
    # retry with a widening radius every 15s, and finally ping the owner to
    # retry manually if nobody accepts.
    if body.status == "accepted" and user["role"] in ("restaurant_owner", "admin"):
        fresh = await db.orders.find_one({"id": oid}, {"_id": 0})
        if fresh and not fresh.get("rider_id"):
            _start_dispatch(fresh)
            # Tell the owner + admin dashboards to open the "waiting for rider" panel.
            for room in (f"restaurant:{fresh.get('restaurant_id')}", "admin"):
                try:
                    await sio.emit(
                        "waiting_for_rider",
                        {
                            "order_id": oid,
                            "restaurant_id": fresh.get("restaurant_id"),
                            "restaurant_name": fresh.get("restaurant_name"),
                            "order_number": fresh.get("order_number"),
                            "total": fresh.get("total"),
                            "max_attempts": len(DISPATCH_RADIUS_KM),
                            "retry_secs": DISPATCH_RETRY_SECS,
                        },
                        room=room,
                    )
                except Exception:  # noqa: BLE001
                    pass
    # Notify the CUSTOMER about every status change so their app chimes/updates.
    _status_titles = {
        "accepted": "Order accepted \u2705",
        "preparing": "Your order is being prepared \U0001F373",
        "ready": "Order ready for pickup \U0001F4E6",
        "picked": "Rider picked up your order \U0001F6F5",
        "delivered": "Order delivered \U0001F389",
        "cancelled": "Order cancelled",
    }
    await _create_notification(
        o.get("customer_id"),
        "order_update",
        _status_titles.get(body.status, f"Order {body.status}"),
        f"Your order from {o.get('restaurant_name', 'the restaurant')} is now '{body.status}'.",
        order_id=oid, restaurant_id=o.get("restaurant_id"),
    )
    updated = await db.orders.find_one({"id": oid}, {"_id": 0})
    return updated


@api.post("/orders/{oid}/assign-rider")
async def assign_rider(oid: str, user: dict = Depends(require_role("rider"))):
    # Anti-fraud: only VERIFIED riders can grab jobs. `rider_verified` is set to
    # True either automatically when an application is approved (see
    # applications._on_approved) or by admin seed for the built-in demo rider.
    if user.get("rider_verified") is False:
        raise HTTPException(
            403,
            "Your rider account is still pending verification. Complete KYC from Profile → Apply as rider so we can review your documents.",
        )
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    if o.get("rider_id"):
        raise HTTPException(400, "Already assigned")
    _now = datetime.now(timezone.utc).isoformat()
    # If this is a transfer pickup, sanity-check the acceptor isn't a rider
    # who already held (and released) the order.
    is_transfer = bool(o.get("transfer_requested"))
    if is_transfer:
        held_before = {pr.get("rider_id") for pr in (o.get("previous_riders") or [])}
        if user["id"] in held_before:
            raise HTTPException(400, "You already held this order — a different rider needs to pick it up")
    update = {
        "rider_id": user["id"],
        "rider_name": user.get("name"),
        "assigned_at": _now,
        "dispatch_stalled": False,
    }
    if is_transfer:
        # Clear the transfer flags — order is back in a rider's hands.
        update.update({
            "transfer_requested": False,
            "transfer_completed_at": _now,
        })
    await db.orders.update_one({"id": oid}, {"$set": update})

    # Notify the restaurant owner (and, on transfer, the previous rider + the customer)
    rest = await db.restaurants.find_one({"id": o.get("restaurant_id")}, {"_id": 0})
    await _create_notification(
        rest.get("owner_id") if rest else None,
        "rider_assigned",
        "Rider assigned" if not is_transfer else "Order transferred to a new rider",
        f"{user.get('name') or 'A rider'} {'accepted the pickup' if not is_transfer else 'took over the delivery'} for your order.",
        order_id=oid, restaurant_id=o.get("restaurant_id"),
    )
    if is_transfer:
        prev = (o.get("previous_riders") or [])[-1] if o.get("previous_riders") else None
        # Ping the rider who released the order
        if prev and prev.get("rider_id"):
            await _create_notification(
                prev["rider_id"],
                "order_update",
                "Your handoff has been picked up \U0001F91D",
                f"{user.get('name') or 'Another rider'} took over the delivery you released. Take care!",
                order_id=oid, restaurant_id=o.get("restaurant_id"),
            )
        # Also tell the customer someone else is on the way
        if o.get("customer_id"):
            await _create_notification(
                o["customer_id"],
                "order_update",
                "A new rider is on the way \U0001F6F5",
                f"Your order is now being delivered by {user.get('name') or 'a new rider'}. Sorry for the small delay.",
                order_id=oid, restaurant_id=o.get("restaurant_id"),
            )
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    # Close the "waiting for rider" panels on owner + admin dashboards live.
    for room in (f"restaurant:{o.get('restaurant_id')}", "admin"):
        try:
            await sio.emit(
                "rider_assigned",
                {
                    "order_id": oid,
                    "rider_id": user["id"],
                    "rider_name": user.get("name"),
                    "restaurant_id": o.get("restaurant_id"),
                    "order_number": o.get("order_number"),
                    "is_transfer": is_transfer,
                },
                room=room,
            )
        except Exception:  # noqa: BLE001
            pass
    return _ensure_order_number(o)


@api.post("/orders/{oid}/redispatch")
async def redispatch_pickup(oid: str, user: dict = Depends(get_current_user)):
    """Owner/admin manually re-runs the dispatch ladder from scratch.
    Handy after `dispatch_stalled` when nobody accepted in the retry window."""
    if user["role"] not in ("restaurant_owner", "admin"):
        raise HTTPException(403, "Only the restaurant owner or an admin can redispatch")
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    if user["role"] == "restaurant_owner":
        rest = await db.restaurants.find_one({"id": o.get("restaurant_id"), "owner_id": user["id"]}, {"_id": 0, "id": 1})
        if not rest:
            raise HTTPException(403, "This order does not belong to your outlet")
    if o.get("rider_id"):
        raise HTTPException(400, "A rider is already assigned")
    if o.get("status") in ("cancelled", "delivered"):
        raise HTTPException(400, f"Order is '{o['status']}', cannot redispatch")
    # Reset attempts so the retry ladder starts widening again from the smallest bucket.
    await db.orders.update_one(
        {"id": oid},
        {"$set": {
            "dispatch_attempts": 0,
            "dispatch_stalled": False,
            "dispatch_started_at": datetime.now(timezone.utc).isoformat(),
        }},
    )
    fresh = await db.orders.find_one({"id": oid}, {"_id": 0})
    _start_dispatch(fresh)
    return {"ok": True, "order_id": oid}


@api.post("/orders/{oid}/verify-delivery")
async def verify_delivery(oid: str, body: VerifyDelivery, user: dict = Depends(require_role("rider"))):
    """Rider marks an order delivered by supplying the customer's 4-digit
    OTP AND their current GPS location. Server checks:
      1. Order is currently 'picked' and assigned to THIS rider.
      2. Code matches order.delivery_code.
      3. Rider is within DELIVERY_GEOFENCE_METERS of the customer address.
    The geo-fence guards against phantom-delivery fraud where a rider marks the
    order complete from home. If the customer address has no lat/lng we skip
    the geo-check (rare — most addresses carry coords). """
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    if o.get("rider_id") != user["id"]:
        raise HTTPException(403, "This order is not assigned to you")
    if o.get("status") != "picked":
        raise HTTPException(400, f"Order is '{o.get('status')}', cannot deliver yet")
    if o.get("delivery_verified"):
        raise HTTPException(400, "Order already marked delivered")
    submitted = re.sub(r"\D", "", body.code or "")[-4:]
    expected = str(o.get("delivery_code") or "")
    if not submitted or len(submitted) != 4 or submitted != expected:
        raise HTTPException(400, "Incorrect delivery OTP. Ask the customer to recheck their order screen.")

    # Geo-fence check — only when we have BOTH rider location AND drop coords.
    drop = (o.get("address") or {})
    drop_lat, drop_lng = drop.get("lat"), drop.get("lng")
    if drop_lat is not None and drop_lng is not None and body.lat is not None and body.lng is not None:
        try:
            dist_km = haversine_km(float(drop_lat), float(drop_lng), float(body.lat), float(body.lng))
            if dist_km * 1000.0 > DELIVERY_GEOFENCE_METERS:
                raise HTTPException(
                    400,
                    f"You're {int(dist_km * 1000)}m from the drop point. Move within {DELIVERY_GEOFENCE_METERS}m of the customer to confirm delivery.",
                )
        except HTTPException:
            raise
        except Exception:  # noqa: BLE001
            pass  # bad numbers -> skip geo-fence

    _now = datetime.now(timezone.utc).isoformat()
    status_ts = dict(o.get("status_timestamps") or {})
    status_ts["delivered"] = _now
    await db.orders.update_one(
        {"id": oid},
        {"$set": {
            "status": "delivered",
            "delivery_verified": True,
            "delivery_verified_at": _now,
            "delivery_verified_lat": body.lat,
            "delivery_verified_lng": body.lng,
            "status_timestamps": status_ts,
        }},
    )
    # Notify the customer & the restaurant owner.
    await _create_notification(
        o.get("customer_id"),
        "order_update",
        "Order delivered \U0001F389",
        f"Your order from {o.get('restaurant_name', 'the restaurant')} was delivered. Enjoy!",
        order_id=oid, restaurant_id=o.get("restaurant_id"),
    )
    rest = await db.restaurants.find_one({"id": o.get("restaurant_id")}, {"_id": 0, "owner_id": 1})
    if rest and rest.get("owner_id"):
        await _create_notification(
            rest["owner_id"],
            "order_update",
            "Order delivered",
            f"{user.get('name') or 'The rider'} completed delivery for order #{o.get('order_number') or oid[:6]}.",
            order_id=oid, restaurant_id=o.get("restaurant_id"),
        )
    updated = await db.orders.find_one({"id": oid}, {"_id": 0})
    return _ensure_order_number(updated)


TRANSFER_REASONS = {
    "vehicle_breakdown": "Vehicle breakdown",
    "accident_injury": "Accident or injury",
    "personal_emergency": "Personal emergency",
    "bad_weather": "Bad weather",
    "other": "Other",
}


class TransferRequest(BaseModel):
    reason: str
    note: Optional[str] = None


@api.post("/orders/{oid}/request-transfer")
async def request_transfer(
    oid: str,
    body: TransferRequest,
    user: dict = Depends(require_role("rider")),
):
    """Rider hit an emergency (breakdown/accident/etc.) AFTER picking up.

    Releases the order back to the available-feed so any other rider can take
    over. The requesting rider is added to `previous_riders` so they can't
    re-accept their own transfer. The restaurant owner and the customer are
    both notified so they know what's happening.
    """
    reason_key = (body.reason or "").strip().lower()
    if reason_key not in TRANSFER_REASONS:
        raise HTTPException(400, f"Reason must be one of: {', '.join(TRANSFER_REASONS.keys())}")
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    if o.get("rider_id") != user["id"]:
        raise HTTPException(403, "This order is not currently assigned to you")
    if o.get("status") not in ("picked",):
        # Guard-rail: only orders that were actually picked up need a rider-to-rider
        # transfer. For pre-pickup problems the rider should just decline.
        raise HTTPException(400, "You can only report a transfer after the order has been picked up")
    if o.get("transfer_requested"):
        raise HTTPException(400, "A transfer is already in progress for this order")
    if o.get("status") == "delivered":
        raise HTTPException(400, "Order already delivered")

    _now = datetime.now(timezone.utc).isoformat()
    prev_entry = {
        "rider_id": user["id"],
        "rider_name": user.get("name"),
        "rider_phone": user.get("phone"),
        "released_at": _now,
        "reason": reason_key,
        "reason_label": TRANSFER_REASONS[reason_key],
        "note": (body.note or "").strip() or None,
    }
    previous_riders = list(o.get("previous_riders") or [])
    previous_riders.append(prev_entry)
    await db.orders.update_one(
        {"id": oid},
        {
            "$set": {
                "rider_id": None,
                "rider_name": None,
                "transfer_requested": True,
                "transfer_reason": reason_key,
                "transfer_note": prev_entry["note"],
                "transfer_requested_at": _now,
                "previous_riders": previous_riders,
            }
        },
    )

    # Notify all other riders that a fresh transfer is up for grabs
    async for r in db.users.find({"role": "rider", "id": {"$ne": user["id"]}}, {"_id": 0, "id": 1}):
        await _create_notification(
            r["id"],
            "pickup_available",
            "\u26A0\uFE0F Order needs a new rider",
            f"An assigned rider hit an issue ({prev_entry['reason_label']}). Order from {o.get('restaurant_name', 'a restaurant')} is up for takeover \u2022 \u20B9{o.get('total', 0)}.",
            order_id=oid, restaurant_id=o.get("restaurant_id"),
        )

    # Restaurant owner
    rest = await db.restaurants.find_one({"id": o.get("restaurant_id")}, {"_id": 0})
    await _create_notification(
        rest.get("owner_id") if rest else None,
        "order_update",
        "Rider transfer requested",
        f"{user.get('name') or 'The assigned rider'} reported '{prev_entry['reason_label']}' and released order #{o.get('order_number', oid[:6])}. Waiting for a new rider.",
        order_id=oid, restaurant_id=o.get("restaurant_id"),
    )

    # Customer
    if o.get("customer_id"):
        await _create_notification(
            o["customer_id"],
            "order_update",
            "Assigning a new rider \U0001F6F5",
            f"Your rider ran into an issue ({prev_entry['reason_label']}). We're re-assigning your order to another rider right away — sorry for the delay!",
            order_id=oid, restaurant_id=o.get("restaurant_id"),
        )

    updated = await db.orders.find_one({"id": oid}, {"_id": 0})
    return _ensure_order_number(updated)


class HandoverVerify(BaseModel):
    code: str


@api.post("/orders/{oid}/verify-handover")
async def verify_handover(
    oid: str,
    body: HandoverVerify,
    user: dict = Depends(require_role("restaurant_owner", "admin")),
):
    """Owner enters the 4-digit code the rider tells them.

    On success the order is marked `picked` (handed over) and both the
    customer and rider are notified. This replaces the direct "picked"
    status update for delivery orders so mis-pickups can't happen without
    the code exchange.
    """
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    o = _ensure_order_number(o)
    # Ownership guard for restaurant_owner (admin can override).
    if user["role"] == "restaurant_owner":
        rest = await db.restaurants.find_one(
            {"id": o.get("restaurant_id"), "owner_id": user["id"]}, {"_id": 0, "id": 1}
        )
        if not rest:
            raise HTTPException(403, "This order does not belong to your outlet")
    if not o.get("rider_id"):
        raise HTTPException(400, "No rider assigned yet")
    if o.get("status") not in ("ready", "preparing", "accepted"):
        # Only orders that have progressed from the kitchen make sense to hand over.
        # (Owner can still verify while it's in ready — the most common case.)
        raise HTTPException(400, f"Order is '{o.get('status')}', cannot hand over yet")
    if o.get("handover_verified"):
        raise HTTPException(400, "Order already handed over")
    submitted = re.sub(r"\D", "", body.code or "")[-4:]
    expected = str(o.get("handover_code") or "")
    if not submitted or len(submitted) != 4 or submitted != expected:
        raise HTTPException(400, "Incorrect handover code. Ask the rider to recheck.")

    _now = datetime.now(timezone.utc).isoformat()
    status_ts = dict(o.get("status_timestamps") or {})
    status_ts["picked"] = _now
    await db.orders.update_one(
        {"id": oid},
        {
            "$set": {
                "status": "picked",
                "handover_verified": True,
                "handover_verified_at": _now,
                "status_timestamps": status_ts,
            }
        },
    )
    # Notify rider + customer
    if o.get("rider_id"):
        await _create_notification(
            o["rider_id"],
            "order_update",
            "Order handed over \U0001F4E6",
            f"Handover code verified. You've picked up the order from {o.get('restaurant_name', 'the restaurant')}.",
            order_id=oid, restaurant_id=o.get("restaurant_id"),
        )
    await _create_notification(
        o.get("customer_id"),
        "order_update",
        "Rider picked up your order \U0001F6F5",
        f"The rider is on the way with your order from {o.get('restaurant_name', 'the restaurant')}.",
        order_id=oid, restaurant_id=o.get("restaurant_id"),
    )
    updated = await db.orders.find_one({"id": oid}, {"_id": 0})
    return _ensure_order_number(updated)


@api.patch("/orders/{oid}/rider-location")
async def rider_loc(oid: str, body: RiderLocation, user: dict = Depends(require_role("rider"))):
    now_iso = datetime.now(timezone.utc).isoformat()
    await db.orders.update_one(
        {"id": oid},
        {
            "$set": {
                "rider_lat": body.lat,
                "rider_lng": body.lng,
                "rider_location_updated_at": now_iso,
            }
        },
    )
    return {"ok": True, "updated_at": now_iso}


@api.get("/orders/available/feed")
async def available_for_rider(user: dict = Depends(require_role("rider"))):
    """Feed of orders a rider can accept.

    Two buckets are unioned:
      1. Fresh pickups — order is accepted/preparing/ready and has no rider yet.
      2. Transfers — a previous rider hit an emergency after pickup and released
         the order; it's now up for grabs by anyone EXCEPT the riders that
         already held it (tracked via `previous_riders`).

    Riders that have manually toggled themselves OFFLINE (via the header
    switch) get an empty feed so they don't see or auto-poll new pickups.
    """
    # Offline riders see nothing — they've explicitly stopped accepting.
    # `is_online` defaults to True for backward compatibility with older
    # rider accounts that never toggled the switch.
    if user.get("is_online") is False:
        return []
    query = {
        "$or": [
            {"status": {"$in": ["ready", "accepted", "preparing"]}, "rider_id": None, "transfer_requested": {"$ne": True}, "awaiting_payment": {"$ne": True}},
            {"transfer_requested": True, "rider_id": None, "awaiting_payment": {"$ne": True}},
        ]
    }
    cur = db.orders.find(query, {"_id": 0}).sort("placed_at", -1)
    docs = await cur.to_list(200)
    # Filter out orders where THIS rider is in previous_riders (can't re-take
    # the order they just released).
    my_id = user["id"]
    filtered = [
        d for d in docs
        if my_id not in {pr.get("rider_id") for pr in (d.get("previous_riders") or [])}
    ]
    return [_ensure_order_number(d) for d in filtered]


class RiderOnlineStatus(BaseModel):
    is_online: bool


@api.patch("/rider/online-status")
async def rider_set_online(body: RiderOnlineStatus, user: dict = Depends(require_role("rider"))):
    """Rider toggles themselves online/offline from the app header.

    Offline riders are excluded from the available-feed but can still see and
    finish deliveries they've already accepted — this only stops NEW pickups.
    """
    await db.users.update_one(
        {"id": user["id"]},
        {"$set": {"is_online": bool(body.is_online), "online_updated_at": datetime.now(timezone.utc).isoformat()}},
    )
    return {"ok": True, "is_online": bool(body.is_online)}


@api.post("/rider/heartbeat")
async def rider_heartbeat(body: RiderHeartbeat, user: dict = Depends(require_role("rider"))):
    """Rider app pings this every ~30s with current GPS while online.

    Backend uses `last_heartbeat_at` (< HEARTBEAT_STALE_SECS) + `last_lat/lng`
    to pick riders inside DISPATCH_RADIUS_KM buckets on order accept.
    A stale heartbeat drops the rider from nearby-first broadcast so we never
    ring a phone that's asleep / has GPS off.
    """
    if user.get("rider_verified") is False:
        # Silent no-op for unverified accounts — no location leak, no ping
        raise HTTPException(403, "Rider account pending verification")
    _now = datetime.now(timezone.utc).isoformat()
    await db.users.update_one(
        {"id": user["id"]},
        {"$set": {
            "last_lat": float(body.lat),
            "last_lng": float(body.lng),
            "last_heartbeat_at": _now,
        }},
    )
    return {"ok": True, "at": _now}


# ----------------------------- Reviews -----------------------------
@api.post("/reviews", response_model=Review)
async def add_review(body: ReviewCreate, user: dict = Depends(get_current_user)):
    # Prevent duplicate review for the same order by the same user
    if body.order_id:
        existing = await db.reviews.find_one({"order_id": body.order_id, "user_id": user["id"]}, {"_id": 0})
        if existing:
            raise HTTPException(409, "You have already reviewed this order")
    if body.rating < 1 or body.rating > 5:
        raise HTTPException(400, "Rating must be between 1 and 5")
    review = {
        "id": str(uuid.uuid4()),
        "restaurant_id": body.restaurant_id,
        "order_id": body.order_id,
        "user_id": user["id"],
        "user_name": user.get("name") or "User",
        "rating": body.rating,
        "comment": body.comment,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    await db.reviews.insert_one(dict(review))
    # Recompute restaurant rating
    revs = await db.reviews.find({"restaurant_id": body.restaurant_id}, {"_id": 0}).to_list(1000)
    if revs:
        avg = sum(r["rating"] for r in revs) / len(revs)
        await db.restaurants.update_one({"id": body.restaurant_id}, {"$set": {"rating": round(avg, 1)}})
    return Review(**review)


@api.get("/orders/{oid}/review")
async def get_my_order_review(oid: str, user: dict = Depends(get_current_user)):
    rev = await db.reviews.find_one({"order_id": oid, "user_id": user["id"]}, {"_id": 0})
    return rev or None


async def _enrich_reviews(reviews: list) -> dict:
    """Attach restaurant_name to each review and compute summary (count + average)."""
    rids = list({r.get("restaurant_id") for r in reviews if r.get("restaurant_id")})
    name_map: dict = {}
    if rids:
        async for rest in db.restaurants.find({"id": {"$in": rids}}, {"_id": 0, "id": 1, "name": 1}):
            name_map[rest["id"]] = rest.get("name")
    for r in reviews:
        r["restaurant_name"] = name_map.get(r.get("restaurant_id"), "Restaurant")
    count = len(reviews)
    avg = round(sum(r.get("rating", 0) for r in reviews) / count, 1) if count else 0.0
    return {"count": count, "average": avg, "reviews": reviews}


@api.get("/admin/reviews")
async def admin_reviews(user: dict = Depends(require_role("admin"))):
    """All customer reviews across every restaurant (newest first)."""
    reviews = await db.reviews.find({}, {"_id": 0}).sort("created_at", -1).to_list(2000)
    return await _enrich_reviews(reviews)


@api.get("/owner/reviews")
async def owner_reviews(user: dict = Depends(require_role("restaurant_owner"))):
    """Reviews for the restaurants owned by the current owner."""
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0, "id": 1}).to_list(50)
    rids = [r["id"] for r in rests]
    reviews = (
        await db.reviews.find({"restaurant_id": {"$in": rids}}, {"_id": 0}).sort("created_at", -1).to_list(2000)
        if rids else []
    )
    return await _enrich_reviews(reviews)


@api.get("/rider/reviews")
async def rider_reviews(user: dict = Depends(require_role("rider"))):
    """Reviews left on orders that this rider delivered."""
    orders = await db.orders.find({"rider_id": user["id"]}, {"_id": 0, "id": 1}).to_list(2000)
    oids = [o["id"] for o in orders]
    reviews = (
        await db.reviews.find({"order_id": {"$in": oids}}, {"_id": 0}).sort("created_at", -1).to_list(2000)
        if oids else []
    )
    return await _enrich_reviews(reviews)


@api.get("/me/details")
async def my_details(user: dict = Depends(get_current_user)):
    """Full profile details for the current user.
    Returns the user, their relevant approved application payload (owner/rider) and,
    for owners, their restaurant document — so the profile screen can show everything.
    """
    _ensure_user_account_id(user)
    out: dict = {
        "user": {k: user.get(k) for k in ("id", "phone", "name", "role", "created_at", "account_id")},
        "application": None,
        "restaurant": None,
    }
    app_type = None
    if user["role"] == "restaurant_owner":
        app_type = "restaurant_partner"
    elif user["role"] == "rider":
        app_type = "rider"

    if app_type:
        application = await db.applications.find_one(
            {"user_id": user["id"], "type": app_type, "status": "approved"},
            {"_id": 0},
            sort=[("updated_at", -1)],
        )
        if not application:
            application = await db.applications.find_one(
                {"user_id": user["id"], "type": app_type},
                {"_id": 0},
                sort=[("created_at", -1)],
            )
        out["application"] = application

    if user["role"] == "restaurant_owner":
        out["restaurant"] = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})

    return out


