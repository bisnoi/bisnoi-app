class Order(BaseModel):
    id: str
    customer_id: str
    customer_name: Optional[str] = None
    customer_phone: Optional[str] = None
    restaurant_id: str
    restaurant_name: str
    items: List[OrderItem]
    subtotal: int
    delivery_fee: int
    packing_charge: int = 0
    gst_percent: float = 0
    gst_amount: int = 0
    discount: int
    total: int
    address: Address
    status: str  # placed | accepted | preparing | ready | picked | delivered | cancelled
    payment_method: str
    payment_status: str = "pending"
    rider_id: Optional[str] = None
    rider_name: Optional[str] = None
    rider_lat: Optional[float] = None
    rider_lng: Optional[float] = None
    restaurant_lat: Optional[float] = None
    restaurant_lng: Optional[float] = None
    placed_at: str
    coupon_code: Optional[str] = None
    offer_id: Optional[str] = None
    offer: Optional[dict] = None
    note: Optional[str] = None
    simulated: bool = True
    # Customer-facing 10-digit order number (independent of the internal UUID id).
    # The LAST 4 digits act as the "handover code" the rider must recite to the
    # restaurant owner before the order can be handed over.
    order_number: Optional[str] = None
    handover_code: Optional[str] = None
    handover_verified: bool = False
    handover_verified_at: Optional[str] = None
    # Emergency rider-to-rider transfer flow. When a picked-up rider hits an
    # emergency (breakdown, injury, …) they release the order back to the
    # available feed; another rider picks it up. `previous_riders` is the audit
    # trail of everyone who has held (and released) this order.
    transfer_requested: bool = False
    transfer_reason: Optional[str] = None
    transfer_note: Optional[str] = None
    transfer_requested_at: Optional[str] = None
    transfer_completed_at: Optional[str] = None
    previous_riders: List[dict] = []
    # Estimated preparation time in minutes (max of items' prep_time). Used by
    # the restaurant-side kitchen timer to run green → red visual feedback.
    prep_min: Optional[int] = None
    # Rider-dispatch state. `dispatch_started_at` is set when the owner/admin
    # first flips the order to "accepted" and the broadcast fan-out begins.
    # `dispatch_attempts` counts every 15-second re-broadcast (see
    # DISPATCH_RADIUS_KM / DISPATCH_RETRY_SECS). `assigned_at` marks the
    # moment the first rider grabbed the order and closes the "waiting for
    # rider" popup on the owner/admin dashboards.
    dispatch_started_at: Optional[str] = None
    dispatch_attempts: int = 0
    dispatch_stalled: bool = False
    assigned_at: Optional[str] = None
    # Customer-shared 4-digit delivery OTP. Generated at placement, shown ONLY
    # to the customer, entered by the rider (with GPS coords) to mark delivered.
    # Prevents "phantom deliveries" where a fraudulent rider marks an order
    # complete without ever meeting the customer.
    delivery_code: Optional[str] = None
    delivery_verified: bool = False
    delivery_verified_at: Optional[str] = None
    delivery_verified_lat: Optional[float] = None
    delivery_verified_lng: Optional[float] = None

class StatusUpdate(BaseModel):
    status: str

class RiderLocation(BaseModel):
    lat: float
    lng: float


class RiderHeartbeat(BaseModel):
    """Rider app pings /rider/heartbeat every 30s with current geo-location.
    Riders with a stale heartbeat (> HEARTBEAT_STALE_SECS old) are excluded from
    the pickup-dispatch broadcast so we never route an order to a phone that's
    off / asleep / has lost GPS.
    """
    lat: float
    lng: float


class VerifyDelivery(BaseModel):
    """Rider-side proof-of-delivery. Rider submits the 4-digit `delivery_code`
    shown on the customer's app AND their current GPS coords. Server enforces
    both (code match + distance-from-drop < DELIVERY_GEOFENCE_METERS) so a
    rider can't mark an order 'delivered' from home."""
    code: str
    lat: Optional[float] = None
    lng: Optional[float] = None


# --- Rider-dispatch tuning knobs ------------------------------------------------
# Riders older than this haven't sent a heartbeat recently -> skipped in nearby
# dispatch. Falls back to broadcast-all when nobody has fresh location so demo /
# just-installed rider apps still receive notifications.
HEARTBEAT_STALE_SECS = 240
# Radius expansion on each retry attempt. First attempt sees only close riders;
# unresolved dispatches widen the net until the ~20 km cap. After the final
# attempt we bail out and prompt the restaurant owner to redispatch manually.
DISPATCH_RADIUS_KM = [5.0, 8.0, 12.0, 20.0]
DISPATCH_RETRY_SECS = 15
DELIVERY_GEOFENCE_METERS = 500

