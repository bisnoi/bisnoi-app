# ----------------------------- Auth helpers -----------------------------
def make_token(user_id: str, role: str) -> str:
    payload = {
        "sub": user_id,
        "role": role,
        "exp": datetime.now(timezone.utc) + timedelta(days=JWT_EXPIRES_DAYS),
    }
    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALGO)


DINEIN_JWT_EXPIRES_MIN = 240  # 4 hours — must re-scan QR after this


def make_dinein_token(restaurant_id: str, table_id: str) -> str:
    payload = {
        "typ": "dinein",
        "rid": restaurant_id,
        "tid": table_id,
        "exp": datetime.now(timezone.utc) + timedelta(minutes=DINEIN_JWT_EXPIRES_MIN),
    }
    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALGO)


def decode_dinein_token(token: str) -> dict:
    try:
        data = jwt.decode(token, JWT_SECRET, algorithms=[JWT_ALGO])
    except jwt.PyJWTError:
        raise HTTPException(401, "Dine-in session expired or invalid — please scan the table QR again")
    if data.get("typ") != "dinein":
        raise HTTPException(401, "Invalid dine-in session")
    return data

async def get_current_user(authorization: Optional[str] = Header(None)) -> dict:
    if not authorization or not authorization.lower().startswith("bearer "):
        raise HTTPException(401, "Missing token")
    token = authorization.split(" ", 1)[1]
    try:
        data = jwt.decode(token, JWT_SECRET, algorithms=[JWT_ALGO])
    except jwt.PyJWTError:
        raise HTTPException(401, "Invalid token")
    user = await db.users.find_one({"id": data["sub"]}, {"_id": 0})
    if not user:
        raise HTTPException(401, "User not found")
    return user

def require_role(*allowed: str):
    async def checker(user: dict = Depends(get_current_user)):
        role = user.get("role")
        if role in allowed:
            return user
        # ---- Staff role mapping ----
        # Middleware `enforce_staff_permissions` has already verified module
        # permission by URL prefix; here we just accept the mapped parent role
        # and (for restaurant_staff) transparently swap in the parent owner's
        # id so all existing `owner_id=user["id"]` lookups keep working.
        if role == "admin_staff" and "admin" in allowed:
            if user.get("active") is False:
                raise HTTPException(403, "Staff account disabled")
            return user
        if role == "restaurant_staff" and "restaurant_owner" in allowed:
            if user.get("active") is False:
                raise HTTPException(403, "Staff account disabled")
            parent = user.get("parent_id")
            if not parent:
                raise HTTPException(403, "Staff has no parent owner")
            u = dict(user)
            u["_staff_id"] = u.get("id")
            u["_staff_role"] = "restaurant_staff"
            u["id"] = parent  # transparent substitution
            return u
        raise HTTPException(403, "Forbidden")
    return checker


# ----------------------------- Auth routes -----------------------------
# A single hidden TEST account (e.g. for app-store review) with a FIXED OTP.
# It never sends an SMS and the code is NEVER exposed in the API response / UI.
# Everything else goes through the Message Central SMS provider (real OTP).
TEST_ACCOUNTS = {
    "8929926078": "989898",
    "9000000001": "989898",
}


@api.post("/auth/send-otp")
async def send_otp(body: OTPRequest):
    phone = (body.phone or "").strip()
    if len(phone) < 10:
        raise HTTPException(400, "Enter a valid mobile number")

    # Hidden test account -> store its fixed OTP, but respond exactly like a
    # normal SMS send (no code leaked to the client).
    if phone in TEST_ACCOUNTS:
        await db.otps.update_one(
            {"phone": phone},
            {"$set": {
                "phone": phone,
                "mode": "test",
                "code": TEST_ACCOUNTS[phone],
                "expires_at": (datetime.now(timezone.utc) + timedelta(minutes=10)).isoformat(),
            }},
            upsert=True,
        )
        return {"sent": True, "channel": "sms", "message": "OTP sent."}

    # Real number -> Message Central SMS (no demo fallback).
    if not messagecentral_configured():
        raise HTTPException(503, "SMS service is not configured. Please contact support.")
    try:
        verification_id = await mc_send_otp(phone)
    except Exception as e:  # noqa: BLE001
        log.error("[send-otp] Message Central failed for %s: %s", phone, e)
        raise HTTPException(502, "Could not send OTP via SMS right now. Please try again in a moment.")

    await db.otps.update_one(
        {"phone": phone},
        {"$set": {
            "phone": phone,
            "mode": "mc",
            "verification_id": verification_id,
            "expires_at": (datetime.now(timezone.utc) + timedelta(minutes=10)).isoformat(),
        }},
        upsert=True,
    )
    log.info(f"OTP (sms) sent to {phone} verificationId={verification_id}")
    return {"sent": True, "channel": "sms", "message": "OTP sent via SMS."}


@api.post("/auth/verify-otp", response_model=AuthResponse)
async def verify_otp(body: OTPVerify):
    record = await db.otps.find_one({"phone": body.phone}, {"_id": 0})
    if not record:
        raise HTTPException(400, "Please request an OTP first.")

    mode = record.get("mode")
    if mode == "mc":
        verification_id = record.get("verification_id")
        if not verification_id:
            raise HTTPException(400, "Please request an OTP first.")
        try:
            result = await mc_validate_otp(verification_id, body.code)
        except Exception as e:  # noqa: BLE001
            log.error("[verify-otp] Message Central validate error: %s", e)
            raise HTTPException(502, "Could not verify OTP right now. Please try again.")
        if not result.get("verified"):
            rc = result.get("responseCode")
            status = result.get("status")
            if rc == "705" or status == "VERIFICATION_EXPIRED":
                raise HTTPException(400, "OTP expired. Please resend.")
            raise HTTPException(400, "Invalid OTP")
    elif mode == "test":
        if record.get("code") != body.code:
            raise HTTPException(400, "Invalid OTP")
    else:
        raise HTTPException(400, "Please request an OTP first.")

    # Look up existing user by phone only — preserve their role if they exist.
    user = await db.users.find_one({"phone": body.phone}, {"_id": 0})
    if not user:
        # New user → default role is "customer". Users can apply to become
        # restaurant_owner / rider via the in-app application flow.
        new_role = body.role or "customer"
        uid = str(uuid.uuid4())
        user_doc = {
            "id": uid,
            "phone": body.phone,
            "name": body.name or f"User {body.phone[-4:]}",
            "role": new_role,
            "created_at": datetime.now(timezone.utc).isoformat(),
            "account_id": _account_id_for_user({"id": uid, "role": new_role}),
        }
        await db.users.insert_one(dict(user_doc))
        user = user_doc
    else:
        _ensure_user_account_id(user)
        # Persist the backfilled account_id so it's stable going forward.
        await db.users.update_one({"id": user["id"]}, {"$set": {"account_id": user["account_id"]}})
    await db.otps.delete_one({"phone": body.phone})
    token = make_token(user["id"], user["role"])
    return AuthResponse(token=token, user=User(**user))


