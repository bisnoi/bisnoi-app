@api.get("/owner/stats")
async def owner_stats(user: dict = Depends(require_role("restaurant_owner"))):
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0}).to_list(50)
    rids = [r["id"] for r in rests]
    orders = await db.orders.find({"restaurant_id": {"$in": rids}, "awaiting_payment": {"$ne": True}}, {"_id": 0, "total": 1, "status": 1, "placed_at": 1}).to_list(2000)
    today = datetime.now(timezone.utc).isoformat()[:10]
    delivery_revenue = sum(o["total"] for o in orders if o["status"] == "delivered")
    pos_bills = await db.pos_orders.find({"restaurant_id": {"$in": rids}}, {"_id": 0, "total": 1, "created_at": 1}).to_list(5000)
    pos_revenue = sum(b.get("total", 0) for b in pos_bills)
    cats_count = await db.categories.count_documents({"restaurant_id": {"$in": rids}})
    items_count = await db.menu_items.count_documents({"restaurant_id": {"$in": rids}})
    return {
        "restaurants": len(rests),
        "total_orders": len(orders),
        "orders_today": sum(1 for o in orders if o["placed_at"][:10] == today),
        "pending_orders": sum(1 for o in orders if o["status"] in ["placed", "accepted", "preparing", "ready", "picked"]),
        "completed_orders": sum(1 for o in orders if o["status"] == "delivered"),
        "cancelled_orders": sum(1 for o in orders if o["status"] == "cancelled"),
        "revenue": round(delivery_revenue + pos_revenue, 2),
        "delivery_revenue": round(delivery_revenue, 2),
        "pos_revenue": round(pos_revenue, 2),
        "pos_bills": len(pos_bills),
        "active_orders": sum(1 for o in orders if o["status"] in ["placed", "accepted", "preparing", "ready", "picked"]),
        "total_categories": cats_count,
        "total_menu_items": items_count,
    }


# ----------------------------- POS / Billing (owner counter billing) -----------------------------
class PosItemInput(BaseModel):
    menu_item_id: Optional[str] = None
    name: str
    price: float
    qty: int

class PosOrderCreate(BaseModel):
    restaurant_id: Optional[str] = None  # defaults to the owner's restaurant
    order_type: Literal["dine_in", "takeaway", "walk_in"] = "walk_in"
    items: List[PosItemInput]
    discount_type: Optional[Literal["flat", "percent"]] = None
    discount_value: float = 0
    tax_enabled: bool = False
    tax_percent: float = 0
    payment_method: Literal["cash", "upi", "card"] = "cash"
    customer_name: Optional[str] = None
    customer_phone: Optional[str] = None
    note: Optional[str] = None


def _round2(x: float) -> float:
    return round(float(x) + 1e-9, 2)


async def _build_pos_bill(rest: dict, owner_id: str, body: PosOrderCreate) -> dict:
    items = []
    subtotal = 0.0
    for it in body.items:
        if it.qty <= 0:
            continue
        amount = _round2(it.price * it.qty)
        subtotal += amount
        items.append({
            "menu_item_id": it.menu_item_id,
            "name": it.name,
            "price": _round2(it.price),
            "qty": it.qty,
            "amount": amount,
        })
    if not items:
        raise HTTPException(400, "Add at least one item to the bill")
    subtotal = _round2(subtotal)
    # Discount
    discount_amount = 0.0
    if body.discount_type and body.discount_value and body.discount_value > 0:
        if body.discount_type == "percent":
            discount_amount = _round2(subtotal * min(body.discount_value, 100) / 100)
        else:
            discount_amount = _round2(min(body.discount_value, subtotal))
    taxable = _round2(subtotal - discount_amount)
    # Tax (GST)
    tax_percent = 0.0
    tax_amount = 0.0
    if body.tax_enabled and body.tax_percent and body.tax_percent > 0:
        tax_percent = float(body.tax_percent)
        tax_amount = _round2(taxable * tax_percent / 100)
    total = _round2(taxable + tax_amount)
    # Sequential bill number per restaurant
    count = await db.pos_orders.count_documents({"restaurant_id": rest["id"]})
    bill_number = f"POS-{count + 1:05d}"
    return {
        "id": str(uuid.uuid4()),
        "bill_number": bill_number,
        "restaurant_id": rest["id"],
        "restaurant_name": rest.get("name"),
        "owner_id": owner_id,
        "order_type": body.order_type,
        "items": items,
        "item_count": sum(i["qty"] for i in items),
        "subtotal": subtotal,
        "discount_type": body.discount_type,
        "discount_value": _round2(body.discount_value or 0),
        "discount_amount": discount_amount,
        "tax_enabled": bool(body.tax_enabled),
        "tax_percent": tax_percent,
        "tax_amount": tax_amount,
        "total": total,
        "payment_method": body.payment_method,
        "customer_name": body.customer_name,
        "customer_phone": body.customer_phone,
        "note": body.note,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }


@api.post("/owner/pos/orders")
async def owner_create_pos(body: PosOrderCreate, user: dict = Depends(require_role("restaurant_owner"))):
    if body.restaurant_id:
        rest = await db.restaurants.find_one({"id": body.restaurant_id, "owner_id": user["id"]}, {"_id": 0})
    else:
        rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant found for your account")
    if rest.get("pos_enabled", True) is False:
        raise HTTPException(403, "POS is disabled for this outlet. Please contact Bisnoi admin to enable it.")
    doc = await _build_pos_bill(rest, user["id"], body)
    await db.pos_orders.insert_one(dict(doc))
    doc.pop("_id", None)
    return doc


