@api.get("/owner/restaurants")
async def owner_rests(user: dict = Depends(require_role("restaurant_owner"))):
    return await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0}).to_list(50)


@api.get("/owner/restaurant")
async def owner_my_restaurant(user: dict = Depends(require_role("restaurant_owner"))):
    """Return the single restaurant assigned to this owner (most recent if multiple)."""
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0}).to_list(50)
    if not rests:
        return None
    return _with_open(rests[0])


class AvailabilityUpdate(BaseModel):
    is_open: Optional[bool] = None
    operating_hours: Optional[List[OperatingHour]] = None


@api.patch("/owner/availability")
async def owner_set_availability(body: AvailabilityUpdate, user: dict = Depends(require_role("restaurant_owner"))):
    """Owner toggles online/offline and/or sets the 7-day operating hours for their restaurant."""
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant found for your account")
    upd: dict = {}
    if body.is_open is not None:
        upd["is_open"] = body.is_open
    if body.operating_hours is not None:
        upd["operating_hours"] = [oh.dict() for oh in body.operating_hours]
    if not upd:
        raise HTTPException(400, "Nothing to update")
    await db.restaurants.update_one({"id": rest["id"]}, {"$set": upd})
    r = await db.restaurants.find_one({"id": rest["id"]}, {"_id": 0})
    return _with_open(r)


@api.post("/owner/restaurants")
async def owner_create_restaurant_forbidden(user: dict = Depends(require_role("restaurant_owner"))):
    """Owners CANNOT create restaurants. Only Admin can. Returns 403 by design."""
    raise HTTPException(403, "Restaurant creation is admin-only. Please contact admin to assign you a restaurant.")


# Categories (owner-managed)
@api.get("/owner/categories")
async def owner_categories(user: dict = Depends(require_role("restaurant_owner"))):
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0}).to_list(50)
    rids = [r["id"] for r in rests]
    cats = await db.categories.find({"restaurant_id": {"$in": rids}}, {"_id": 0}).sort("sort_order", 1).to_list(500)
    return cats


@api.post("/owner/categories")
async def owner_create_category(body: CategoryCreate, user: dict = Depends(require_role("restaurant_owner"))):
    """Owner creates a category (parent_id=None) or a subcategory (parent_id set)."""
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant found for your account")
    parent_id = body.parent_id or None
    if parent_id:
        parent = await db.categories.find_one({"id": parent_id, "restaurant_id": rest["id"]}, {"_id": 0})
        if not parent:
            raise HTTPException(404, "Parent category not found")
        if parent.get("parent_id"):
            raise HTTPException(400, "Subcategories can only be one level deep")
    if body.sort_order and body.sort_order > 0:
        sort_order = body.sort_order
    else:
        sort_order = await db.categories.count_documents({"restaurant_id": rest["id"], "parent_id": parent_id}) + 1
    cat = {
        "id": str(uuid.uuid4()),
        "restaurant_id": rest["id"],
        "name": body.name,
        "parent_id": parent_id,
        "sort_order": sort_order,
        "is_enabled": body.is_enabled,
    }
    await db.categories.insert_one(dict(cat))
    return cat


@api.patch("/owner/categories/{cid}")
async def owner_update_category(cid: str, body: CategoryUpdate, user: dict = Depends(require_role("restaurant_owner"))):
    cat = await db.categories.find_one({"id": cid}, {"_id": 0})
    if not cat:
        raise HTTPException(404, "Category not found")
    rest = await db.restaurants.find_one({"id": cat["restaurant_id"], "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(403, "Forbidden")
    updates = {k: v for k, v in body.dict().items() if v is not None}
    if updates:
        await db.categories.update_one({"id": cid}, {"$set": updates})
    return await db.categories.find_one({"id": cid}, {"_id": 0})


@api.delete("/owner/categories/{cid}")
async def owner_delete_category(cid: str, user: dict = Depends(require_role("restaurant_owner"))):
    cat = await db.categories.find_one({"id": cid}, {"_id": 0})
    if not cat:
        raise HTTPException(404, "Not found")
    rest = await db.restaurants.find_one({"id": cat["restaurant_id"], "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(403, "Forbidden")
    # Detach items from this category (and its subcategories), then delete subcategories
    child_ids = [c["id"] async for c in db.categories.find({"parent_id": cid}, {"_id": 0, "id": 1})]
    all_ids = [cid] + child_ids
    await db.menu_items.update_many({"category_id": {"$in": all_ids}}, {"$set": {"category_id": None, "category": ""}})
    await db.menu_items.update_many({"subcategory_id": {"$in": all_ids}}, {"$set": {"subcategory_id": None, "subcategory": None}})
    await db.categories.delete_many({"parent_id": cid})
    await db.categories.delete_one({"id": cid})
    return {"ok": True}


@api.post("/owner/categories/reorder")
async def owner_reorder_categories(body: CategoryReorder, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant assigned")
    for idx, cid in enumerate(body.ids):
        await db.categories.update_one(
            {"id": cid, "restaurant_id": rest["id"]},
            {"$set": {"sort_order": idx + 1}},
        )
    return {"ok": True}


async def _resolve_cat_sub(rid: str, category: Optional[str], category_id: Optional[str], subcategory_id: Optional[str]):
    """Resolve display names for a category_id + subcategory_id within a restaurant."""
    cat_name = category or ""
    if category_id:
        cat = await db.categories.find_one({"id": category_id, "restaurant_id": rid}, {"_id": 0})
        if cat:
            cat_name = cat["name"]
    sub_name = None
    if subcategory_id:
        sub = await db.categories.find_one({"id": subcategory_id, "restaurant_id": rid}, {"_id": 0})
        if sub:
            sub_name = sub["name"]
    return cat_name, sub_name


# Menu items
@api.get("/owner/menu")
async def owner_list_items(user: dict = Depends(require_role("restaurant_owner"))):
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0}).to_list(50)
    rids = [r["id"] for r in rests]
    items = await db.menu_items.find({"restaurant_id": {"$in": rids}}, {"_id": 0}).to_list(500)
    # attach variations for each
    for it in items:
        it["variations"] = await db.item_variations.find({"menu_item_id": it["id"]}, {"_id": 0}).to_list(50)
    return items


@api.post("/owner/menu", response_model=MenuItem)
async def owner_create_item(body: MenuItemCreate, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant assigned to you yet. Contact admin.")
    # Resolve category name from category_id if provided
    cat_name, sub_name = await _resolve_cat_sub(rest["id"], body.category, body.category_id, body.subcategory_id)
    # Cap images at 5
    images = (body.images or [])[:5]
    primary = body.image or (images[0] if images else "")
    item = {
        "id": str(uuid.uuid4()),
        "restaurant_id": rest["id"],
        "name": body.name,
        "description": body.description or "",
        "price": body.price,
        "baseline_price": int(body.price or 0),
        "image": primary,
        "images": images,
        "category": cat_name,
        "category_id": body.category_id,
        "subcategory_id": body.subcategory_id,
        "subcategory": sub_name,
        "veg": body.veg,
        "available": body.is_available,
        "is_available": body.is_available,
        "out_of_stock": body.out_of_stock,
        "prep_time": body.prep_time,
        "rating": 4.2,
        "approval_status": "pending",
        "reject_reason": None,
    }
    await db.menu_items.insert_one(dict(item))
    return MenuItem(**item)


@api.post("/owner/restaurants/{rid}/menu", response_model=MenuItem)
async def owner_add_item_legacy(rid: str, body: MenuItemCreate, user: dict = Depends(require_role("restaurant_owner"))):
    """Legacy path used by older clients. Owner can only add items to their own restaurant. Items start pending admin approval."""
    rest = await db.restaurants.find_one({"id": rid, "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    cat_name, sub_name = await _resolve_cat_sub(rid, body.category, body.category_id, body.subcategory_id)
    images = (body.images or [])[:5]
    primary = body.image or (images[0] if images else "")
    # Auto-generate a fresh description when none was provided.
    description = body.description or ""
    if not description.strip():
        description = await _generate_item_description(body.name, body.veg)
    # NO AI photo generation — items without a photo simply stay blank (owner request:
    # the AI menu scan / add flows must never generate item photos).
    item = {
        "id": str(uuid.uuid4()),
        "restaurant_id": rid,
        "name": body.name,
        "description": description,
        "price": body.price,
        "baseline_price": int(body.price or 0),
        "image": primary,
        "images": images,
        "category": cat_name,
        "category_id": body.category_id,
        "subcategory_id": body.subcategory_id,
        "subcategory": sub_name,
        "veg": body.veg,
        "available": body.is_available,
        "is_available": body.is_available,
        "out_of_stock": body.out_of_stock,
        "prep_time": body.prep_time,
        "rating": 4.2,
        "approval_status": "pending",
        "reject_reason": None,
        "image_status": None,
    }
    await db.menu_items.insert_one(dict(item))
    return MenuItem(**item)


@api.patch("/owner/menu/{mid}")
async def owner_update_item(mid: str, body: dict, user: dict = Depends(require_role("restaurant_owner"))):
    item = await db.menu_items.find_one({"id": mid}, {"_id": 0})
    if not item:
        raise HTTPException(404, "Not found")
    rest = await db.restaurants.find_one({"id": item["restaurant_id"], "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(403, "Forbidden")
    allowed_keys = {"name", "description", "price", "image", "images", "category", "category_id",
                    "subcategory_id", "subcategory", "veg", "available", "is_available", "out_of_stock", "prep_time"}
    allowed = {k: v for k, v in body.items() if k in allowed_keys}
    # ---- Price policy enforcement (admin-controlled hike/drop caps) ----
    if "price" in allowed:
        try:
            new_price = int(allowed["price"] or 0)
        except Exception:
            raise HTTPException(400, "Price must be a whole number")
        if new_price < 0:
            raise HTTPException(400, "Price cannot be negative")
        from price_policy import enforce_price_change  # noqa: E402
        _ = await enforce_price_change(db, rest, item, new_price)
        # Persist a stable baseline on first edit so owners can't ratchet prices
        # up over multiple small hikes. Uses the pre-edit price as the anchor.
        if not item.get("baseline_price"):
            allowed["baseline_price"] = int(item.get("price") or new_price)
        allowed["price"] = new_price
    if "images" in allowed and isinstance(allowed["images"], list):
        allowed["images"] = allowed["images"][:5]
    # Sync available <-> is_available
    if "is_available" in allowed and "available" not in allowed:
        allowed["available"] = allowed["is_available"]
    if "available" in allowed and "is_available" not in allowed:
        allowed["is_available"] = allowed["available"]
    # Auto-resolve category name from category_id
    if "category_id" in allowed and allowed["category_id"]:
        cat = await db.categories.find_one({"id": allowed["category_id"]}, {"_id": 0})
        if cat:
            allowed["category"] = cat["name"]
    # Auto-resolve subcategory name
    if "subcategory_id" in allowed:
        if allowed["subcategory_id"]:
            sub = await db.categories.find_one({"id": allowed["subcategory_id"]}, {"_id": 0})
            allowed["subcategory"] = sub["name"] if sub else None
        else:
            allowed["subcategory"] = None
    await db.menu_items.update_one({"id": mid}, {"$set": allowed})
    return await db.menu_items.find_one({"id": mid}, {"_id": 0})


@api.delete("/owner/menu/{mid}")
async def owner_delete_item(mid: str, user: dict = Depends(require_role("restaurant_owner"))):
    item = await db.menu_items.find_one({"id": mid}, {"_id": 0})
