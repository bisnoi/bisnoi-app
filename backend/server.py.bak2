@api.post("/admin/restaurants/{rid}/menu", response_model=MenuItem)
async def admin_create_item(rid: str, body: MenuItemCreate, user: dict = Depends(require_role("admin"))):
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    cat_name = body.category or ""
    if body.category_id:
        cat = await db.categories.find_one({"id": body.category_id, "restaurant_id": rid}, {"_id": 0})
        if cat:
            cat_name = cat["name"]
    images = (body.images or [])[:5]
    primary = body.image or (images[0] if images else "")
    item = {
        "id": str(uuid.uuid4()),
        "restaurant_id": rid,
        "name": body.name,
        "description": body.description or "",
        "price": body.price,
        "baseline_price": int(body.price or 0),
        "image": primary,
        "images": images,
        "category": cat_name,
        "category_id": body.category_id,
        "veg": body.veg,
        "available": body.is_available,
        "is_available": body.is_available,
        "out_of_stock": body.out_of_stock,
        "prep_time": body.prep_time,
        "rating": 4.2,
    }
    await db.menu_items.insert_one(dict(item))
    return MenuItem(**item)


@api.patch("/admin/menu/{mid}")
async def admin_update_item(mid: str, body: dict, user: dict = Depends(require_role("admin"))):
    item = await db.menu_items.find_one({"id": mid}, {"_id": 0})
    if not item:
        raise HTTPException(404, "Not found")
    allowed_keys = {"name", "description", "price", "image", "images", "category", "category_id",
                    "veg", "available", "is_available", "out_of_stock", "prep_time", "baseline_price"}
    allowed = {k: v for k, v in body.items() if k in allowed_keys}
    # Admin edits to `price` reset the baseline (admin has final say). Admin can
    # also explicitly set `baseline_price` (e.g. to lock a reference without
    # changing the live price).
    if "price" in allowed and "baseline_price" not in allowed:
        try:
            allowed["baseline_price"] = int(allowed["price"] or 0)
        except Exception:
            pass
    if "images" in allowed and isinstance(allowed["images"], list):
        allowed["images"] = allowed["images"][:5]
    if "is_available" in allowed and "available" not in allowed:
        allowed["available"] = allowed["is_available"]
    if "available" in allowed and "is_available" not in allowed:
        allowed["is_available"] = allowed["available"]
    if "category_id" in allowed and allowed["category_id"]:
        cat = await db.categories.find_one({"id": allowed["category_id"]}, {"_id": 0})
        if cat:
            allowed["category"] = cat["name"]
    await db.menu_items.update_one({"id": mid}, {"$set": allowed})
    return await db.menu_items.find_one({"id": mid}, {"_id": 0})


@api.delete("/admin/menu/{mid}")
async def admin_delete_item(mid: str, user: dict = Depends(require_role("admin"))):
    item = await db.menu_items.find_one({"id": mid}, {"_id": 0})
    if not item:
        raise HTTPException(404, "Not found")
    await db.menu_items.delete_one({"id": mid})
    await db.item_variations.delete_many({"menu_item_id": mid})
    return {"ok": True}


@api.get("/admin/menu/pending-counts")
async def admin_menu_pending_counts(user: dict = Depends(require_role("admin"))):
    """Returns {restaurant_id: pending_item_count} for restaurants that have owner-submitted items awaiting approval."""
    out: dict = {}
    pipeline = [
        {"$match": {"approval_status": "pending"}},
        {"$group": {"_id": "$restaurant_id", "count": {"$sum": 1}}},
    ]
    async for row in db.menu_items.aggregate(pipeline):
        if row["_id"]:
            out[row["_id"]] = row["count"]
    return out


async def _create_notification(user_id: Optional[str], ntype: str, title: str, body: str, **extra):
    """Insert an in-app notification for a user. No-op if user_id is missing.

    Respects admin-configured `notification_settings`: if the event is disabled
    globally OR disabled for the recipient's role, both the in-app row AND the
    web-push are suppressed. Admin marketing broadcasts bypass this via the
    dedicated /admin/push/broadcast endpoint.
    """
    if not user_id:
        return
    # Resolve the recipient role so notification settings can gate per-role.
    role = None
    try:
        u = await db.users.find_one({"id": user_id}, {"_id": 0, "role": 1})
        role = (u or {}).get("role")
    except Exception:  # noqa: BLE001
        role = None
    # Consult admin-configured gate (event-key + role toggle).
    try:
        from notif_ext import is_event_allowed_for_role
        allowed = await is_event_allowed_for_role(db, ntype, role)
    except Exception as e:  # noqa: BLE001
        log.warning("notif gate lookup failed (defaulting to allow): %s", e)
        allowed = True
    if not allowed:
        return
    notif = {
        "id": str(uuid.uuid4()),
        "user_id": user_id,
        "type": ntype,
        "title": title,
        "body": body,
        "read": False,
        "created_at": datetime.now(timezone.utc).isoformat(),
        **extra,
    }
    await db.notifications.insert_one(dict(notif))
    # Best-effort Web Push so users are alerted even when the app is in the background.
    try:
        from push import send_push_to_user
        order_id = extra.get("order_id")
        url = f"/order/{order_id}" if order_id else "/"
        await send_push_to_user(db, user_id, {
            "title": title,
            "body": body,
            "url": url,
            "type": ntype,
            "order_id": order_id,
        })
    except Exception as e:  # noqa: BLE001
        log.warning("push notify failed: %s", e)
    # Best-effort NATIVE push (FCM / APNs) via the Emergent managed relay so
    # installed-app users are alerted even when the app is backgrounded/killed.
    try:
        from native_push import send_push as _send_native_push
        _oid = extra.get("order_id")
        _nav = f"/order/{_oid}" if _oid else "/"
        await _send_native_push(db, [user_id], {"title": title, "message": body, "action_url": _nav})
    except Exception as e:  # noqa: BLE001
        log.warning("native push notify failed: %s", e)


@api.patch("/admin/menu/{mid}/approve")
async def admin_approve_item(mid: str, user: dict = Depends(require_role("admin"))):
    item = await db.menu_items.find_one({"id": mid}, {"_id": 0})
    if not item:
        raise HTTPException(404, "Not found")
    # On approval, lock the baseline_price to the approved price so the owner's
    # future edits are bounded against this reference.
    update = {"approval_status": "approved", "reject_reason": None,
              "baseline_price": int(item.get("price") or 0)}
    await db.menu_items.update_one({"id": mid}, {"$set": update})
    rest = await db.restaurants.find_one({"id": item["restaurant_id"]}, {"_id": 0})
    await _create_notification(
        rest.get("owner_id") if rest else None,
        "item_approved",
        "Menu item approved",
        f"\u201c{item['name']}\u201d has been approved and is now live for customers.",
        item_id=mid, restaurant_id=item["restaurant_id"],
    )
    return await db.menu_items.find_one({"id": mid}, {"_id": 0})


@api.patch("/admin/menu/{mid}/reject")
async def admin_reject_item(mid: str, body: dict, user: dict = Depends(require_role("admin"))):
    item = await db.menu_items.find_one({"id": mid}, {"_id": 0})
    if not item:
        raise HTTPException(404, "Not found")
    reason = (body or {}).get("reason") or ""
    await db.menu_items.update_one({"id": mid}, {"$set": {"approval_status": "rejected", "reject_reason": reason}})
    rest = await db.restaurants.find_one({"id": item["restaurant_id"]}, {"_id": 0})
    body_text = f"\u201c{item['name']}\u201d was rejected by admin."
    if reason:
        body_text += f" Reason: {reason}"
    await _create_notification(
        rest.get("owner_id") if rest else None,
        "item_rejected",
        "Menu item rejected",
        body_text,
        item_id=mid, restaurant_id=item["restaurant_id"],
    )
    return await db.menu_items.find_one({"id": mid}, {"_id": 0})


