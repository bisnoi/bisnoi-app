# ----------------------------- App Settings (Theme) -----------------------------
DEFAULT_THEME_COLOR = "#16A34A"
_HEX_RE = re.compile(r"^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$")


class ThemeUpdate(BaseModel):
    color: str


async def _get_theme_color() -> str:
    doc = await db.settings.find_one({"key": "app_theme"})
    if doc and isinstance(doc.get("color"), str) and _HEX_RE.match(doc["color"]):
        return doc["color"]
    return DEFAULT_THEME_COLOR


@api.get("/settings/theme")
async def get_theme_settings():
    """Public — every client reads the admin-chosen accent color on boot."""
    return {"color": await _get_theme_color()}


@api.patch("/admin/settings/theme")
async def update_theme_settings(body: ThemeUpdate, user: dict = Depends(require_role("admin"))):
    color = (body.color or "").strip()
    if not _HEX_RE.match(color):
        raise HTTPException(400, "Invalid hex color (expected #RRGGBB)")
    await db.settings.update_one(
        {"key": "app_theme"},
        {"$set": {
            "key": "app_theme",
            "color": color,
            "updated_at": datetime.now(timezone.utc).isoformat(),
            "updated_by": user["id"],
        }},
        upsert=True,
    )
    return {"color": color}


# ----------------------------- App Settings (Custom CSS) -----------------------------
MAX_CUSTOM_CSS_LEN = 200_000  # 200 KB is plenty for hotfix CSS


class CustomCssUpdate(BaseModel):
    css: str = ""


@api.get("/settings/custom-css")
async def get_custom_css():
    """Public — every client loads admin-authored hotfix CSS on boot (web only)."""
    doc = await db.settings.find_one({"key": "custom_css"}, {"_id": 0})
    return {
        "css": (doc or {}).get("css", "") or "",
        "updated_at": (doc or {}).get("updated_at"),
    }


@api.put("/admin/settings/custom-css")
async def update_custom_css(body: CustomCssUpdate, user: dict = Depends(require_role("admin"))):
    css = body.css or ""
    if len(css) > MAX_CUSTOM_CSS_LEN:
        raise HTTPException(400, f"CSS too large (max {MAX_CUSTOM_CSS_LEN // 1000} KB)")
    # Injected via element.textContent (never innerHTML), so no HTML can execute;
    # still strip a closing style tag defensively.
    css = css.replace("</style", "<\\/style")
    now = datetime.now(timezone.utc).isoformat()
    await db.settings.update_one(
        {"key": "custom_css"},
        {"$set": {"key": "custom_css", "css": css, "updated_at": now, "updated_by": user["id"]}},
        upsert=True,
    )
    return {"css": css, "updated_at": now}


# ----------------------------- App Charges (packing / GST / delivery) -----------------------------
DEFAULT_CHARGES = {
    "delivery_charge": 29,       # flat ₹ delivery fee
    "free_delivery_above": 199,  # subtotal ≥ this ⇒ free delivery (0 disables)
    "packing_charge": 0,         # flat ₹ packing fee per order
    "gst_percent": 0.0,          # GST % applied on (subtotal - discount)
}


class ChargesUpdate(BaseModel):
    delivery_charge: Optional[float] = None
    free_delivery_above: Optional[float] = None
    packing_charge: Optional[float] = None
    gst_percent: Optional[float] = None


async def _get_charges() -> dict:
    """Now backed by the unified platform config (delivery + per-km + commission + rider payout)."""
    return await get_platform_config(db)


@api.get("/settings/charges")
async def get_charges_settings():
    """Public — customer app reads order charges to show the bill breakdown."""
    return await _get_charges()


@api.patch("/admin/settings/charges")
async def update_charges_settings(body: ChargesUpdate, user: dict = Depends(require_role("admin"))):
    patch = {}
    for k in DEFAULT_CHARGES:
        v = getattr(body, k, None)
        if v is not None:
            if v < 0:
                raise HTTPException(400, f"{k} cannot be negative")
            patch[k] = v
    cfg = await save_platform_config(db, patch, user["id"])
    return {k: cfg[k] for k in DEFAULT_CHARGES}


# ----------------------------- WhatsApp Cloud API settings (admin-configurable) -----------------------------
WHATSAPP_FIELDS = ["access_token", "phone_number_id", "api_version", "bill_template", "template_lang", "default_cc"]
WHATSAPP_DEFAULTS = {"api_version": "v21.0", "template_lang": "en", "default_cc": "91"}


async def _get_whatsapp_config(secret: bool = False) -> dict:
    """Effective WhatsApp config: DB admin settings merged over env defaults.
    secret=True returns the real access_token (server-side use); otherwise it's masked.
    """
    doc = await db.settings.find_one({"key": "whatsapp_config"}, {"_id": 0}) or {}
    cfg = {
        "enabled": bool(doc.get("enabled", True)),
        "access_token": doc.get("access_token") or os.environ.get("WHATSAPP_ACCESS_TOKEN", ""),
        "phone_number_id": doc.get("phone_number_id") or os.environ.get("WHATSAPP_PHONE_NUMBER_ID", ""),
        "api_version": doc.get("api_version") or os.environ.get("WHATSAPP_API_VERSION", WHATSAPP_DEFAULTS["api_version"]),
        "bill_template": doc.get("bill_template") or os.environ.get("WHATSAPP_BILL_TEMPLATE", ""),
        "template_lang": doc.get("template_lang") or os.environ.get("WHATSAPP_TEMPLATE_LANG", WHATSAPP_DEFAULTS["template_lang"]),
        "default_cc": doc.get("default_cc") or os.environ.get("WHATSAPP_DEFAULT_CC", WHATSAPP_DEFAULTS["default_cc"]),
    }
    if not secret:
        tok = cfg["access_token"] or ""
        cfg["access_token_set"] = bool(tok)
        cfg["access_token"] = (("\u2022" * 6) + tok[-4:]) if tok else ""
        cfg["configured"] = bool((doc.get("access_token") or os.environ.get("WHATSAPP_ACCESS_TOKEN")) and cfg["phone_number_id"])
    return cfg


class WhatsAppUpdate(BaseModel):
    enabled: Optional[bool] = None
    access_token: Optional[str] = None
    phone_number_id: Optional[str] = None
    api_version: Optional[str] = None
    bill_template: Optional[str] = None
    template_lang: Optional[str] = None
    default_cc: Optional[str] = None


@api.get("/admin/settings/whatsapp")
async def admin_get_whatsapp(user: dict = Depends(require_role("admin"))):
    """Admin reads the WhatsApp Cloud API config (access token is masked)."""
    return await _get_whatsapp_config(secret=False)


@api.patch("/admin/settings/whatsapp")
async def admin_update_whatsapp(body: WhatsAppUpdate, user: dict = Depends(require_role("admin"))):
    upd = {"key": "whatsapp_config"}
    if body.enabled is not None:
        upd["enabled"] = bool(body.enabled)
    for f in WHATSAPP_FIELDS:
        v = getattr(body, f, None)
        if v is None:
            continue
        v = v.strip()
        # An access token of all bullets means "unchanged" — don't overwrite the stored one.
        if f == "access_token" and (not v or set(v) <= {"\u2022"} or v.startswith("\u2022")):
            continue
        upd[f] = v
    upd["updated_at"] = datetime.now(timezone.utc).isoformat()
    upd["updated_by"] = user["id"]
    await db.settings.update_one({"key": "whatsapp_config"}, {"$set": upd}, upsert=True)
    return await _get_whatsapp_config(secret=False)


@app.on_event("startup")
async def seed_data():
    try:
        await db.users.create_index([("phone", 1), ("role", 1)])
        await db.restaurants.create_index("id", unique=True)
        await db.menu_items.create_index("id", unique=True)
        await db.orders.create_index("id", unique=True)
    except Exception:
        pass

    DEMO_OWNER_RESTAURANT = "Truffles"  # the only restaurant the demo owner (8888888888) manages

    async def ensure_owner(phone: str, name: str) -> str:
        u = await db.users.find_one({"phone": phone, "role": "restaurant_owner"})
        if not u:
            u = {
                "id": str(uuid.uuid4()),
                "phone": phone,
                "name": name,
                "role": "restaurant_owner",
                "created_at": datetime.now(timezone.utc).isoformat(),
            }
            await db.users.insert_one(dict(u))
        return u["id"]

    # Seed the demo owner — manages ONLY the demo restaurant (Truffles)
    owner = await db.users.find_one({"phone": "8888888888", "role": "restaurant_owner"})
    if not owner:
        owner = {
            "id": str(uuid.uuid4()),
            "phone": "8888888888",
            "name": "Demo Owner",
            "role": "restaurant_owner",
            "created_at": datetime.now(timezone.utc).isoformat(),
        }
        await db.users.insert_one(dict(owner))
    owner_id = owner["id"]

    # Seed a demo rider
    if not await db.users.find_one({"phone": "7777777777", "role": "rider"}):
        await db.users.insert_one({
            "id": str(uuid.uuid4()),
            "phone": "7777777777",
            "name": "Demo Rider",
            "role": "rider",
            "created_at": datetime.now(timezone.utc).isoformat(),
        })

    if await db.restaurants.count_documents({}) == 0:
        for idx, r in enumerate(SEED_RESTAURANTS):
            # Each restaurant gets its own dedicated owner. Truffles -> demo owner.
            if r["name"] == DEMO_OWNER_RESTAURANT:
                r_owner_id = owner_id
            else:
                r_owner_id = await ensure_owner(f"900000{idx:04d}", f"{r['name']} Owner")
            doc = {
                "id": str(uuid.uuid4()),
                "status": "active",
                "is_promoted": r.get("is_promoted", False),
                "offer_text": r.get("offer_text"),
                "owner_id": r_owner_id,
                **{k: v for k, v in r.items() if k not in {"is_promoted", "offer_text"}},
            }
            await db.restaurants.insert_one(dict(doc))
            menu = SEED_MENUS.get(r["name"], [])
            for (name, desc, price, cat, veg, img) in menu:
                item = {
                    "id": str(uuid.uuid4()),
                    "restaurant_id": doc["id"],
                    "name": name, "description": desc, "price": price,
                    "image": img, "category": cat, "veg": veg,
                    # Seed rating is cosmetic (a placeholder star value), NOT a
                    # security primitive — safe to use `random` here rather
                    # than `secrets`. Real ratings come from customer reviews.
                    "available": True, "rating": 4.2 + random.random() * 0.6,  # noqa: S311
                }
                await db.menu_items.insert_one(dict(item))

    # Enforce per-restaurant ownership so an owner only ever sees their own restaurant(s).
    # Demo owner (8888888888) manages ONLY Truffles; every other restaurant gets a
    # dedicated owner account. Idempotent: once corrected, subsequent runs are no-ops.
    all_rests = await db.restaurants.find({}, {"_id": 0, "id": 1, "name": 1, "owner_id": 1}).to_list(1000)
    for idx, r in enumerate(all_rests):
        if r["name"] == DEMO_OWNER_RESTAURANT:
            if r.get("owner_id") != owner_id:
                await db.restaurants.update_one({"id": r["id"]}, {"$set": {"owner_id": owner_id}})
            continue
        # Non-demo restaurant with no owner or wrongly assigned to the shared demo owner
        if (not r.get("owner_id")) or r.get("owner_id") == owner_id:
            r_owner_id = await ensure_owner(f"900000{idx:04d}", f"{r['name']} Owner")
            await db.restaurants.update_one({"id": r["id"]}, {"$set": {"owner_id": r_owner_id}})

    # Ensure availability fields exist on all restaurants (online by default + default weekly hours).
    _default_hours = [{"day": d, "open": "09:00", "close": "23:00", "closed": False} for d in _DAY_KEYS]
    await db.restaurants.update_many({"is_open": {"$exists": False}}, {"$set": {"is_open": True}})
    async for r in db.restaurants.find({}, {"_id": 0, "id": 1, "operating_hours": 1}):
        if not r.get("operating_hours"):
            await db.restaurants.update_one({"id": r["id"]}, {"$set": {"operating_hours": _default_hours}})

    if await db.coupons.count_documents({}) == 0:
        for c in SEED_COUPONS:
            await db.coupons.insert_one(dict(c))

    # Seed default ADMIN offers (owner can apply these to their restaurant)
    if await db.offers.count_documents({}) == 0:
        seed_offers = [
            {"title": "60% OFF up to \u20b9120", "code": "WELCOME60", "type": "percent", "value": 60, "max_discount": 120, "min_order": 199, "description": "Get 60% off on orders above \u20b9199 (max \u20b9120)"},
            {"title": "Flat \u20b9100 OFF", "code": "FLAT100", "type": "flat", "value": 100, "max_discount": None, "min_order": 499, "description": "Flat \u20b9100 off on orders above \u20b9499"},
            {"title": "50% OFF up to \u20b9100", "code": "SAVE50", "type": "percent", "value": 50, "max_discount": 100, "min_order": 149, "description": "50% off on orders above \u20b9149 (max \u20b9100)"},
            {"title": "20% OFF", "code": "GET20", "type": "percent", "value": 20, "max_discount": 80, "min_order": 0, "description": "Flat 20% off (max \u20b980)"},
        ]
        for o in seed_offers:
            await db.offers.insert_one({"id": str(uuid.uuid4()), "active": True, "created_at": datetime.now(timezone.utc).isoformat(), **o})

    # Helpful indexes for new feature collections
    try:
        await db.offers.create_index("active")
        await db.complaints.create_index("restaurant_id")
        await db.complaints.create_index("customer_id")
        await db.complaints.create_index("status")
        await db.categories.create_index("parent_id")
    except Exception:
        pass

    # Seed an admin demo account
    if not await db.users.find_one({"phone": "9999999999", "role": "admin"}):
        await db.users.insert_one({
            "id": str(uuid.uuid4()),
            "phone": "9999999999",
            "name": "Admin",
            "role": "admin",
            "created_at": datetime.now(timezone.utc).isoformat(),
        })

    # Seed the REAL admin (logs in via real SMS OTP through Message Central).
    if not await db.users.find_one({"phone": "8447816991", "role": "admin"}):
        # If this phone already exists with a different role, promote it to admin.
        existing = await db.users.find_one({"phone": "8447816991"})
        if existing:
            await db.users.update_one({"phone": "8447816991"}, {"$set": {"role": "admin"}})
        else:
            await db.users.insert_one({
                "id": str(uuid.uuid4()),
                "phone": "8447816991",
                "name": "Admin",
                "role": "admin",
                "created_at": datetime.now(timezone.utc).isoformat(),
            })

    # Seed the hidden TEST user (fixed OTP 989898, no SMS — for app review/testing).
    if not await db.users.find_one({"phone": "8929926078"}):
        await db.users.insert_one({
            "id": str(uuid.uuid4()),
            "phone": "8929926078",
            "name": "Test User",
            "role": "customer",
            "created_at": datetime.now(timezone.utc).isoformat(),
        })
    # Seed policy defaults (legal content, cancellation rules, cod rules)
    try:
        from policy_ext import seed_policy_defaults
        await seed_policy_defaults(db)
    except Exception as e:
        log.warning("policy defaults seed failed: %s", e)
    log.info("Seed complete")


