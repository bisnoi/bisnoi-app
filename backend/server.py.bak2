# ---------------------------------------------------------------------------
# Activity Log middleware
# ---------------------------------------------------------------------------
# Every mutating (POST/PATCH/PUT/DELETE) API request against `/api/*` is
# automatically persisted to the `activity_logs` collection so admins can trace
# who did what across the platform (customers, riders, owners, staff, admins).
# Read-only GET is intentionally excluded to keep the collection small.
# Sensitive paths (OTP body, tokens) are redacted via `_SENSITIVE_KEYS`.
_SENSITIVE_KEYS = {"password", "otp", "code", "token", "authorization", "idToken", "id_token", "secret"}
_LOGGABLE_METHODS = {"POST", "PATCH", "PUT", "DELETE"}
# Skip logging for these high-volume, low-value endpoints (would flood the log).
_SKIP_LOG_PATHS = (
    "/api/rider/heartbeat",
    "/api/auth/send-otp",  # OTP itself is short-lived; verify is what matters.
    "/api/push/subscribe",
    "/api/push/unsubscribe",
    "/api/notif/mark-read",
)


def _redact_body(body_dict):
    """Return a copy of `body_dict` with sensitive keys redacted."""
    if not isinstance(body_dict, dict):
        return body_dict
    out = {}
    for k, v in body_dict.items():
        if k.lower() in _SENSITIVE_KEYS:
            out[k] = "***"
        elif isinstance(v, dict):
            out[k] = _redact_body(v)
        else:
            out[k] = v
    return out


@app.middleware("http")
async def audit_activity(request, call_next):
    """Persist an activity log entry for every mutating /api/* request.

    Logs metadata (actor, method, path, status) but NOT the raw body — reading
    the body in ASGI middleware breaks the receive() chain (Starlette will
    re-await for disconnect events). Body-level diffs can be added per-endpoint
    where truly needed; metadata is enough for a full audit trail of who did
    what and when.
    """
    path = request.url.path or ""
    method = (request.method or "GET").upper()
    if method not in _LOGGABLE_METHODS or not path.startswith("/api/"):
        return await call_next(request)
    if any(path.startswith(p) for p in _SKIP_LOG_PATHS):
        return await call_next(request)

    response = await call_next(request)

    try:
        # Extract actor from Authorization header (best-effort; may be anonymous)
        actor = {"id": None, "name": "Anonymous", "role": "guest", "phone": None}
        auth_hdr = request.headers.get("authorization") or request.headers.get("Authorization")
        if auth_hdr and auth_hdr.lower().startswith("bearer "):
            try:
                data = jwt.decode(auth_hdr.split(" ", 1)[1], JWT_SECRET, algorithms=[JWT_ALGO])
                u = await db.users.find_one({"id": data.get("sub")}, {"_id": 0, "id": 1, "name": 1, "role": 1, "phone": 1})
                if u:
                    actor = {"id": u.get("id"), "name": u.get("name") or "Unnamed", "role": u.get("role") or "unknown", "phone": u.get("phone")}
            except Exception:  # noqa: BLE001
                pass

        # Human-friendly action label from path + method
        segs = [s for s in path.split("/") if s and s != "api"]
        action_label = f"{method} " + "/".join(segs)

        log_doc = {
            "id": str(uuid.uuid4()),
            "ts": datetime.now(timezone.utc).isoformat(),
            "actor_id": actor["id"],
            "actor_name": actor["name"],
            "actor_role": actor["role"],
            "actor_phone": actor["phone"],
            "method": method,
            "path": path,
            "action": action_label,
            "status": getattr(response, "status_code", None),
            "ip": request.client.host if request.client else None,
            "ua": request.headers.get("user-agent", "")[:200],
        }
        # Fire-and-forget so we never block the response.
        asyncio.create_task(db.activity_logs.insert_one(log_doc))
    except Exception:  # noqa: BLE001
        # Never break the request path for audit issues.
        pass

    return response

app.add_middleware(
    CORSMiddleware,
    allow_credentials=True,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

# Wrap the FastAPI app with the Socket.IO ASGI app. `app` stays the uvicorn entrypoint
# (server:app); FastAPI routes + lifecycle events still run via other_asgi_app.
fastapi_app = app
app = socketio.ASGIApp(sio, other_asgi_app=fastapi_app, socketio_path="/api/socket.io")
