@api.get("/owner/pos/stats")
async def owner_pos_stats(user: dict = Depends(require_role("restaurant_owner"))):
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0, "id": 1}).to_list(50)
    rids = [r["id"] for r in rests]
    bills = await db.pos_orders.find({"restaurant_id": {"$in": rids}}, {"_id": 0}).to_list(5000) if rids else []
    today = datetime.now(timezone.utc).isoformat()[:10]
    today_bills = [b for b in bills if b.get("created_at", "")[:10] == today]
    return {
        "total_bills": len(bills),
        "total_sales": _round2(sum(b.get("total", 0) for b in bills)),
        "today_bills": len(today_bills),
        "today_sales": _round2(sum(b.get("total", 0) for b in today_bills)),
    }

# ----------------------------- Dine-in: Tables + KOT + Settle -----------------------------
@api.get("/restaurants/nearby")
async def restaurants_nearby(lat: float, lng: float, radius_km: float = 0.15):
    """GPS auto-match: which restaurant is the customer physically sitting at."""
    rests = await db.restaurants.find(
        {"is_active": True, "status": "active"},
        {"_id": 0, "id": 1, "name": 1, "image": 1, "lat": 1, "lng": 1,
         "cuisines": 1, "address": 1, "is_open": 1},
    ).to_list(5000)
    matches = []
    for r in rests:
        rlat, rlng = r.get("lat"), r.get("lng")
        if rlat is None or rlng is None:
            continue
        d = haversine_km(float(lat), float(lng), float(rlat), float(rlng))
        if d <= radius_km:
            r["distance_km"] = round(d, 3)
            matches.append(r)
    matches.sort(key=lambda x: x["distance_km"])
    return matches


class TableCreate(BaseModel):
    label: Optional[str] = None
    restaurant_id: Optional[str] = None


class TableSetCount(BaseModel):
    count: int
    restaurant_id: Optional[str] = None


class KotItemInput(BaseModel):
    menu_item_id: Optional[str] = None
    name: str
    price: float
    qty: int
    veg: Optional[bool] = None


class KotCreate(BaseModel):
    items: Optional[List[KotItemInput]] = None  # falls back to the session draft items
    customer_name: Optional[str] = None
    customer_phone: Optional[str] = None
    customer_address: Optional[str] = None
    customer_city: Optional[str] = None
    note: Optional[str] = None


class DraftUpdate(BaseModel):
    items: List[KotItemInput] = []
    customer_name: Optional[str] = None
    customer_phone: Optional[str] = None
    customer_address: Optional[str] = None
    customer_city: Optional[str] = None


class SettlePayment(BaseModel):
    method: Literal["cash", "upi", "card"]
    amount: float = 0


class KotStatusUpdate(BaseModel):
    status: Literal["preparing", "ready"]


class TableSettle(BaseModel):
    discount_type: Optional[Literal["flat", "percent"]] = None
    discount_value: float = 0
    tax_enabled: bool = False
    tax_percent: float = 0
    payment_method: Literal["cash", "upi", "card"] = "cash"
    payments: Optional[List[SettlePayment]] = None  # split / partial payment
    customer_name: Optional[str] = None
    customer_phone: Optional[str] = None
    customer_address: Optional[str] = None
    customer_city: Optional[str] = None
    note: Optional[str] = None


class EbillRequest(BaseModel):
    discount_type: Optional[Literal["flat", "percent"]] = None
    discount_value: float = 0
    tax_enabled: bool = False
    tax_percent: float = 0
    customer_name: Optional[str] = None
    customer_phone: Optional[str] = None
    customer_address: Optional[str] = None
    customer_city: Optional[str] = None
    note: Optional[str] = None


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


async def _owner_rest(user: dict, restaurant_id: Optional[str] = None) -> dict:
    if restaurant_id:
        rest = await db.restaurants.find_one({"id": restaurant_id, "owner_id": user["id"]}, {"_id": 0})
    else:
        rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant found for your account")
    return rest


async def _next_seq(key: str) -> int:
    doc = await db.counters.find_one_and_update(
        {"key": key}, {"$inc": {"seq": 1}}, upsert=True, return_document=ReturnDocument.AFTER
    )
    return int(doc["seq"])


def _merge_kot_items(kots: list) -> list:
    """Merge all (non-void) KOT line items into a single billable item list."""
    merged: dict = {}
    order: list = []
    for k in kots or []:
        if k.get("status") == "void":
            continue
        for it in k.get("items", []):
            key = f"{it.get('menu_item_id') or it.get('name')}|{it.get('price')}"
            if key not in merged:
                merged[key] = {
                    "menu_item_id": it.get("menu_item_id"),
                    "name": it.get("name"),
                    "price": _round2(it.get("price", 0)),
                    "qty": 0,
                }
                order.append(key)
            merged[key]["qty"] += int(it.get("qty", 0))
    return [merged[k] for k in order if merged[k]["qty"] > 0]


def _merge_item_lists(*lists) -> list:
    """Merge several item lists (KOT items + draft items) into one billable list."""
    merged: dict = {}
    order: list = []
    for lst in lists:
        for it in lst or []:
            qty = int(it.get("qty", 0))
            if qty <= 0:
                continue
            key = f"{it.get('menu_item_id') or it.get('name')}|{_round2(it.get('price', 0))}"
            if key not in merged:
                merged[key] = {
                    "menu_item_id": it.get("menu_item_id"),
                    "name": it.get("name"),
                    "price": _round2(it.get("price", 0)),
                    "qty": 0,
                }
                order.append(key)
            merged[key]["qty"] += qty
    return [merged[k] for k in order if merged[k]["qty"] > 0]


def _session_bill_items(s: dict) -> list:
    """Combined billable items = sent KOT items + not-yet-sent draft items."""
    return _merge_item_lists(_merge_kot_items(s.get("kots", [])), s.get("draft_items", []))


def _valid_phone(p: Optional[str]) -> bool:
    d = "".join(ch for ch in (p or "") if ch.isdigit())
    return len(d) >= 10


def _session_summary(s: dict) -> dict:
    bill_items = _session_bill_items(s)
    item_count = sum(i["qty"] for i in bill_items)
    running_total = _round2(sum(i["price"] * i["qty"] for i in bill_items))
    pending = [k for k in s.get("kots", []) if k.get("status") in ("sent", "preparing")]
    draft_count = sum(int(i.get("qty", 0)) for i in s.get("draft_items", []))
    return {
        "session_id": s["id"],
        "kot_count": len(s.get("kots", [])),
        "item_count": item_count,
        "running_total": running_total,
        "pending_kots": len(pending),
        "draft_count": draft_count,
        "opened_at": s.get("opened_at"),
        "customer_name": s.get("customer_name"),
    }


async def _tables_payload(rest: dict) -> list:
    tables = await db.dine_tables.find({"restaurant_id": rest["id"]}, {"_id": 0}).sort("sort_order", 1).to_list(200)
    sessions = await db.table_sessions.find(
        {"restaurant_id": rest["id"], "status": "running"}, {"_id": 0}
    ).to_list(500)
    by_table = {s["table_id"]: s for s in sessions}
    out = []
    for t in tables:
        s = by_table.get(t["id"])
        out.append({
            "id": t["id"],
            "label": t["label"],
            "sort_order": t.get("sort_order", 0),
            "status": "occupied" if s else "free",
            "session": _session_summary(s) if s else None,
        })
    return out


@api.get("/owner/tables")
async def owner_list_tables(restaurant_id: Optional[str] = None, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await _owner_rest(user, restaurant_id)
    return await _tables_payload(rest)


@api.post("/owner/tables")
async def owner_create_table(body: TableCreate, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await _owner_rest(user, body.restaurant_id)
    count = await db.dine_tables.count_documents({"restaurant_id": rest["id"]})
    label = (body.label or f"Table {count + 1}").strip() or f"Table {count + 1}"
    t = {
        "id": str(uuid.uuid4()),
        "restaurant_id": rest["id"],
        "label": label,
        "sort_order": count + 1,
        "created_at": _now_iso(),
        "qr_token": secrets.token_urlsafe(16),
    }
    await db.dine_tables.insert_one(dict(t))
    return await _tables_payload(rest)


@api.post("/owner/tables/set-count")
async def owner_set_table_count(body: TableSetCount, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await _owner_rest(user, body.restaurant_id)
    count = max(0, min(int(body.count), 100))
    existing = await db.dine_tables.find({"restaurant_id": rest["id"]}, {"_id": 0}).sort("sort_order", 1).to_list(500)
    cur = len(existing)
    if count > cur:
        for i in range(cur, count):
            t = {
                "id": str(uuid.uuid4()),
                "restaurant_id": rest["id"],
                "label": f"Table {i + 1}",
                "sort_order": i + 1,
                "created_at": _now_iso(),
                "qr_token": secrets.token_urlsafe(16),
            }
            await db.dine_tables.insert_one(dict(t))
    elif count < cur:
        # Remove trailing tables, but never an occupied one
        for t in existing[count:]:
            running = await db.table_sessions.find_one({"table_id": t["id"], "status": "running"}, {"_id": 0})
            if not running:
                await db.dine_tables.delete_one({"id": t["id"]})
    return await _tables_payload(rest)


@api.delete("/owner/tables/{tid}")
async def owner_delete_table(tid: str, user: dict = Depends(require_role("restaurant_owner"))):
    t = await db.dine_tables.find_one({"id": tid}, {"_id": 0})
    if not t:
        raise HTTPException(404, "Table not found")
    rest = await db.restaurants.find_one({"id": t["restaurant_id"], "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(403, "Forbidden")
    running = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    if running:
        raise HTTPException(400, "Table is occupied — settle or cancel the bill first")
    await db.dine_tables.delete_one({"id": tid})
    return await _tables_payload(rest)


async def _get_owner_table(tid: str, user: dict):
    t = await db.dine_tables.find_one({"id": tid}, {"_id": 0})
    if not t:
        raise HTTPException(404, "Table not found")
    rest = await db.restaurants.find_one({"id": t["restaurant_id"], "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(403, "Forbidden")
    return t, rest


@api.get("/owner/tables/{tid}/session")
async def owner_get_table_session(tid: str, user: dict = Depends(require_role("restaurant_owner"))):
    t, rest = await _get_owner_table(tid, user)
    s = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    if not s:
        return {
            "table": {"id": t["id"], "label": t["label"]},
            "session": None, "merged_items": [], "kot_items": [], "draft_items": [], "subtotal": 0,
        }
    kot_items = _merge_kot_items(s.get("kots", []))
    draft_items = s.get("draft_items", [])
    bill_items = _merge_item_lists(kot_items, draft_items)
    subtotal = _round2(sum(i["price"] * i["qty"] for i in bill_items))
    return {
        "table": {"id": t["id"], "label": t["label"]},
        "session": s,
        "kot_items": kot_items,
        "draft_items": draft_items,
        "merged_items": bill_items,
        "subtotal": subtotal,
    }


def _clean_items(items) -> list:
    out = []
    for it in items or []:
        qty = int(getattr(it, "qty", 0) or 0)
        if qty <= 0:
            continue
        out.append({
            "menu_item_id": it.menu_item_id,
            "name": it.name,
            "price": _round2(it.price),
            "qty": qty,
            "veg": getattr(it, "veg", None),
        })
    return out


async def _upsert_session(tid: str, t: dict, rest: dict, user: dict, customer: dict) -> dict:
    """Get or create a running session, applying any provided customer fields."""
    s = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    cust_set = {k: v for k, v in customer.items() if v}
    if not s:
        s = {
            "id": str(uuid.uuid4()),
            "restaurant_id": rest["id"],
            "owner_id": user["id"],
            "table_id": tid,
            "table_label": t["label"],
            "status": "running",
            "kots": [],
            "draft_items": [],
            "opened_at": _now_iso(),
            "settled_at": None,
            "bill_id": None,
            "customer_name": customer.get("customer_name"),
            "customer_phone": customer.get("customer_phone"),
            "customer_address": customer.get("customer_address"),
            "customer_city": customer.get("customer_city"),
        }
        await db.table_sessions.insert_one(dict(s))
    elif cust_set:
        await db.table_sessions.update_one({"id": s["id"]}, {"$set": cust_set})
        s.update(cust_set)
    return s


@api.post("/owner/tables/{tid}/draft")
async def owner_save_draft(tid: str, body: DraftUpdate, user: dict = Depends(require_role("restaurant_owner"))):
    """Add/replace the not-yet-sent items on a table + persist customer info."""
    t, rest = await _get_owner_table(tid, user)
    customer = {
        "customer_name": body.customer_name, "customer_phone": body.customer_phone,
        "customer_address": body.customer_address, "customer_city": body.customer_city,
    }
    s = await _upsert_session(tid, t, rest, user, customer)
    draft = _clean_items(body.items)
    await db.table_sessions.update_one({"id": s["id"]}, {"$set": {"draft_items": draft}})
    s = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    kot_items = _merge_kot_items(s.get("kots", []))
    bill_items = _merge_item_lists(kot_items, s.get("draft_items", []))
    return {
        "table": {"id": t["id"], "label": t["label"]},
        "session": s,
        "kot_items": kot_items,
        "draft_items": s.get("draft_items", []),
        "merged_items": bill_items,
        "subtotal": _round2(sum(i["price"] * i["qty"] for i in bill_items)),
    }


@api.post("/owner/tables/{tid}/kot")
async def owner_send_kot(tid: str, body: KotCreate, user: dict = Depends(require_role("restaurant_owner"))):
    t, rest = await _get_owner_table(tid, user)
    customer = {
        "customer_name": body.customer_name, "customer_phone": body.customer_phone,
        "customer_address": body.customer_address, "customer_city": body.customer_city,
    }
    s = await _upsert_session(tid, t, rest, user, customer)
    # Items: use the explicit list if provided, else the session's draft items.
    if body.items is not None:
        items = _clean_items(body.items)
    else:
        items = [
            {"menu_item_id": i.get("menu_item_id"), "name": i.get("name"),
             "price": _round2(i.get("price", 0)), "qty": int(i.get("qty", 0)), "veg": i.get("veg")}
            for i in s.get("draft_items", []) if int(i.get("qty", 0)) > 0
        ]
    if not items:
        raise HTTPException(400, "Add at least one item to send to the kitchen")
    seq = await _next_seq(f"kot:{rest['id']}")
    kot = {
        "id": str(uuid.uuid4()),
        "kot_number": f"KOT-{seq:05d}",
        "items": items,
        "status": "sent",
        "created_at": _now_iso(),
        "ready_at": None,
    }
    # Append the KOT and clear the draft (those items are now sent to the kitchen).
    await db.table_sessions.update_one(
        {"id": s["id"]}, {"$push": {"kots": kot}, "$set": {"draft_items": []}}
    )
    return {
        "kot": kot,
        "restaurant_name": rest.get("name"),
        "table_label": t["label"],
        "item_count": sum(i["qty"] for i in items),
        "created_at": kot["created_at"],
    }


def _apply_settlement(total: float, payments: list):
    """Split/partial payment: any unpaid remainder auto-becomes a discount."""
    clean = [{"method": p["method"], "amount": _round2(max(0, p.get("amount", 0)))} for p in payments if p.get("amount", 0) > 0]
    collected = _round2(sum(p["amount"] for p in clean))
    settlement_discount = _round2(max(0.0, total - collected))
    change = _round2(max(0.0, collected - total))
    final_total = _round2(total - settlement_discount)
    # dominant method (for the legacy single payment_method field)
    dominant = "cash"
    if clean:
        dominant = max(clean, key=lambda p: p["amount"])["method"]
    return clean, collected, settlement_discount, change, final_total, dominant


@api.post("/owner/tables/{tid}/ebill")
async def owner_ebill_table(tid: str, body: EbillRequest, user: dict = Depends(require_role("restaurant_owner"))):
    """Generate the current bill and send it to the customer on WhatsApp.
    Does NOT settle — the table stays open."""
    t, rest = await _get_owner_table(tid, user)
    s = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    if not s:
        raise HTTPException(400, "No running order at this table")
    name = (body.customer_name or s.get("customer_name") or "").strip()
    phone = (body.customer_phone or s.get("customer_phone") or "").strip()
    if not name:
        raise HTTPException(400, "Customer name is required")
    if not _valid_phone(phone):
        raise HTTPException(400, "A valid 10-digit customer phone is required")
    bill_items = _session_bill_items(s)
    if not bill_items:
        raise HTTPException(400, "Nothing to bill — add items first")
    # persist customer info
    await db.table_sessions.update_one({"id": s["id"]}, {"$set": {
        "customer_name": name, "customer_phone": phone,
        "customer_address": body.customer_address or s.get("customer_address"),
        "customer_city": body.customer_city or s.get("customer_city"),
    }})
    pos_body = PosOrderCreate(
        restaurant_id=rest["id"], order_type="dine_in",
        items=[PosItemInput(menu_item_id=i.get("menu_item_id"), name=i["name"], price=i["price"], qty=i["qty"]) for i in bill_items],
        discount_type=body.discount_type, discount_value=body.discount_value,
        tax_enabled=body.tax_enabled, tax_percent=body.tax_percent,
        payment_method="cash", customer_name=name, customer_phone=phone,
        note=body.note or f"Dine-in • {t['label']}",
    )
    doc = await _build_pos_bill(rest, user["id"], pos_body)
    doc["bill_number"] = f"EBILL-{doc['bill_number'].split('-')[-1]}"
    doc["table_label"] = t["label"]
    doc["customer_address"] = body.customer_address or s.get("customer_address")
    doc["customer_city"] = body.customer_city or s.get("customer_city")
    doc["dine_in"] = True
    doc["is_ebill"] = True
    doc.pop("_id", None)
    wa = await send_whatsapp_bill(phone, doc, await _get_whatsapp_config(secret=True))
    doc["whatsapp"] = wa
    return doc


@api.post("/owner/tables/{tid}/settle")
async def owner_settle_table(tid: str, body: TableSettle, user: dict = Depends(require_role("restaurant_owner"))):
    t, rest = await _get_owner_table(tid, user)
    s = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    if not s:
        raise HTTPException(400, "No running order at this table")
    bill_items = _session_bill_items(s)
    if not bill_items:
        raise HTTPException(400, "Nothing to bill — add items first")
    name = (body.customer_name or s.get("customer_name") or "").strip()
    phone = (body.customer_phone or s.get("customer_phone") or "").strip()
    if not name:
        raise HTTPException(400, "Customer name is required")
    if not _valid_phone(phone):
        raise HTTPException(400, "A valid 10-digit customer phone is required")

    payments = [p.dict() for p in (body.payments or [])]
    payment_method = body.payment_method
    if payments:
        payment_method = max(
            [{"method": p["method"], "amount": _round2(max(0, p.get("amount", 0)))} for p in payments] or [{"method": "cash", "amount": 0}],
            key=lambda p: p["amount"],
        )["method"]

    pos_body = PosOrderCreate(
        restaurant_id=rest["id"], order_type="dine_in",
        items=[PosItemInput(menu_item_id=i.get("menu_item_id"), name=i["name"], price=i["price"], qty=i["qty"]) for i in bill_items],
        discount_type=body.discount_type, discount_value=body.discount_value,
        tax_enabled=body.tax_enabled, tax_percent=body.tax_percent,
        payment_method=payment_method, customer_name=name, customer_phone=phone,
        note=body.note or f"Dine-in • {t['label']}",
    )
    doc = await _build_pos_bill(rest, user["id"], pos_body)

    # Partial / split payment: unpaid remainder auto-becomes a discount.
    if payments:
        base_total = doc["total"]
        clean, collected, settlement_discount, change, final_total, dominant = _apply_settlement(base_total, payments)
        doc["payments"] = clean
        doc["amount_collected"] = collected
        doc["change"] = change
        doc["is_split"] = len(clean) > 1
        if settlement_discount > 0:
            doc["settlement_discount"] = settlement_discount
            doc["discount_amount"] = _round2(doc.get("discount_amount", 0) + settlement_discount)
            doc["total"] = final_total

    doc["table_label"] = t["label"]
    doc["table_id"] = tid
    doc["customer_address"] = body.customer_address or s.get("customer_address")
    doc["customer_city"] = body.customer_city or s.get("customer_city")
    doc["dine_in"] = True
    doc["session_id"] = s["id"]
    await db.pos_orders.insert_one(dict(doc))
    doc.pop("_id", None)
    await db.table_sessions.update_one(
        {"id": s["id"]},
        {"$set": {"status": "settled", "settled_at": _now_iso(), "bill_id": doc["id"]}},
    )
    wa = await send_whatsapp_bill(phone, doc, await _get_whatsapp_config(secret=True))
    doc["whatsapp"] = wa
    return doc


@api.post("/owner/tables/{tid}/cancel")
async def owner_cancel_table(tid: str, user: dict = Depends(require_role("restaurant_owner"))):
    t, rest = await _get_owner_table(tid, user)
    s = await db.table_sessions.find_one({"table_id": tid, "status": "running"}, {"_id": 0})
    if not s:
        raise HTTPException(400, "No running order at this table")
    await db.table_sessions.update_one({"id": s["id"]}, {"$set": {"status": "cancelled", "settled_at": _now_iso()}})
    return {"ok": True}


# ----------------------------- Kitchen (KDS): pending KOTs -----------------------------
@api.get("/owner/kitchen/kots")
async def owner_kitchen_kots(restaurant_id: Optional[str] = None, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await _owner_rest(user, restaurant_id)
    sessions = await db.table_sessions.find(
        {"restaurant_id": rest["id"], "status": "running"}, {"_id": 0}
    ).to_list(500)
    out = []
    for s in sessions:
        for k in s.get("kots", []):
            if k.get("status") in ("sent", "preparing"):
                out.append({
                    "session_id": s["id"],
                    "table_id": s["table_id"],
                    "table_label": s.get("table_label"),
                    "kot_id": k["id"],
                    "kot_number": k["kot_number"],
                    "items": k.get("items", []),
                    "status": k.get("status"),
                    "created_at": k.get("created_at"),
                })
    out.sort(key=lambda x: x.get("created_at") or "")
    return out


@api.patch("/owner/kitchen/kots/{kot_id}")
async def owner_update_kot_status(kot_id: str, body: KotStatusUpdate, user: dict = Depends(require_role("restaurant_owner"))):
    s = await db.table_sessions.find_one({"kots.id": kot_id}, {"_id": 0})
    if not s:
        raise HTTPException(404, "KOT not found")
    rest = await db.restaurants.find_one({"id": s["restaurant_id"], "owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(403, "Forbidden")
    set_fields = {"kots.$.status": body.status}
    if body.status == "ready":
        set_fields["kots.$.ready_at"] = _now_iso()
    await db.table_sessions.update_one({"kots.id": kot_id}, {"$set": set_fields})
    return {"ok": True, "status": body.status}




@api.get("/admin/pos/orders")
async def admin_list_pos(restaurant_id: Optional[str] = None, user: dict = Depends(require_role("admin"))):
    q: dict = {}
    if restaurant_id:
        q["restaurant_id"] = restaurant_id
    return await db.pos_orders.find(q, {"_id": 0}).sort("created_at", -1).to_list(5000)


@api.get("/admin/pos/stats")
async def admin_pos_stats(user: dict = Depends(require_role("admin"))):
    bills = await db.pos_orders.find({}, {"_id": 0}).to_list(20000)
    today = datetime.now(timezone.utc).isoformat()[:10]
    by_rest: dict = {}
    for b in bills:
        key = b.get("restaurant_id")
        if key not in by_rest:
            by_rest[key] = {"restaurant_id": key, "restaurant_name": b.get("restaurant_name") or "Restaurant", "bills": 0, "sales": 0.0}
        by_rest[key]["bills"] += 1
        by_rest[key]["sales"] = _round2(by_rest[key]["sales"] + b.get("total", 0))
    return {
        "total_bills": len(bills),
        "total_sales": _round2(sum(b.get("total", 0) for b in bills)),
        "today_bills": sum(1 for b in bills if b.get("created_at", "")[:10] == today),
        "today_sales": _round2(sum(b.get("total", 0) for b in bills if b.get("created_at", "")[:10] == today)),
        "by_restaurant": sorted(by_rest.values(), key=lambda x: -x["sales"]),
    }


# ----------------------------- Admin -----------------------------
@api.get("/admin/stats")
async def admin_stats(user: dict = Depends(require_role("admin"))):
    users_count = await db.users.count_documents({})
    rests_count = await db.restaurants.count_documents({})
    # Exclude orders still awaiting online payment (failed/cancelled Razorpay)
    # so they never inflate order counts or revenue stats.
    orders = await db.orders.find({"awaiting_payment": {"$ne": True}}, {"_id": 0}).to_list(2000)
    delivery_revenue = sum(o["total"] for o in orders if o["status"] == "delivered")
    pos_bills = await db.pos_orders.find({}, {"_id": 0, "total": 1}).to_list(10000)
    pos_revenue = sum(b.get("total", 0) for b in pos_bills)
    return {
        "users": users_count,
        "restaurants": rests_count,
        "orders": len(orders),
        "revenue": round(delivery_revenue + pos_revenue, 2),
        "delivery_revenue": round(delivery_revenue, 2),
        "pos_revenue": round(pos_revenue, 2),
        "pos_bills": len(pos_bills),
        "active_orders": sum(1 for o in orders if o["status"] not in ["delivered", "cancelled"]),
        "riders": await db.users.count_documents({"role": "rider"}),
    }


def _parse_dt(s):
    try:
        return datetime.fromisoformat((s or "").replace("Z", "+00:00"))
    except Exception:
        return None


def _pct_delta(cur, prev):
    if prev:
        return round(((cur - prev) / prev) * 100, 2)
    return 100.0 if cur else 0.0


def _rel_time(dt):
    if not dt:
        return ""
    now = datetime.now(timezone.utc)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    secs = (now - dt).total_seconds()
    if secs < 60:
        return "just now"
    if secs < 3600:
        return f"{int(secs // 60)}m ago"
    if secs < 86400:
        return f"{int(secs // 3600)}h ago"
    return f"{int(secs // 86400)}d ago"


def _compute_dashboard_payload(now, orders, pos, menu_items, rests, recent_reviews, cust_total, cust_cur, cust_prev):
    """Pure aggregation shared by the admin (global) and owner (scoped) dashboards."""
    rest_img = {r["id"]: r.get("image") for r in rests}
    rest_name = {r["id"]: r.get("name") for r in rests}
    mi_by_id = {m["id"]: m for m in menu_items}

    def in_month(dt, y, m):
        return dt and dt.year == y and dt.month == m
    ly, lm = (now.year, now.month - 1) if now.month > 1 else (now.year - 1, 12)

    order_dts = [(_parse_dt(o.get("placed_at")), o) for o in orders]
    pos_dts = [(_parse_dt(p.get("created_at")), p) for p in pos]
    total_orders = len(orders) + len(pos)
    ord_cur = sum(1 for d, _ in order_dts if in_month(d, now.year, now.month)) + sum(1 for d, _ in pos_dts if in_month(d, now.year, now.month))
    ord_prev = sum(1 for d, _ in order_dts if in_month(d, ly, lm)) + sum(1 for d, _ in pos_dts if in_month(d, ly, lm))

    delivered_rev = sum(o.get("total", 0) for o in orders if o.get("status") == "delivered")
    pos_rev = sum(p.get("total", 0) for p in pos)
    total_revenue = round(delivered_rev + pos_rev, 2)
    rev_cur = sum(o.get("total", 0) for d, o in order_dts if in_month(d, now.year, now.month)) + sum(p.get("total", 0) for d, p in pos_dts if in_month(d, now.year, now.month))
    rev_prev = sum(o.get("total", 0) for d, o in order_dts if in_month(d, ly, lm)) + sum(p.get("total", 0) for d, p in pos_dts if in_month(d, ly, lm))

    # ---------- Delivered / Cancelled counts (app orders + POS bills count as fulfilled) ----------
    delivered_total = sum(1 for o in orders if o.get("status") == "delivered") + len(pos)
    delivered_cur = (sum(1 for d, o in order_dts if in_month(d, now.year, now.month) and o.get("status") == "delivered")
                     + sum(1 for d, _ in pos_dts if in_month(d, now.year, now.month)))
    delivered_prev = (sum(1 for d, o in order_dts if in_month(d, ly, lm) and o.get("status") == "delivered")
                      + sum(1 for d, _ in pos_dts if in_month(d, ly, lm)))
    cancelled_total = sum(1 for o in orders if o.get("status") == "cancelled")
    cancelled_cur = sum(1 for d, o in order_dts if in_month(d, now.year, now.month) and o.get("status") == "cancelled")
    cancelled_prev = sum(1 for d, o in order_dts if in_month(d, ly, lm) and o.get("status") == "cancelled")

    # ---------- Revenue series (last 8 months, income vs derived expense) ----------
    MABBR = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    months = []
    y, m = now.year, now.month
    for _ in range(8):
        months.append((y, m))
        m -= 1
        if m == 0:
            m = 12
            y -= 1
    months.reverse()
    income, expense, labels = [], [], []
    for (yy, mm) in months:
        inc = sum(o.get("total", 0) for d, o in order_dts if in_month(d, yy, mm)) + sum(p.get("total", 0) for d, p in pos_dts if in_month(d, yy, mm))
        income.append(round(inc, 2))
        expense.append(round(inc * 0.6, 2))  # derived COGS estimate (we don't track real expenses)
        labels.append(MABBR[mm - 1])
    peak_i = max(range(len(income)), key=lambda i: income[i]) if income else 0
    revenue_total = round(sum(income), 2)

    # ---------- Top categories (by ordered quantity) ----------
    cat_counts = {}
    for o in orders:
        for it in o.get("items", []):
            mi = mi_by_id.get(it.get("menu_item_id"))
            cat = (mi.get("category") if mi else None) or "Other"
            cat_counts[cat] = cat_counts.get(cat, 0) + int(it.get("quantity", it.get("qty", 1)))
    if not cat_counts:  # fallback to menu distribution
        for mi in menu_items:
            cat = mi.get("category") or "Other"
            cat_counts[cat] = cat_counts.get(cat, 0) + 1
    top_cats_raw = sorted(cat_counts.items(), key=lambda x: -x[1])[:4]
    cat_total = sum(c for _, c in top_cats_raw) or 1
    top_categories = [{"name": n, "value": round(c * 100 / cat_total), "count": c} for n, c in top_cats_raw]

    # ---------- Orders overview (this week, Mon-Sun) ----------
    WK = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    week_start = (now - timedelta(days=now.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
    week_counts = [0] * 7
    for d, _ in order_dts + pos_dts:
        if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= week_start:
            week_counts[d.weekday()] += 1
    ov_peak = max(range(7), key=lambda i: week_counts[i]) if any(week_counts) else 3

    # ---------- Customer flow (this week: in-restaurant POS vs online app orders) ----------
    flow_online = [0] * 7
    flow_inrest = [0] * 7
    for d, _ in order_dts:
        if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= week_start:
            flow_online[d.weekday()] += 1
    for d, _ in pos_dts:
        if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= week_start:
            flow_inrest[d.weekday()] += 1
    flow_inrest_amt = round(sum(p.get("total", 0) for d, p in pos_dts
                                if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= week_start), 2)
    flow_online_amt = round(sum(o.get("total", 0) for d, o in order_dts
                                if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= week_start), 2)

    # ---------- Total sale (today) + last-7-day revenue sparkline ----------
    today_start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    sale_today = 0.0
    orders_today = 0
    for d, o in order_dts:
        if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= today_start:
            sale_today += o.get("total", 0)
            orders_today += 1
    for d, p in pos_dts:
        if d and d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo) >= today_start:
            sale_today += p.get("total", 0)
            orders_today += 1
    week_series = [0.0] * 7  # last 7 days, oldest -> today
    for d, o in order_dts + pos_dts:
        if not d:
            continue
        dd = d.replace(tzinfo=timezone.utc if d.tzinfo is None else d.tzinfo)
        age = (today_start + timedelta(days=1) - dd).days
        if 0 <= age <= 6:
            week_series[6 - age] += o.get("total", 0)
    week_series = [round(v, 2) for v in week_series]

    # ---------- Order types (Dine-In / Takeaway / Online) ----------
    dine_in = sum(1 for p in pos if p.get("order_type") == "dine_in")
    takeaway = sum(1 for p in pos if p.get("order_type") in ("takeaway", "walk_in"))
    online = len(orders)
    ot_total = (dine_in + takeaway + online) or 1
    order_types = [
        {"type": "Dine-In", "count": dine_in, "pct": round(dine_in * 100 / ot_total)},
        {"type": "Takeaway", "count": takeaway, "pct": round(takeaway * 100 / ot_total)},
        {"type": "Online", "count": online, "pct": round(online * 100 / ot_total)},
    ]

    # ---------- Recent orders ----------
    recent_orders = []
    for o in orders[:6]:
        items = o.get("items", [])
        first = items[0] if items else {}
        mi = mi_by_id.get(first.get("menu_item_id"))
        recent_orders.append({
            "id": o.get("id"),
            "order_no": "ORD" + (o.get("id", "")[:4]).upper(),
            "image": first.get("image") or (mi.get("image") if mi else ""),
            "name": first.get("name") or "Order",
            "category": (mi.get("category") if mi else "") or "",
            "qty": sum(int(i.get("quantity", i.get("qty", 1))) for i in items),
            "amount": o.get("total", 0),
            "customer": o.get("customer_name") or "Customer",
            "status": o.get("status", "placed"),
        })

    # ---------- Trending menus (by ordered qty) ----------
    item_qty = {}
    for o in orders:
        for it in o.get("items", []):
            mid = it.get("menu_item_id")
            if mid:
                item_qty[mid] = item_qty.get(mid, 0) + int(it.get("quantity", it.get("qty", 1)))
    trending = []
    if item_qty:
        for mid, q in sorted(item_qty.items(), key=lambda x: -x[1])[:6]:
            mi = mi_by_id.get(mid)
            if not mi:
                continue
            trending.append({"name": mi.get("name"), "category": mi.get("category") or "",
                             "image": mi.get("image"), "rating": mi.get("rating", 4.5),
                             "orders": q, "price": mi.get("price", 0)})
    if not trending:
        for mi in sorted(menu_items, key=lambda m: -m.get("rating", 0))[:6]:
            trending.append({"name": mi.get("name"), "category": mi.get("category") or "",
                             "image": mi.get("image"), "rating": mi.get("rating", 4.5),
                             "orders": 0, "price": mi.get("price", 0)})

    # ---------- Recent activity (derived timeline) ----------
    activity = []
    for o in orders[:5]:
        st = o.get("status")
        if st == "delivered":
            txt, icon = f"Order {('ORD' + o.get('id','')[:4]).upper()} delivered to {o.get('customer_name') or 'customer'}", "checkbox"
        elif st == "cancelled":
            txt, icon = f"Order {('ORD' + o.get('id','')[:4]).upper()} was cancelled", "close-circle"
        else:
            txt, icon = f"New order {('ORD' + o.get('id','')[:4]).upper()} placed by {o.get('customer_name') or 'a customer'}", "cube"
        activity.append({"name": o.get("restaurant_name") or "Restaurant", "tag": "Order",
                         "text": txt, "time": _rel_time(_parse_dt(o.get("placed_at"))), "icon": icon,
                         "_dt": o.get("placed_at") or ""})
    for r in (recent_reviews or [])[:3]:
        activity.append({"name": r.get("user_name") or "Customer", "tag": "Review",
                         "text": f"left a {r.get('rating')}\u2605 review: \u201C{(r.get('comment') or '')[:50]}\u201D",
                         "time": _rel_time(_parse_dt(r.get("created_at"))), "icon": "star",
                         "_dt": r.get("created_at") or ""})
    activity.sort(key=lambda a: a.get("_dt", ""), reverse=True)
    for a in activity:
        a.pop("_dt", None)
    activity = activity[:6]

    # ---------- Customer reviews ----------
    reviews_out = []
    for r in (recent_reviews or [])[:6]:
        rid = r.get("restaurant_id")
        reviews_out.append({
            "title": rest_name.get(rid, "Restaurant"),
            "comment": r.get("comment") or "Great experience!",
            "user": r.get("user_name") or "Customer",
            "rating": r.get("rating", 5),
            "date": (r.get("created_at") or "")[:10],
            "image": rest_img.get(rid, ""),
        })

    return {
        "stats": {
            "total_orders": {"value": total_orders, "delta": _pct_delta(ord_cur, ord_prev)},
            "total_customers": {"value": cust_total, "delta": _pct_delta(cust_cur, cust_prev)},
            "total_revenue": {"value": total_revenue, "delta": _pct_delta(rev_cur, rev_prev)},
            "total_delivered": {"value": delivered_total, "delta": _pct_delta(delivered_cur, delivered_prev)},
            "total_cancelled": {"value": cancelled_total, "delta": _pct_delta(cancelled_cur, cancelled_prev)},
        },
        "revenue": {"total": revenue_total, "labels": labels, "income": income, "expense": expense,
                    "peak": {"label": labels[peak_i] if labels else "", "value": income[peak_i] if income else 0, "index": peak_i}},
        "top_categories": top_categories,
        "orders_overview": {"labels": WK, "values": week_counts, "peak_index": ov_peak, "peak_value": week_counts[ov_peak] if week_counts else 0},
        "customer_flow": {"labels": WK, "in_restaurant": flow_inrest, "online": flow_online,
                          "in_restaurant_amount": flow_inrest_amt, "online_amount": flow_online_amt},
        "total_sale": {"today": round(sale_today, 2), "orders_today": orders_today, "week_series": week_series},
        "order_types": order_types,
        "recent_orders": recent_orders,
        "trending_menus": trending,
        "recent_activity": activity,
        "reviews": reviews_out,
    }


@api.get("/admin/dashboard")
async def admin_dashboard(user: dict = Depends(require_role("admin"))):
    """Aggregated payload powering the rich admin dashboard (global, all restaurants)."""
    now = datetime.now(timezone.utc)
    # Hide orders still awaiting online payment (unpaid/failed Razorpay).
    orders = await db.orders.find({"awaiting_payment": {"$ne": True}}, {"_id": 0}).sort("placed_at", -1).to_list(5000)
    pos = await db.pos_orders.find({}, {"_id": 0}).sort("created_at", -1).to_list(5000)
    menu_items = await db.menu_items.find({}, {"_id": 0}).to_list(5000)
    rests = await db.restaurants.find({}, {"_id": 0, "id": 1, "name": 1, "image": 1}).to_list(500)
    reviews = await db.reviews.find({}, {"_id": 0}).sort("created_at", -1).to_list(20)
    ly, lm = (now.year, now.month - 1) if now.month > 1 else (now.year - 1, 12)
    cust_users = await db.users.find({"role": "customer"}, {"_id": 0, "created_at": 1}).to_list(20000)
    cust_dts = [_parse_dt(u.get("created_at")) for u in cust_users]
    cust_cur = sum(1 for d in cust_dts if d and d.year == now.year and d.month == now.month)
    cust_prev = sum(1 for d in cust_dts if d and d.year == ly and d.month == lm)
    return _compute_dashboard_payload(now, orders, pos, menu_items, rests, reviews, len(cust_users), cust_cur, cust_prev)


@api.get("/owner/dashboard")
async def owner_dashboard(user: dict = Depends(require_role("restaurant_owner"))):
    """Aggregated payload for the owner dashboard, scoped to the owner's restaurants."""
    now = datetime.now(timezone.utc)
    rests = await db.restaurants.find({"owner_id": user["id"]}, {"_id": 0}).to_list(50)
    rest_ids = [r["id"] for r in rests]
    if not rest_ids:
        return _compute_dashboard_payload(now, [], [], [], [], [], 0, 0, 0)
    orders = await db.orders.find({"restaurant_id": {"$in": rest_ids}, "awaiting_payment": {"$ne": True}}, {"_id": 0}).sort("placed_at", -1).to_list(5000)
    pos = await db.pos_orders.find({"restaurant_id": {"$in": rest_ids}}, {"_id": 0}).sort("created_at", -1).to_list(5000)
    menu_items = await db.menu_items.find({"restaurant_id": {"$in": rest_ids}}, {"_id": 0}).to_list(5000)
    reviews = await db.reviews.find({"restaurant_id": {"$in": rest_ids}}, {"_id": 0}).sort("created_at", -1).to_list(20)
    ly, lm = (now.year, now.month - 1) if now.month > 1 else (now.year - 1, 12)
    cust_all, cust_cur_set, cust_prev_set = set(), set(), set()
    for o in orders:
        cid = o.get("customer_id")
        if not cid:
            continue
        cust_all.add(cid)
        d = _parse_dt(o.get("placed_at"))
        if d and d.year == now.year and d.month == now.month:
            cust_cur_set.add(cid)
        elif d and d.year == ly and d.month == lm:
            cust_prev_set.add(cid)
    return _compute_dashboard_payload(now, orders, pos, menu_items, rests, reviews, len(cust_all), len(cust_cur_set), len(cust_prev_set))


@api.get("/admin/users")
async def admin_users(
    q: Optional[str] = None,
    role: Optional[str] = None,
    user: dict = Depends(require_role("admin")),
):
    """Admin user list with optional server-side filtering.

    `q` matches on name (case-insensitive), phone (contains) OR account_id.
    `role` restricts to a specific role.
    """
    users = await db.users.find({}, {"_id": 0}).sort("created_at", -1).to_list(1000)
    users = [_ensure_user_account_id(u) for u in users]
    if role and role != "all":
        users = [u for u in users if u.get("role") == role]
    if q:
        needle = q.strip().lower()
        if needle:
            users = [
                u for u in users
                if needle in (u.get("name") or "").lower()
                or needle in (u.get("phone") or "")
                or needle in (u.get("account_id") or "").lower()
            ]
    return users[:500]


@api.post("/admin/users")
async def admin_create_user(body: AdminUserCreate, user: dict = Depends(require_role("admin"))):
    """Admin-only: create a new user with any role."""
    phone = body.phone.strip()
    if not (phone.isdigit() and len(phone) == 10):
        raise HTTPException(400, "Phone must be a 10-digit number")
    existing = await db.users.find_one({"phone": phone}, {"_id": 0})
    if existing:
        raise HTTPException(400, "A user with this phone number already exists")
    uid = str(uuid.uuid4())
    doc = {
        "id": uid,
        "phone": phone,
        "name": (body.name or "").strip() or f"User {phone[-4:]}",
        "role": body.role,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "account_id": _account_id_for_user({"id": uid, "role": body.role}),
    }
    await db.users.insert_one(dict(doc))
    return doc


@api.patch("/admin/users/{uid}")
async def admin_update_user(uid: str, body: AdminUserUpdate, user: dict = Depends(require_role("admin"))):
    """Admin-only: update a user's name, phone, or role."""
    target = await db.users.find_one({"id": uid}, {"_id": 0})
    if not target:
        raise HTTPException(404, "User not found")
    updates: dict = {}
    if body.name is not None and body.name.strip():
        updates["name"] = body.name.strip()
    if body.role is not None:
        # Safety: an admin cannot demote their own account (avoids lock-out)
        if uid == user["id"] and body.role != "admin":
            raise HTTPException(400, "You cannot change your own admin role")
        updates["role"] = body.role
    if body.phone is not None:
        phone = body.phone.strip()
        if not (phone.isdigit() and len(phone) == 10):
            raise HTTPException(400, "Phone must be a 10-digit number")
        dup = await db.users.find_one({"phone": phone, "id": {"$ne": uid}}, {"_id": 0})
        if dup:
            raise HTTPException(400, "Another user already uses this phone number")
        updates["phone"] = phone
    if updates:
        await db.users.update_one({"id": uid}, {"$set": updates})
    return await db.users.find_one({"id": uid}, {"_id": 0})


@api.patch("/auth/me")
async def update_my_profile(body: dict, user: dict = Depends(get_current_user)):
    """Self-service profile edit. Users can update name, email, dob, gender and avatar.
    Phone number is intentionally NOT editable through this endpoint —
    changing the phone would require re-verification via OTP."""
    updates = {}
    body = body or {}
    if "name" in body:
        name = body.get("name")
        if name is not None:
            name = str(name).strip()
            if not name:
                raise HTTPException(400, "Name cannot be empty")
            updates["name"] = name
    if "email" in body:
        email = body.get("email")
        if email is None or (isinstance(email, str) and email.strip() == ""):
            updates["email"] = None
        else:
            email_str = str(email).strip().lower()
            if not re.match(r"^[^\s@]+@[^\s@]+\.[^\s@]+$", email_str):
                raise HTTPException(400, "Enter a valid email address")
            updates["email"] = email_str
    if "dob" in body:
        dob = body.get("dob")
        if dob is None or (isinstance(dob, str) and dob.strip() == ""):
            updates["dob"] = None
        else:
            dob_str = str(dob).strip()
            if not re.match(r"^\d{4}-\d{2}-\d{2}$", dob_str):
                raise HTTPException(400, "Date of birth must be in YYYY-MM-DD format")
            try:
                d = datetime.strptime(dob_str, "%Y-%m-%d")
            except ValueError:
                raise HTTPException(400, "Enter a valid date")
            today = datetime.now(timezone.utc).replace(tzinfo=None)
            if d > today:
                raise HTTPException(400, "Date of birth cannot be in the future")
            if (today - d).days < 365 * 5:
                raise HTTPException(400, "You must be at least 5 years old")
            if (today - d).days > 365 * 120:
                raise HTTPException(400, "Please enter a valid date of birth")
            updates["dob"] = dob_str
    if "gender" in body:
        gender = body.get("gender")
        if gender is None or (isinstance(gender, str) and gender.strip() == ""):
            updates["gender"] = None
        else:
            g = str(gender).strip().lower()
            if g not in ("male", "female", "other", "prefer_not_to_say"):
                raise HTTPException(400, "Invalid gender value")
            updates["gender"] = g
    if "avatar" in body:
        avatar = body.get("avatar")
        if avatar is None or (isinstance(avatar, str) and avatar.strip() == ""):
            updates["avatar"] = None
        else:
            av = str(avatar).strip()
            if not av.startswith("data:image/"):
                raise HTTPException(400, "Avatar must be a base64 data URL")
            # Guard against oversized payloads (roughly 3 MB base64 ≈ 2 MB image)
            if len(av) > 3_000_000:
                raise HTTPException(400, "Avatar image is too large. Please pick a smaller photo.")
            updates["avatar"] = av
    if updates:
        await db.users.update_one({"id": user["id"]}, {"$set": updates})
    return await db.users.find_one({"id": user["id"]}, {"_id": 0})


@api.delete("/auth/me")
async def delete_my_account(user: dict = Depends(get_current_user)):
    """Self-service account deletion (customer role only — required by Apple
    App Store guideline 5.1.1v). Removes the user document; their past orders
    are kept for the restaurant/admin's records but no longer linked to a
    live account. Sensitive personal data (saved addresses, payment methods,
    notifications) is deleted."""
    if user.get("role") != "customer":
        raise HTTPException(403, "Account deletion is only available for customer accounts")
    uid = user["id"]
    await db.addresses.delete_many({"user_id": uid})
    await db.payment_methods.delete_many({"user_id": uid})
    await db.notifications.delete_many({"user_id": uid})
    await db.cart.delete_many({"user_id": uid})
    await db.users.delete_one({"id": uid})
    return {"ok": True}


@api.delete("/admin/users/{uid}")
async def admin_delete_user(uid: str, user: dict = Depends(require_role("admin"))):
    """Admin-only: delete a user. Unassigns any restaurants they owned."""
    if uid == user["id"]:
        raise HTTPException(400, "You cannot delete your own account")
    target = await db.users.find_one({"id": uid}, {"_id": 0})
    if not target:
        raise HTTPException(404, "User not found")
    await db.restaurants.update_many({"owner_id": uid}, {"$set": {"owner_id": None}})
    await db.users.delete_one({"id": uid})
    return {"ok": True}


# ---------------------------------------------------------------------------
# Rider management (admin) — dedicated list & actions
# ---------------------------------------------------------------------------
# `/admin/users?role=rider` returns raw docs but the manage-riders console needs
# per-rider stats (total, delivered, active, avg rating, KYC status). This
# endpoint enriches each rider with those aggregates in a single roundtrip.
@api.get("/admin/riders")
async def admin_riders(
    q: Optional[str] = None,
    status: Optional[str] = None,  # verified | pending | blocked | online | offline
    user: dict = Depends(require_role("admin")),
):
    """List riders with stats + KYC status.

    Filters:
      status=verified   → rider_verified == True and not blocked
      status=pending    → rider_verified != True and not blocked
      status=blocked    → is_blocked == True
      status=online     → currently online (heartbeat < 240s)
      status=offline    → not online
    """
    riders = await db.users.find({"role": "rider"}, {"_id": 0}).to_list(2000)
    riders = [_ensure_user_account_id(r) for r in riders]

    # Batch fetch stats
    rider_ids = [r["id"] for r in riders]
    stats_map: dict = {rid: {"total": 0, "delivered": 0, "cancelled": 0, "active": 0, "earnings": 0.0, "rating_sum": 0.0, "rating_count": 0} for rid in rider_ids}
    if rider_ids:
        agg = db.orders.aggregate([
            {"$match": {"rider_id": {"$in": rider_ids}}},
            {"$group": {
                "_id": "$rider_id",
                "total": {"$sum": 1},
                "delivered": {"$sum": {"$cond": [{"$eq": ["$status", "delivered"]}, 1, 0]}},
                "cancelled": {"$sum": {"$cond": [{"$eq": ["$status", "cancelled"]}, 1, 0]}},
                "active": {"$sum": {"$cond": [{"$in": ["$status", ["accepted", "preparing", "ready", "picked"]]}, 1, 0]}},
                "earnings": {"$sum": {"$ifNull": ["$rider_payout", 0]}},
                "rating_sum": {"$sum": {"$ifNull": ["$rider_rating", 0]}},
                "rating_count": {"$sum": {"$cond": [{"$gt": [{"$ifNull": ["$rider_rating", 0]}, 0]}, 1, 0]}},
            }},
        ])
        async for row in agg:
            stats_map[row["_id"]] = {k: v for k, v in row.items() if k != "_id"}

    # KYC / application status for each rider
    apps = await db.applications.find({"role": "rider", "user_id": {"$in": rider_ids}}, {"_id": 0}).to_list(2000)
    app_map = {a.get("user_id"): a for a in apps}

    now = datetime.now(timezone.utc)
    HEARTBEAT_STALE_SECS = 240
    enriched = []
    for r in riders:
        stats = stats_map.get(r["id"], {})
        avg_rating = (stats.get("rating_sum") or 0) / stats["rating_count"] if stats.get("rating_count") else None
        # Online check via heartbeat freshness
        online_via_hb = False
        hb = r.get("last_heartbeat_at")
        if hb:
            try:
                hb_dt = datetime.fromisoformat(hb.replace("Z", "+00:00")) if isinstance(hb, str) else hb
                online_via_hb = (now - hb_dt).total_seconds() < HEARTBEAT_STALE_SECS
            except Exception:  # noqa: BLE001
                pass
        is_online = bool(r.get("is_online")) and online_via_hb
        app = app_map.get(r["id"])
        # Expose the rider's vehicle registration number (from the KYC application
        # payload) so the admin Live Riders map can label each pin with the
        # bike/scooter number instead of the rider's name.
        _app_payload = (app or {}).get("payload") or {}
        _vehicle_number = (r.get("vehicle_number")
                           or _app_payload.get("vehicle_number")
                           or "")
        _vehicle_type = (r.get("vehicle_type")
                         or _app_payload.get("vehicle_type")
                         or "")
        enriched.append({
            **r,
            "vehicle_number": _vehicle_number,
            "vehicle_type": _vehicle_type,
            "stats": {
                "total": stats.get("total", 0),
                "delivered": stats.get("delivered", 0),
                "cancelled": stats.get("cancelled", 0),
                "active": stats.get("active", 0),
                "earnings": round(float(stats.get("earnings") or 0), 2),
                "avg_rating": round(avg_rating, 2) if avg_rating else None,
            },
            "kyc": {
                "has_application": app is not None,
                "application_id": (app or {}).get("id"),
                "application_status": (app or {}).get("status"),  # pending | approved | rejected
                "docs": (app or {}).get("documents") or (app or {}).get("docs") or {},
            },
            "is_online_live": is_online,
            "toggled_online": bool(r.get("is_online")),
        })

    # Apply search filter
    if q:
        needle = q.strip().lower()
        enriched = [
            r for r in enriched
            if needle in (r.get("name") or "").lower()
            or needle in (r.get("phone") or "")
            or needle in (r.get("account_id") or "").lower()
        ]

    # Apply status filter
    if status == "verified":
        enriched = [r for r in enriched if r.get("rider_verified") is True and not r.get("is_blocked")]
    elif status == "pending":
        enriched = [r for r in enriched if r.get("rider_verified") is not True and not r.get("is_blocked")]
    elif status == "blocked":
        enriched = [r for r in enriched if r.get("is_blocked") is True]
    elif status == "online":
        enriched = [r for r in enriched if r.get("is_online_live")]
    elif status == "offline":
        enriched = [r for r in enriched if not r.get("is_online_live")]

    # Sort: online first, then verified, then most orders
    enriched.sort(key=lambda r: (
        -1 if r.get("is_online_live") else 1,
        -1 if r.get("rider_verified") else 1,
        -(r["stats"].get("total") or 0),
    ))
    return enriched


@api.get("/admin/riders/{rid}")
async def admin_rider_detail(rid: str, user: dict = Depends(require_role("admin"))):
    """Full rider detail: profile, KYC application, order history (last 50), payouts."""
    r = await db.users.find_one({"id": rid, "role": "rider"}, {"_id": 0})
    if not r:
        raise HTTPException(404, "Rider not found")
    r = _ensure_user_account_id(r)
    app = await db.applications.find_one({"role": "rider", "user_id": rid}, {"_id": 0})
    orders = await db.orders.find({"rider_id": rid}, {"_id": 0}).sort("created_at", -1).to_list(50)
    return {
        "rider": r,
        "application": app,
        "orders": [_ensure_order_number(o) for o in orders],
    }


class RiderAdminAction(BaseModel):
    verified: Optional[bool] = None
    blocked: Optional[bool] = None
    force_offline: Optional[bool] = None
    note: Optional[str] = None


class RiderProfileEdit(BaseModel):
    """Full editable profile envelope for a rider — updates BOTH the user doc
    (basic identity) AND the KYC application doc (address, vehicle, KYC, bank).
    Admin uses this to fix typos or complete on-boarding on behalf of a rider.
    If no application exists yet the endpoint creates one so future edits
    (KYC / documents) have a canonical home.
    """
    # user doc fields
    name: Optional[str] = None
    phone: Optional[str] = None
    email: Optional[str] = None
    # KYC / applicant fields (mirrors applications.RiderPayload)
    full_name: Optional[str] = None
    contact_phone: Optional[str] = None
    contact_email: Optional[str] = None
    date_of_birth: Optional[str] = None
    city: Optional[str] = None
    address: Optional[str] = None
    pincode: Optional[str] = None
    vehicle_type: Optional[str] = None
    vehicle_number: Optional[str] = None
    rc_number: Optional[str] = None
    license_number: Optional[str] = None
    aadhaar_number: Optional[str] = None
    pan_number: Optional[str] = None
    bank_account_name: Optional[str] = None
    bank_account_number: Optional[str] = None
    bank_ifsc: Optional[str] = None
    # Base64 data-URL documents (optional — only sent when the admin uploads a new file)
    aadhaar_doc: Optional[str] = None
    license_doc: Optional[str] = None
    rc_doc: Optional[str] = None
    profile_photo: Optional[str] = None
    # Free-form admin note captured on the application timeline
    admin_note: Optional[str] = None


@api.patch("/admin/riders/{rid}")
async def admin_rider_action(rid: str, body: RiderAdminAction, user: dict = Depends(require_role("admin"))):
    """Verify / block / force-offline a rider. All actions are idempotent."""
    r = await db.users.find_one({"id": rid, "role": "rider"}, {"_id": 0})
    if not r:
        raise HTTPException(404, "Rider not found")
    updates: dict = {}
    if body.verified is not None:
        updates["rider_verified"] = bool(body.verified)
    if body.blocked is not None:
        updates["is_blocked"] = bool(body.blocked)
        if body.blocked:
            # Kicking them offline stops any new pickups landing on them.
            updates["is_online"] = False
    if body.force_offline is True:
        updates["is_online"] = False
    if not updates:
        raise HTTPException(400, "No fields to update")
    updates["admin_last_action_by"] = user.get("name") or user.get("id")
    updates["admin_last_action_at"] = datetime.now(timezone.utc).isoformat()
    if body.note:
        updates["admin_last_action_note"] = body.note[:500]
    await db.users.update_one({"id": rid}, {"$set": updates})
    return {"ok": True, "updated": updates}


@api.put("/admin/riders/{rid}/profile")
async def admin_rider_profile_edit(
    rid: str,
    body: RiderProfileEdit,
    user: dict = Depends(require_role("admin")),
):
    """Full profile edit for a rider (basic + KYC + docs). Fills gaps for riders
    who never submitted a formal application. Payload keys map 1:1 to the
    application submit schema; only non-None values are applied.
    """
    r = await db.users.find_one({"id": rid, "role": "rider"}, {"_id": 0})
    if not r:
        raise HTTPException(404, "Rider not found")

    now = datetime.now(timezone.utc).isoformat()
    admin_name = user.get("name") or user.get("id")

    # ---- 1. Update user doc (identity) ----
    user_upd: dict = {}
    if body.name is not None:
        user_upd["name"] = body.name.strip()
    if body.phone is not None:
        new_phone = ("".join(ch for ch in body.phone if ch.isdigit()))[-10:]
        if len(new_phone) != 10:
            raise HTTPException(400, "Phone must be 10 digits")
        # Ensure phone uniqueness
        clash = await db.users.find_one({"phone": new_phone, "id": {"$ne": rid}}, {"_id": 0, "id": 1})
        if clash:
            raise HTTPException(400, f"Phone {new_phone} is already used by another user")
        user_upd["phone"] = new_phone
    if body.email is not None:
        user_upd["email"] = body.email.strip() or None
    if user_upd:
        user_upd["admin_last_action_by"] = admin_name
        user_upd["admin_last_action_at"] = now
        if body.admin_note:
            user_upd["admin_last_action_note"] = body.admin_note[:500]
        await db.users.update_one({"id": rid}, {"$set": user_upd})

    # ---- 2. Update / create application doc (KYC + address + vehicle + bank + docs) ----
    kyc_fields = [
        "full_name", "contact_phone", "contact_email", "date_of_birth",
        "city", "address", "pincode",
        "vehicle_type", "vehicle_number", "rc_number", "license_number",
        "aadhaar_number", "pan_number",
        "bank_account_name", "bank_account_number", "bank_ifsc",
    ]
    doc_fields = ["aadhaar_doc", "license_doc", "rc_doc", "profile_photo"]

    payload_patch: dict = {}
    for k in kyc_fields:
        v = getattr(body, k, None)
        if v is not None:
            payload_patch[k] = v.strip() if isinstance(v, str) else v
    for k in doc_fields:
        v = getattr(body, k, None)
        if v is not None:
            payload_patch[k] = v  # base64 data URL — accept as-is

    existing_app = await db.applications.find_one({"user_id": rid, "role": "rider"}, {"_id": 0})

    if payload_patch:
        if existing_app:
            merged_payload = {**(existing_app.get("payload") or {}), **payload_patch}
            timeline_entry = {
                "at": now,
                "by": admin_name,
                "action": "admin_profile_edit",
                "note": body.admin_note or None,
                "fields": list(payload_patch.keys()),
            }
            await db.applications.update_one(
                {"id": existing_app["id"]},
                {
                    "$set": {"payload": merged_payload, "updated_at": now},
                    "$push": {"timeline": timeline_entry},
                },
            )
        else:
            # Create a shell application doc so future edits have a home.
            # We seed with defaults for required fields where possible.
            seed_payload = {
                "full_name": body.full_name or r.get("name") or "",
                "contact_phone": body.contact_phone or r.get("phone") or "",
                "contact_email": body.contact_email or "",
                "date_of_birth": body.date_of_birth or "",
                "city": body.city or "",
                "address": body.address or "",
                "pincode": body.pincode or "",
                "vehicle_type": body.vehicle_type or "bike",
                "vehicle_number": body.vehicle_number or "",
                "rc_number": body.rc_number or "",
                "license_number": body.license_number or "",
                "aadhaar_number": body.aadhaar_number or "",
                "pan_number": body.pan_number or "",
                "bank_account_name": body.bank_account_name or "",
                "bank_account_number": body.bank_account_number or "",
                "bank_ifsc": body.bank_ifsc or "",
                "aadhaar_doc": body.aadhaar_doc,
                "license_doc": body.license_doc,
                "rc_doc": body.rc_doc,
                "profile_photo": body.profile_photo,
            }
            new_app = {
                "id": str(uuid.uuid4()),
                "role": "rider",
                "type": "rider",
                "user_id": rid,
                "status": "approved" if r.get("rider_verified") else "pending",
                "payload": seed_payload,
                "created_at": now,
                "updated_at": now,
                "created_by_admin": True,
                "created_by_admin_name": admin_name,
                "timeline": [{
                    "at": now,
                    "by": admin_name,
                    "action": "admin_profile_create",
                    "note": body.admin_note or "Admin created rider profile on behalf of rider",
                    "fields": list(payload_patch.keys()),
                }],
            }
            await db.applications.insert_one(new_app)

    fresh_user = await db.users.find_one({"id": rid}, {"_id": 0})
    fresh_app = await db.applications.find_one({"user_id": rid, "role": "rider"}, {"_id": 0})
    return {
        "ok": True,
        "rider": _ensure_user_account_id(fresh_user) if fresh_user else None,
        "application": fresh_app,
    }


# ---------------------------------------------------------------------------
# Activity Logs (admin) — read-only audit trail
# ---------------------------------------------------------------------------
@api.get("/admin/logs")
async def admin_activity_logs(
    role: Optional[str] = None,        # actor role filter
    method: Optional[str] = None,      # HTTP method filter
    q: Optional[str] = None,           # substring on actor name/phone or path
    since_hours: Optional[int] = None, # last N hours
    limit: int = 200,
    user: dict = Depends(require_role("admin")),
):
    """Return the most recent activity log entries with optional filters.

    Backed by the `activity_logs` collection populated by the `audit_activity`
    middleware. Sensitive fields (passwords, OTPs, tokens) are redacted at
    write time — the raw payload here is safe to display to admins.
    """
    match: dict = {}
    if role and role != "all":
        match["actor_role"] = role
    if method and method != "all":
        match["method"] = method.upper()
    if since_hours and since_hours > 0:
        cutoff = (datetime.now(timezone.utc) - timedelta(hours=since_hours)).isoformat()
        match["ts"] = {"$gte": cutoff}
    if q:
        needle = q.strip()
        if needle:
            match["$or"] = [
                {"actor_name": {"$regex": needle, "$options": "i"}},
                {"actor_phone": {"$regex": needle, "$options": "i"}},
                {"path": {"$regex": needle, "$options": "i"}},
                {"action": {"$regex": needle, "$options": "i"}},
            ]
    limit = max(1, min(int(limit or 200), 1000))
    logs = await db.activity_logs.find(match, {"_id": 0}).sort("ts", -1).to_list(limit)
    return logs


@api.get("/admin/restaurants")
async def admin_rests(
    q: Optional[str] = None,
    user: dict = Depends(require_role("admin")),
):
    """Admin restaurant list. `q` matches on name/city/account_id."""
    rests = await db.restaurants.find({}, {"_id": 0}).to_list(1000)
    rests = [_ensure_rest_account_id(r) for r in rests]
    if q:
        needle = q.strip().lower()
        if needle:
            rests = [
                r for r in rests
                if needle in (r.get("name") or "").lower()
                or needle in (r.get("city") or "").lower()
                or needle in (r.get("account_id") or "").lower()
                or needle in (r.get("contact_phone") or "")
            ]
    return rests[:500]


@api.post("/admin/restaurants")
async def admin_create_rest(body: RestaurantCreate, user: dict = Depends(require_role("admin"))):
    """Admin-only restaurant creation."""
    # Validate owner if provided
    if body.owner_id:
        owner = await db.users.find_one({"id": body.owner_id, "role": "restaurant_owner"}, {"_id": 0})
        if not owner:
            raise HTTPException(400, "Owner not found or not a restaurant_owner")
    rid = str(uuid.uuid4())
    doc = {
        "id": rid,
        "name": body.name,
        "image": body.image or "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=800",
        "cuisines": body.cuisines or [],
        "rating": 0.0,
        "delivery_time": body.delivery_time,
        "price_for_two": body.price_for_two,
        "lat": body.lat,
        "lng": body.lng,
        "address": body.address,
        "owner_id": body.owner_id,
        "status": "active",
        "is_active": body.is_active,
        "is_promoted": False,
        "offer_text": None,
        "description": body.description,
        "contact_phone": body.contact_phone,
        "contact_email": body.contact_email,
        "fssai_license": body.fssai_license,
        "gst_number": body.gst_number,
        "bank_account_name": body.bank_account_name,
        "bank_account_number": body.bank_account_number,
        "bank_ifsc": body.bank_ifsc,
        "delivery_radius_km": body.delivery_radius_km,
        "operating_hours": [oh.dict() for oh in body.operating_hours],
        "documents": [d.dict() for d in body.documents],
        "city": body.city,
        "pincode": body.pincode,
        "pos_enabled": body.pos_enabled,
        "pos_consent": body.pos_enabled,
        "account_id": _account_id_for_rest({"id": rid}),
    }
    await db.restaurants.insert_one(dict(doc))
    # Auto-create default "Menu" category for this restaurant
    default_cat = {
        "id": str(uuid.uuid4()),
        "restaurant_id": doc["id"],
        "name": "Menu",
        "sort_order": 1,
        "is_enabled": True,
    }
    await db.categories.insert_one(dict(default_cat))
    return doc


@api.patch("/admin/restaurants/{rid}")
async def admin_update_rest(rid: str, body: dict, user: dict = Depends(require_role("admin"))):
    """Admin can update ANY field on a restaurant."""
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    allowed_keys = {
        "name", "image", "cuisines", "delivery_time", "price_for_two",
        "lat", "lng", "address", "description", "contact_phone", "contact_email",
        "fssai_license", "gst_number", "bank_account_name", "bank_account_number",
        "bank_ifsc", "delivery_radius_km", "operating_hours", "documents",
        "city", "pincode", "owner_id", "is_active", "status", "is_promoted", "offer_text",
        "pos_enabled", "pos_consent",
        # Admin-only contact roles + toggles
        "key_account_person", "manager", "auto_accept_orders",
    }
    allowed = {k: v for k, v in body.items() if k in allowed_keys}
    # Validate owner if changing
    if "owner_id" in allowed and allowed["owner_id"]:
        owner = await db.users.find_one({"id": allowed["owner_id"], "role": "restaurant_owner"}, {"_id": 0})
        if not owner:
            raise HTTPException(400, "Owner not found or not a restaurant_owner")
    # Normalise nested ContactPerson dicts (drop unknown keys, keep only str fields)
    for k in ("key_account_person", "manager"):
        if k in allowed and allowed[k] is not None:
            src = allowed[k] or {}
            if isinstance(src, dict):
                allowed[k] = {
                    "name": (src.get("name") or "").strip() or None,
                    "phone": (src.get("phone") or "").strip() or None,
                    "email": (src.get("email") or "").strip() or None,
                    "notes": (src.get("notes") or "").strip() or None,
                }
    # AUTO-GEOCODE: if the admin changed the address (or city/pincode) but did
    # NOT pass fresh lat/lng, look up the coordinates via Google Geocoding so
    # the restaurant's map marker stays in sync with the printed address.
    _addr_touched = any(k in allowed for k in ("address", "city", "pincode"))
    _coords_touched = ("lat" in allowed) or ("lng" in allowed)
    if _addr_touched and not _coords_touched:
        new_addr = allowed.get("address") or rest.get("address")
        new_city = allowed.get("city") or rest.get("city")
        new_pin = allowed.get("pincode") or rest.get("pincode")
        geo = await geocode_address(new_addr, new_city, new_pin)
        if geo:
            allowed["lat"] = geo["lat"]
            allowed["lng"] = geo["lng"]
    if allowed:
        await db.restaurants.update_one({"id": rid}, {"$set": allowed})
    return await db.restaurants.find_one({"id": rid}, {"_id": 0})


@api.delete("/admin/restaurants/{rid}")
async def admin_delete_rest(rid: str, user: dict = Depends(require_role("admin"))):
    """Admin-only restaurant deletion. Cascades to menu_items, categories, variations."""
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    # Collect menu item ids for variations cleanup
    item_ids = [m["id"] async for m in db.menu_items.find({"restaurant_id": rid}, {"_id": 0, "id": 1})]
    if item_ids:
        await db.item_variations.delete_many({"menu_item_id": {"$in": item_ids}})
    await db.menu_items.delete_many({"restaurant_id": rid})
    await db.categories.delete_many({"restaurant_id": rid})
    await db.restaurants.delete_one({"id": rid})
    return {"ok": True}


@api.post("/admin/restaurants/{rid}/assign-owner")
async def admin_assign_owner(rid: str, body: AssignOwner, user: dict = Depends(require_role("admin"))):
    """Assign or unassign an owner to a restaurant by owner_id or phone."""
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    owner_id: Optional[str] = body.owner_id
    if not owner_id and body.owner_phone:
        owner = await db.users.find_one({"phone": body.owner_phone, "role": "restaurant_owner"}, {"_id": 0})
        if not owner:
            raise HTTPException(404, "No restaurant_owner user with that phone")
        owner_id = owner["id"]
    if owner_id:
        owner = await db.users.find_one({"id": owner_id, "role": "restaurant_owner"}, {"_id": 0})
        if not owner:
            raise HTTPException(400, "Owner not found or not a restaurant_owner")
    # owner_id=None unassigns
    await db.restaurants.update_one({"id": rid}, {"$set": {"owner_id": owner_id}})
    return await db.restaurants.find_one({"id": rid}, {"_id": 0})


@api.get("/admin/owners")
async def admin_list_owners(user: dict = Depends(require_role("admin"))):
    """List all restaurant_owner users for assignment dropdowns."""
    return await db.users.find({"role": "restaurant_owner"}, {"_id": 0}).sort("created_at", -1).to_list(500)


@api.get("/admin/orders")
async def admin_orders(
    q: Optional[str] = None,
    status: Optional[str] = None,
    user: dict = Depends(require_role("admin")),
):
    """Admin list of all orders. `q` matches order_number, restaurant, customer or rider."""
    # Exclude orders still awaiting online payment so failed/cancelled Razorpay
    # orders never surface in the admin order list.
    orders = await db.orders.find({"awaiting_payment": {"$ne": True}}, {"_id": 0}).sort("placed_at", -1).to_list(1000)
    orders = [_ensure_order_number(o) for o in orders]
    if status and status != "all":
        orders = [o for o in orders if o.get("status") == status]
    if q:
        needle = q.strip().lower()
        if needle:
            orders = [
                o for o in orders
                if needle in (o.get("order_number") or "").lower()
                or needle in (o.get("restaurant_name") or "").lower()
                or needle in (o.get("customer_name") or "").lower()
                or needle in (o.get("rider_name") or "").lower()
                or needle in (o.get("id") or "").lower()
            ]
    return orders[:500]


@api.get("/admin/orders/{oid}")
async def admin_order_detail(oid: str, user: dict = Depends(require_role("admin"))):
    """Admin single-order fetch with live rider location details.

    This is what the admin's "Live Track" screen polls every few seconds.
    """
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    o = _ensure_order_number(o)
    # Enrich with rider info (if any) and restaurant location snapshot.
    if o.get("rider_id"):
        rider = await db.users.find_one({"id": o["rider_id"]}, {"_id": 0, "phone": 1, "name": 1, "account_id": 1, "id": 1, "role": 1})
        if rider:
            _ensure_user_account_id(rider)
            o["rider"] = {
                "id": rider.get("id"),
                "name": rider.get("name"),
                "phone": rider.get("phone"),
                "account_id": rider.get("account_id"),
            }
    return o


