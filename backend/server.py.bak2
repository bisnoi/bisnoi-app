# ----------------------------- Public listing routes -----------------------------
@api.get("/restaurants")
async def list_restaurants(q: Optional[str] = None, cuisine: Optional[str] = None, veg: Optional[bool] = None, sort: Optional[str] = None):
    query = {"status": "active"}
    if q:
        query["name"] = {"$regex": q, "$options": "i"}
    if cuisine:
        query["cuisines"] = {"$in": [cuisine]}
    cur = db.restaurants.find(query, {"_id": 0})
    items = await cur.to_list(500)
    if sort == "rating":
        items.sort(key=lambda x: -x.get("rating", 0))
    elif sort == "delivery":
        items.sort(key=lambda x: x.get("delivery_time", 99))
    elif sort == "price":
        items.sort(key=lambda x: x.get("price_for_two", 99999))
    for it in items:
        it["open_now"] = _restaurant_open_now(it)

    # Attach one representative menu-item photo per restaurant (card image
    # should show a dish, not the restaurant's own banner). Falls back to the
    # restaurant's own `image` field if it has no items with a photo yet.
    rids = [it["id"] for it in items if it.get("id")]
    if rids:
        item_docs = await db.menu_items.find(
            {"restaurant_id": {"$in": rids}, "image": {"$nin": [None, ""]}},
            {"_id": 0, "restaurant_id": 1, "image": 1},
        ).to_list(2000)
        first_item_image: dict = {}
        for d in item_docs:
            rid = d.get("restaurant_id")
            if rid and rid not in first_item_image:
                first_item_image[rid] = d.get("image")
        for it in items:
            pic = first_item_image.get(it.get("id"))
            if pic:
                it["item_image"] = pic

    return items


@api.get("/restaurants/{rid}")
async def get_restaurant(rid: str):
    r = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not r:
        raise HTTPException(404, "Not found")
    # LAZY GEOCODE: if this restaurant is still sitting on the sentinel default
    # coordinates (12.9716, 77.5946 → central Bangalore) yet has an address that
    # clearly is NOT in Bangalore/Bengaluru, geocode ONCE and persist the real
    # coordinates so the map on the details page reflects the actual location.
    try:
        if not r.get("_geocode_done"):
            _addr_lc = (r.get("address") or "").lower()
            _city_lc = (r.get("city") or "").lower()
            _looks_default = (
                abs(float(r.get("lat") or 0) - _DEFAULT_LAT) < 1e-4
                and abs(float(r.get("lng") or 0) - _DEFAULT_LNG) < 1e-4
            )
            _looks_bangalore = ("bengaluru" in _addr_lc or "bangalore" in _addr_lc
                                or "bengaluru" in _city_lc or "bangalore" in _city_lc)
            if _looks_default and not _looks_bangalore and r.get("address"):
                geo = await geocode_address(r.get("address"), r.get("city"), r.get("pincode"))
                if geo:
                    await db.restaurants.update_one(
                        {"id": rid},
                        {"$set": {"lat": geo["lat"], "lng": geo["lng"], "_geocode_done": True}},
                    )
                    r["lat"] = geo["lat"]
                    r["lng"] = geo["lng"]
                else:
                    # Mark as attempted so we don't keep re-trying every request.
                    await db.restaurants.update_one({"id": rid}, {"$set": {"_geocode_done": True}})
    except Exception as _e:
        log.warning("[geocode-lazy] failed for rid=%s: %s", rid, _e)
    menu = await db.menu_items.find({"restaurant_id": rid, "approval_status": {"$nin": ["pending", "rejected"]}}, {"_id": 0}).to_list(500)
    reviews = await db.reviews.find({"restaurant_id": rid}, {"_id": 0}).sort("created_at", -1).to_list(50)
    offer_ids = r.get("offer_ids") or []
    offers = await db.offers.find({"id": {"$in": offer_ids}, "active": True}, {"_id": 0}).to_list(50) if offer_ids else []
    r["open_now"] = _restaurant_open_now(r)
    return {"restaurant": r, "menu": menu, "reviews": reviews, "offers": offers}


