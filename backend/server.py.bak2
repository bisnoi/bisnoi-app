# ----------------------------- Media upload / serve (banners: images, GIFs & videos) -----------------------------
UPLOADS_DIR = ROOT_DIR / "uploads"
UPLOADS_DIR.mkdir(exist_ok=True)

MEDIA_IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".avif"}
MEDIA_VIDEO_EXTS = {".mp4", ".webm", ".mov", ".m4v", ".mpeg", ".mpg", ".ogg"}
MEDIA_MAX_BYTES = 40 * 1024 * 1024  # 40 MB

MEDIA_CONTENT_TYPES = {
    ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png",
    ".gif": "image/gif", ".webp": "image/webp", ".bmp": "image/bmp", ".avif": "image/avif",
    ".mp4": "video/mp4", ".webm": "video/webm", ".mov": "video/quicktime",
    ".m4v": "video/x-m4v", ".mpeg": "video/mpeg", ".mpg": "video/mpeg", ".ogg": "video/ogg",
}


@api.post("/admin/media/upload")
async def admin_upload_media(file: UploadFile = File(...), user: dict = Depends(require_role("admin"))):
    """Admin uploads banner media (jpeg/png/gif/webp images or mp4/webm/mov videos)."""
    name = (file.filename or "upload").lower()
    ext = Path(name).suffix
    if not ext and file.content_type:
        # derive extension from mime (e.g. blob uploads from the web picker)
        for e, ct in MEDIA_CONTENT_TYPES.items():
            if ct == file.content_type:
                ext = e
                break
    if ext not in MEDIA_IMAGE_EXTS and ext not in MEDIA_VIDEO_EXTS:
        raise HTTPException(400, "Unsupported file type. Use JPG, PNG, GIF, WEBP images or MP4, WEBM, MOV videos.")
    data = await file.read()
    if len(data) > MEDIA_MAX_BYTES:
        raise HTTPException(400, f"File too large (max {MEDIA_MAX_BYTES // (1024 * 1024)} MB)")
    if not data:
        raise HTTPException(400, "Empty file")
    fname = f"{uuid.uuid4().hex}{ext}"
    (UPLOADS_DIR / fname).write_bytes(data)
    media_type = "video" if ext in MEDIA_VIDEO_EXTS else "image"
    await db.media.insert_one({
        "id": fname, "original_name": file.filename, "media_type": media_type,
        "size": len(data), "uploaded_by": user["id"],
        "created_at": datetime.now(timezone.utc).isoformat(),
    })
    return {"url": f"/api/media/{fname}", "media_type": media_type, "size": len(data)}


@api.get("/media/{fname}")
async def serve_media(fname: str):
    """Public: serve uploaded banner media."""
    if "/" in fname or ".." in fname:
        raise HTTPException(400, "Invalid file name")
    path = UPLOADS_DIR / fname
    if not path.is_file():
        raise HTTPException(404, "Media not found")
    ct = MEDIA_CONTENT_TYPES.get(path.suffix.lower(), "application/octet-stream")
    return FileResponse(path, media_type=ct, headers={"Cache-Control": "public, max-age=86400"})


# ----------------------------- Checkout settings (admin-operated) -----------------------------
DEFAULT_CHECKOUT_SETTINGS = {
    "cancellation_policy_enabled": True,
    "cancellation_policy_text": "A 100% cancellation charge will apply. This helps us compensate the restaurant partner for food preparation.",
    "cod_enabled": True,
    "online_enabled": True,
    "cards_enabled": True,
    "upi_enabled": True,
    "wallets_enabled": True,
    "paylater_enabled": True,
}


class CheckoutSettingsUpdate(BaseModel):
    cancellation_policy_enabled: Optional[bool] = None
    cancellation_policy_text: Optional[str] = None
    cod_enabled: Optional[bool] = None
    online_enabled: Optional[bool] = None
    cards_enabled: Optional[bool] = None
    upi_enabled: Optional[bool] = None
    wallets_enabled: Optional[bool] = None
    paylater_enabled: Optional[bool] = None


async def _get_checkout_settings() -> dict:
    doc = await db.settings.find_one({"key": "checkout_settings"}, {"_id": 0}) or {}
    out = dict(DEFAULT_CHECKOUT_SETTINGS)
    for k in out:
        if k in doc:
            out[k] = doc[k]
    return out


@api.get("/settings/checkout")
async def get_checkout_settings():
    """Public: checkout page configuration (cancellation policy, enabled payment sections)."""
    return await _get_checkout_settings()


@api.patch("/admin/settings/checkout")
async def update_checkout_settings(body: CheckoutSettingsUpdate, user: dict = Depends(require_role("admin"))):
    updates = {k: v for k, v in body.dict().items() if v is not None}
    if "cancellation_policy_text" in updates:
        updates["cancellation_policy_text"] = str(updates["cancellation_policy_text"])[:2000]
    updates["key"] = "checkout_settings"
    updates["updated_at"] = datetime.now(timezone.utc).isoformat()
    await db.settings.update_one({"key": "checkout_settings"}, {"$set": updates}, upsert=True)
    return await _get_checkout_settings()


# ----------------------------- Saved addresses (per-user, synced) -----------------------------
class AddressCreate(BaseModel):
    label: str = "Home"
    line1: str
    city: Optional[str] = ""
    phone: Optional[str] = ""
    lat: Optional[float] = None
    lng: Optional[float] = None
    is_default: bool = False


@api.get("/me/addresses")
async def my_addresses(user: dict = Depends(get_current_user)):
    return await db.addresses.find({"user_id": user["id"]}, {"_id": 0}).sort("created_at", 1).to_list(50)


@api.post("/me/addresses")
async def add_address(body: AddressCreate, user: dict = Depends(get_current_user)):
    if not body.line1.strip():
        raise HTTPException(400, "Address line is required")
    count = await db.addresses.count_documents({"user_id": user["id"]})
    addr = {
        "id": str(uuid.uuid4()), "user_id": user["id"],
        "label": (body.label or "Home")[:30], "line1": body.line1.strip()[:300],
        "city": (body.city or "").strip()[:80], "phone": (body.phone or "").strip()[:15],
        "lat": body.lat, "lng": body.lng,
        "is_default": bool(body.is_default) or count == 0,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    if addr["is_default"]:
        await db.addresses.update_many({"user_id": user["id"]}, {"$set": {"is_default": False}})
    await db.addresses.insert_one(dict(addr))
    return addr


@api.patch("/me/addresses/{aid}/default")
async def set_default_address(aid: str, user: dict = Depends(get_current_user)):
    addr = await db.addresses.find_one({"id": aid, "user_id": user["id"]}, {"_id": 0})
    if not addr:
        raise HTTPException(404, "Address not found")
    await db.addresses.update_many({"user_id": user["id"]}, {"$set": {"is_default": False}})
    await db.addresses.update_one({"id": aid}, {"$set": {"is_default": True}})
    return {**addr, "is_default": True}


@api.delete("/me/addresses/{aid}")
async def delete_address(aid: str, user: dict = Depends(get_current_user)):
    await db.addresses.delete_one({"id": aid, "user_id": user["id"]})
    return {"ok": True}


# ----------------------------- Saved payment methods (per-user, masked — PCI-safe) -----------------------------
class PaymentMethodCreate(BaseModel):
    type: str  # "card" | "upi"
    # card (masked only — full number/CVV must NEVER be sent or stored)
    last4: Optional[str] = None
    brand: Optional[str] = None
    name_on_card: Optional[str] = None
    # upi
    upi_id: Optional[str] = None
    is_default: bool = False


@api.get("/me/payment-methods")
async def my_payment_methods(user: dict = Depends(get_current_user)):
    return await db.payment_methods.find({"user_id": user["id"]}, {"_id": 0}).sort("created_at", 1).to_list(30)


@api.post("/me/payment-methods")
async def add_payment_method(body: PaymentMethodCreate, user: dict = Depends(get_current_user)):
    if body.type not in ("card", "upi"):
        raise HTTPException(400, "type must be 'card' or 'upi'")
    if body.type == "card":
        last4 = re.sub(r"\D", "", body.last4 or "")[-4:]
        if len(last4) != 4:
            raise HTTPException(400, "last4 (4 digits) is required for cards")
        detail = {"last4": last4, "brand": (body.brand or "Card")[:20], "name_on_card": (body.name_on_card or "")[:60]}
    else:
        upi = (body.upi_id or "").strip().lower()
        if not re.match(r"^[\w.\-]{2,}@[a-z]{2,}$", upi):
            raise HTTPException(400, "Enter a valid UPI ID like name@upi")
        detail = {"upi_id": upi}
    count = await db.payment_methods.count_documents({"user_id": user["id"]})
    pm = {
        "id": str(uuid.uuid4()), "user_id": user["id"], "type": body.type, **detail,
        "is_default": bool(body.is_default) or count == 0,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    if pm["is_default"]:
        await db.payment_methods.update_many({"user_id": user["id"]}, {"$set": {"is_default": False}})
    await db.payment_methods.insert_one(dict(pm))
    return pm


@api.patch("/me/payment-methods/{pid}/default")
async def set_default_payment_method(pid: str, user: dict = Depends(get_current_user)):
    pm = await db.payment_methods.find_one({"id": pid, "user_id": user["id"]}, {"_id": 0})
    if not pm:
        raise HTTPException(404, "Payment method not found")
    await db.payment_methods.update_many({"user_id": user["id"]}, {"$set": {"is_default": False}})
    await db.payment_methods.update_one({"id": pid}, {"$set": {"is_default": True}})
    return {**pm, "is_default": True}


@api.delete("/me/payment-methods/{pid}")
async def delete_payment_method(pid: str, user: dict = Depends(get_current_user)):
    await db.payment_methods.delete_one({"id": pid, "user_id": user["id"]})
    return {"ok": True}


# ----------------------------- Bulk menu import (CSV-driven from client) -----------------------------
class BulkMenuCreate(BaseModel):
    items: List[MenuItemCreate]


def _build_item_doc(rid: str, body: MenuItemCreate, cat_name: str, approval_status: str) -> dict:
    images = (body.images or [])[:5]
    primary = body.image or (images[0] if images else "")
    return {
        "id": str(uuid.uuid4()),
        "restaurant_id": rid,
        "name": body.name,
        "description": body.description or "",
        "price": body.price,
        "baseline_price": int(body.price or 0),
        "image": primary,
        "images": images,
        "category": cat_name or (body.category or ""),
        "category_id": body.category_id,
        "veg": body.veg,
        "available": body.is_available,
        "is_available": body.is_available,
        "out_of_stock": body.out_of_stock,
        "prep_time": body.prep_time,
        "rating": 4.2,
        "approval_status": approval_status,
        "reject_reason": None,
    }


async def _resolve_cat(rid: str, body: MenuItemCreate) -> str:
    if body.category_id:
        cat = await db.categories.find_one({"id": body.category_id, "restaurant_id": rid}, {"_id": 0})
        if cat:
            return cat["name"]
    if body.category:
        cat = await db.categories.find_one(
            {"restaurant_id": rid, "name": {"$regex": f"^{body.category}$", "$options": "i"}}, {"_id": 0}
        )
        if cat:
            body.category_id = cat["id"]
            return cat["name"]
    return body.category or ""


@api.post("/admin/restaurants/{rid}/menu/bulk")
async def admin_bulk_menu(rid: str, body: BulkMenuCreate, user: dict = Depends(require_role("admin"))):
    rest = await db.restaurants.find_one({"id": rid}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "Restaurant not found")
    created = []
    for it in body.items:
        if not it.name or it.price is None:
            continue
        cat_name = await _resolve_cat(rid, it)
        doc = _build_item_doc(rid, it, cat_name, "approved")
        await db.menu_items.insert_one(dict(doc))
        created.append(doc)
    return {"created": len(created), "items": created}


@api.post("/owner/menu/bulk")
async def owner_bulk_menu(body: BulkMenuCreate, user: dict = Depends(require_role("restaurant_owner"))):
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant assigned to you yet. Contact admin.")
    rid = rest["id"]
    valid = [it for it in body.items if it.name and it.price is not None]
    # Always generate fresh appetizing descriptions (one batched LLM call).
    descs = await _generate_descriptions_batch([{"name": it.name, "veg": it.veg} for it in valid])
    created = []
    for it, desc in zip(valid, descs):
        cat_name = await _resolve_cat(rid, it)
        doc = _build_item_doc(rid, it, cat_name, "pending")
        if desc:
            doc["description"] = desc
        # NO AI photo auto-generation. Any image provided in the import (e.g. CSV
        # "image" column) is preserved by _build_item_doc; otherwise it stays blank
        # and the UI shows a graceful fallback. (Owner requested: AI menu scan must
        # not generate item photos.)
        doc["image_status"] = None
        await db.menu_items.insert_one(dict(doc))
        created.append(doc)
    return {"created": len(created), "items": created, "images_generating": 0}


# ----------------------------- AI Menu Extraction (Gemini 2.5 Flash) -----------------------------
class AiMenuExtractRequest(BaseModel):
    file_base64: str            # base64 of the image/PDF (data-URL prefix allowed)
    mime_type: str              # image/jpeg | image/png | application/pdf
    filename: Optional[str] = None


SUPPORTED_EXTRACT_MIME = {"image/jpeg", "image/jpg", "image/png", "application/pdf"}

MENU_EXTRACT_PROMPT = (
    "You are a menu digitization assistant for a food delivery app. "
    "Carefully read the ENTIRE attached menu (it may be a photo or a multi-page PDF) and extract every dish. "
    "Return ONLY valid minified JSON (no markdown fences, no commentary) using EXACTLY this schema:\n"
    '{"categories":[{"name":"string","items":[{"name":"string","price":number,"description":"string","veg":true}]}]}\n'
    "Rules:\n"
    "- price: integer in rupees only (strip any currency symbol/decimals; if a range, use the lowest).\n"
    "- veg: true for vegetarian, false for non-vegetarian. Use common cues (green dot/[V]=veg, red dot/[N]/chicken/mutton/fish/egg/prawn=non-veg). Default true if unclear.\n"
    "- description: short item description if visible, else an empty string.\n"
    "- Group items under their printed category/section headings. If no category is printed, use \"Menu\".\n"
    "- Include EVERY item from ALL pages. Do not invent items that are not on the menu.\n"
    "- If the file has no readable menu, return {\"categories\":[]}."
)


def _parse_menu_json(raw: str) -> dict:
    """Robustly parse JSON from an LLM response (strips fences / surrounding text)."""
    if not raw:
        return {"categories": []}
    text = raw.strip()
    m = re.search(r"```(?:json)?\s*(.*?)```", text, re.DOTALL)
    if m:
        text = m.group(1).strip()
    if not text.startswith("{"):
        s, e = text.find("{"), text.rfind("}")
        if s != -1 and e != -1 and e > s:
            text = text[s:e + 1]
    return json.loads(text)


def _sanitize_extracted(data: dict) -> List[dict]:
    """Normalize the model output into clean categories[] with items[]."""
    out: List[dict] = []
    seen_cat = {}
    for cat in (data.get("categories") or []):
        cname = str(cat.get("name") or "Menu").strip() or "Menu"
        key = cname.lower()
        if key in seen_cat:
            bucket = seen_cat[key]
        else:
            bucket = {"name": cname, "items": []}
            seen_cat[key] = bucket
            out.append(bucket)
        for it in (cat.get("items") or []):
            name = str(it.get("name") or "").strip()
            if not name:
                continue
            # coerce price -> int
            raw_price = it.get("price", 0)
            try:
                if isinstance(raw_price, str):
                    digits = re.sub(r"[^0-9.]", "", raw_price)
                    price = int(float(digits)) if digits else 0
                else:
                    price = int(round(float(raw_price)))
            except Exception:
                price = 0
            veg = it.get("veg")
            veg = True if veg is None else bool(veg)
            bucket["items"].append({
                "name": name[:120],
                "price": max(0, price),
                "description": str(it.get("description") or "").strip()[:300],
                "veg": veg,
            })
    # drop empty categories
    return [c for c in out if c["items"]]


async def _gemini_extract_menu(file_base64: str, mime_type: str) -> List[dict]:
    """Send an image/PDF to Gemini 2.5 Flash and return normalized categories[]."""
    from gemini_client import gemini_vision

    if not GEMINI_API_KEY:
        raise HTTPException(500, "AI key not configured on server")

    mime = (mime_type or "").lower().strip()
    if mime == "image/jpg":
        mime = "image/jpeg"
    if mime not in SUPPORTED_EXTRACT_MIME:
        raise HTTPException(400, "Unsupported file type. Upload a JPG, PNG, or PDF.")

    # strip data-url prefix if present
    b64 = file_base64
    if "," in b64 and b64.strip().lower().startswith("data:"):
        b64 = b64.split(",", 1)[1]
    try:
        binary = base64.b64decode(b64)
    except Exception:
        raise HTTPException(400, "Invalid file data")
    if len(binary) > 20 * 1024 * 1024:
        raise HTTPException(400, "File too large. Max 20 MB. Please use a smaller photo.")

    # Normalize/downscale images so Gemini gets a fast, reliable payload.
    # Phone menu photos are often huge (4000px, 8MB+) which makes the vision call
    # slow enough to hit the ingress timeout -> 502. Re-encode to a capped JPEG.
    if mime != "application/pdf":
        try:
            import io as _io
            from PIL import Image as _Image
            im = _Image.open(_io.BytesIO(binary))
            if getattr(im, "mode", None) in ("RGBA", "P", "LA"):
                im = im.convert("RGB")
            elif im.mode != "RGB":
                im = im.convert("RGB")
            max_side = 2048
            w, h = im.size
            if max(w, h) > max_side:
                scale = max_side / float(max(w, h))
                im = im.resize((max(1, int(w * scale)), max(1, int(h * scale))))
            buf = _io.BytesIO()
            im.save(buf, format="JPEG", quality=85, optimize=True)
            binary = buf.getvalue()
            b64 = base64.b64encode(binary).decode()
            mime = "image/jpeg"
        except Exception:
            # If Pillow can't read it (corrupt / unsupported like HEIC), give a clear message
            log.warning("Could not decode uploaded menu image for normalization")
            raise HTTPException(400, "Couldn't read this image. Please upload a clear JPG/PNG photo or a PDF.")

    tmp_path = None
    try:
        raw = await asyncio.wait_for(
            gemini_vision(
                "You extract restaurant menus into strict JSON.",
                MENU_EXTRACT_PROMPT,
                binary,
                mime,
                model="gemini-2.5-flash",
            ),
            timeout=55,
        )
    except HTTPException:
        raise
    except asyncio.TimeoutError:
        log.warning("Gemini menu extraction timed out")
        raise HTTPException(504, "The menu is taking too long to read. Please try a clearer or smaller photo, or add items manually.")
    except Exception as e:
        emsg = str(e)
        log.exception("Gemini menu extraction failed")
        low = emsg.lower()
        if "budget" in low or "exceeded" in low or "quota" in low or "insufficient" in low:
            raise HTTPException(503, "AI is temporarily unavailable (Gemini quota exhausted). Please check your GEMINI_API_KEY billing and try again.")
        if "429" in low or "rate" in low:
            raise HTTPException(503, "AI is busy right now. Please try again in a moment.")
        raise HTTPException(502, f"AI extraction failed: {emsg[:180]}")
    finally:
        if tmp_path and os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass

    try:
        data = _parse_menu_json(raw)
    except Exception:
        log.warning("Could not parse AI JSON: %s", (raw or "")[:300])
        raise HTTPException(502, "Could not read the menu. Please try a clearer photo or PDF.")

    return _sanitize_extracted(data)


# ----------------------------- FREE menu extraction (Tesseract OCR, no LLM cost) -----------------------------
OCR_SUPPORTED_MIME = {"image/jpeg", "image/jpg", "image/png"}

# Keywords that strongly imply a non-vegetarian dish (word-boundary matched, lowercase).
_NONVEG_RE = re.compile(
    r"\b(chicken|mutton|fish|prawn|prawns|shrimp|egg|eggs|meat|lamb|beef|pork|"
    r"seekh|keema|kheema|bacon|ham|sausage|wings|drumstick|fry\s?piece|"
    r"tangdi|tangri|chorizo|salami|pepperoni|tuna|crab)\b"
)

# Lines that are almost certainly NOT menu items (section noise / footers).
_OCR_NOISE_RE = re.compile(
    r"\b(gst|taxes?|extra|contact|call|order|timing|address|whatsapp|delivery|"
    r"open|closed|menu\s*card|scan|www\.|http|@|price\s*list)\b",
    re.IGNORECASE,
)

# A trailing "price block" at end of line: 120  |  Rs.120  |  ₹120  |  148 / 328 / 598
_TRAILING_PRICE_RE = re.compile(
    r"(?:(?:₹|rs\.?|inr)\s*)?\d{2,4}(?:\.\d{1,2})?"
    r"(?:\s*[/|-]\s*(?:(?:₹|rs\.?|inr)\s*)?\d{2,4}(?:\.\d{1,2})?)*\s*$",
    re.IGNORECASE,
)
_DIGITS_RE = re.compile(r"\d{2,4}")


def _guess_veg(name: str) -> bool:
    """Heuristic veg/non-veg guess from the item name. Defaults to veg when unsure."""
    return not bool(_NONVEG_RE.search((name or "").lower()))


def _clean_ocr_name(s: str) -> str:
    """Tidy an OCR'd item/category name: drop leading bullets, veg tags, stray punctuation."""
    s = re.sub(r"\s+", " ", s or "").strip()
    # remove common bracketed tags e.g. [veg & non], (6"/9"/12")
    s = re.sub(r"[\[\(\{].*?[\]\)\}]", "", s).strip()
    # strip leading list bullets / dots / dashes
    s = re.sub(r"^[\-\–\—\*\.\·•\|:\s]+", "", s)
    # strip trailing separators / dotted leaders
    s = re.sub(r"[\.\-\_\–\—\s]+$", "", s)
    return s.strip()


def _looks_like_category(line: str) -> bool:
    """A short line with no price and a high uppercase ratio is likely a section header."""
    letters = [c for c in line if c.isalpha()]
    if len(letters) < 2 or len(line) > 34:
        return False
    upper = sum(1 for c in letters if c.isupper())
    return (upper / len(letters)) >= 0.6


def _parse_ocr_menu_text(text: str) -> List[dict]:
    """Turn raw OCR text into normalized categories[] with items[] (best-effort heuristics)."""
    raw_cats: dict = {}
    order: List[str] = []
    current = "Menu"

    def bucket(name: str) -> dict:
        key = name.lower()
        if key not in raw_cats:
            raw_cats[key] = {"name": name, "items": [], "seen": set()}
            order.append(key)
        return raw_cats[key]

    for rawline in (text or "").splitlines():
        line = re.sub(r"\s+", " ", rawline).strip()
        if not line or len(line) < 3:
            continue
        if _OCR_NOISE_RE.search(line):
            continue

        m = _TRAILING_PRICE_RE.search(line)
        price_block = m.group(0) if m else ""
        # a real price block must actually contain a 2-4 digit number
        has_price = bool(m and _DIGITS_RE.search(price_block))

        if has_price and m.start() > 0:
            name = _clean_ocr_name(line[: m.start()])
            if len(re.sub(r"[^a-zA-Z]", "", name)) < 2:
                continue  # no meaningful name -> skip
            nums = [int(n) for n in _DIGITS_RE.findall(price_block)]
            nums = [n for n in nums if 10 <= n <= 5000]
            if not nums:
                continue
            price = min(nums)  # for ranges (S/M/L) use the lowest
            b = bucket(current)
            nk = name.lower()
            if nk in b["seen"]:
                continue
            b["seen"].add(nk)
            b["items"].append({
                "name": name[:120],
                "price": price,
                "description": "",
                "veg": _guess_veg(name),
            })
        elif not _DIGITS_RE.search(line) and _looks_like_category(line):
            cname = _clean_ocr_name(line)
            if cname:
                current = cname.title()[:60]

    out = []
    for key in order:
        c = raw_cats[key]
        if c["items"]:
            out.append({"name": c["name"], "items": c["items"]})
    return out


def _ocr_extract_menu_sync(file_base64: str, mime_type: str) -> List[dict]:
    """Blocking OCR pipeline: base64 image -> Tesseract text -> parsed categories[]. Images only."""
    import io as _io
    import pytesseract
    from PIL import Image as _Image, ImageOps as _ImageOps

    mime = (mime_type or "").lower().strip()
    if mime == "image/jpg":
        mime = "image/jpeg"
    if mime == "application/pdf":
        raise HTTPException(400, "Free scan works with photos only. Please upload a JPG/PNG image (or use AI Scan for PDFs).")
    if mime not in OCR_SUPPORTED_MIME:
        raise HTTPException(400, "Unsupported file type. Upload a JPG or PNG photo.")

    b64 = file_base64
    if "," in b64 and b64.strip().lower().startswith("data:"):
        b64 = b64.split(",", 1)[1]
    try:
        binary = base64.b64decode(b64)
    except Exception:
        raise HTTPException(400, "Invalid file data")
    if len(binary) > 20 * 1024 * 1024:
        raise HTTPException(400, "File too large. Max 20 MB. Please use a smaller photo.")

    try:
        im = _Image.open(_io.BytesIO(binary))
        im = _ImageOps.exif_transpose(im)         # respect phone orientation
        im = im.convert("L")                       # grayscale helps OCR
        im = _ImageOps.autocontrast(im)            # boost contrast
        w, h = im.size
        max_side = 2600
        if max(w, h) > max_side:
            scale = max_side / float(max(w, h))
            im = im.resize((max(1, int(w * scale)), max(1, int(h * scale))))
        elif max(w, h) < 1000:                     # upscale tiny photos for better OCR
            scale = 1000.0 / float(max(w, h))
            im = im.resize((int(w * scale), int(h * scale)))
    except HTTPException:
        raise
    except Exception:
        log.warning("OCR could not decode uploaded image")
        raise HTTPException(400, "Couldn't read this image. Please upload a clear JPG/PNG photo.")

    try:
        text = pytesseract.image_to_string(im, config="--psm 4", timeout=40)
    except RuntimeError:
        # pytesseract raises RuntimeError on timeout
        raise HTTPException(504, "Reading the menu took too long. Please try a smaller/clearer photo.")
    except pytesseract.TesseractNotFoundError:
        # The tesseract system binary is not available on this server.
        log.error("Tesseract binary not found on server (free OCR unavailable)")
        raise HTTPException(503, "Free scan is temporarily unavailable on this server. Please use \u201cScan with AI\u201d instead.")
    except Exception as e:
        log.exception("Tesseract OCR failed")
        raise HTTPException(502, f"OCR failed: {str(e)[:150]}")

    return _parse_ocr_menu_text(text)


async def _ocr_extract_menu(file_base64: str, mime_type: str) -> List[dict]:
    """Async wrapper — runs the blocking OCR pipeline in a thread so we don't block the event loop."""
    return await asyncio.to_thread(_ocr_extract_menu_sync, file_base64, mime_type)



# ----------------------------- AI description generation -----------------------------
# NOTE: AI item PHOTO generation has been fully removed (owner request). Menu items
# only get AI-generated *descriptions*; photos must be uploaded manually if desired.
TEXT_MODEL = "gemini-2.5-flash"


def _clean_desc(s: str) -> str:
    s = (s or "").strip().strip('"').strip()
    return s[:160]


async def _generate_item_description(name: str, veg: bool = True) -> str:
    if not GEMINI_API_KEY or not (name or "").strip():
        return ""
    from gemini_client import gemini_text
    diet = "vegetarian" if veg else "non-vegetarian"
    prompt = (
        f"Write ONE short, appetizing menu description (max 18 words, no quotes, no emojis) "
        f"for an Indian {diet} dish called '{name.strip()}'. Return ONLY the sentence."
    )
    try:
        raw = await gemini_text("You are a food copywriter for a restaurant menu.", prompt, model=TEXT_MODEL)
        return _clean_desc(raw)
    except Exception as e:
        log.warning("Item description generation failed for %r: %s", (name or "")[:40], str(e)[:160])
        return ""


async def _generate_descriptions_batch(items: List[dict]) -> List[str]:
    """items: [{name, veg}] -> aligned list of descriptions. One LLM call; '' fallback per item on failure."""
    names = [(i.get("name") or "").strip() for i in items]
    if not GEMINI_API_KEY or not any(names):
        return ["" for _ in items]
    from gemini_client import gemini_text
    listing = "\n".join(
        f'{idx}. {n} ({"veg" if items[idx].get("veg", True) else "non-veg"})'
        for idx, n in enumerate(names)
    )
    prompt = (
        "For each numbered Indian dish below, write ONE short appetizing menu description "
        "(max 18 words each, no emojis). Return ONLY minified JSON: a list of objects "
        '[{"i":0,"d":"..."}] using the same index i.\n' + listing
    )
    try:
        raw = await gemini_text("You are a food copywriter. Output strict JSON only.", prompt, model=TEXT_MODEL)
        text = (raw or "").strip()
        m = re.search(r"```(?:json)?\s*(.*?)```", text, re.DOTALL)
        if m:
            text = m.group(1).strip()
        s, e = text.find("["), text.rfind("]")
        if s != -1 and e != -1 and e > s:
            text = text[s:e + 1]
        arr = json.loads(text)
        out = ["" for _ in items]
        for obj in arr:
            try:
                i = int(obj.get("i", -1))
            except Exception:
                continue
            if 0 <= i < len(out):
                out[i] = _clean_desc(str(obj.get("d", "")))
        return out
    except Exception as e:
        log.warning("Batch description generation failed: %s", str(e)[:160])
        return ["" for _ in items]


async def _bg_generate_images(item_ids: List[str]):
    """DEPRECATED no-op: AI item photo generation has been removed (owner request).
    Kept as a stub so any stale references never generate images."""
    return None


class AiGenerateRequest(BaseModel):
    name: str
    veg: bool = True
    fields: List[str] = ["description"]


@api.post("/owner/menu/ai-generate")
async def owner_menu_ai_generate(body: AiGenerateRequest, user: dict = Depends(require_role("restaurant_owner"))):
    """On-demand: generate a fresh DESCRIPTION from an item name (manual add form / regenerate).
    Item photo generation has been removed — this endpoint never returns an image."""
    if not body.name.strip():
        raise HTTPException(400, "Enter an item name first")
    return {"description": await _generate_item_description(body.name, body.veg)}


def _extract_payload(rest: dict, categories: List[dict], source: str, fallback: bool = False) -> dict:
    return {
        "restaurant_id": rest["id"],
        "restaurant_name": rest.get("name"),
        "categories": categories,
        "category_count": len(categories),
        "item_count": sum(len(c["items"]) for c in categories),
        "source": source,
        "fallback": fallback,
    }


@api.post("/owner/menu/ai-extract")
async def owner_ai_extract_menu(body: AiMenuExtractRequest, user: dict = Depends(require_role("restaurant_owner"))):
    """Owner uploads a menu photo/PDF -> Gemini reads it. If AI is unavailable (budget/quota/rate/timeout)
    we automatically fall back to FREE on-device OCR (images only) so the owner is never blocked."""
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant assigned to you yet. Contact admin.")

    mime = (body.mime_type or "").lower().strip()
    is_image = mime in OCR_SUPPORTED_MIME or mime == "image/jpg"

    try:
        categories = await _gemini_extract_menu(body.file_base64, body.mime_type)
        return _extract_payload(rest, categories, source="ai")
    except HTTPException as e:
        # Only auto-fallback when the AI itself was the problem (not bad input) and we have an image to OCR.
        if e.status_code in (502, 503, 504) and is_image:
            log.info("AI extract failed (%s) — falling back to free OCR", e.status_code)
            try:
                ocr_categories = await _ocr_extract_menu(body.file_base64, body.mime_type)
            except HTTPException:
                raise e  # OCR also couldn't handle it -> surface the original AI error
            if ocr_categories:
                return _extract_payload(rest, ocr_categories, source="ocr", fallback=True)
        raise


@api.post("/owner/menu/ocr-extract")
async def owner_ocr_extract_menu(body: AiMenuExtractRequest, user: dict = Depends(require_role("restaurant_owner"))):
    """FREE menu scan: reads a menu PHOTO with on-device Tesseract OCR (no LLM cost / no key balance needed)."""
    rest = await db.restaurants.find_one({"owner_id": user["id"]}, {"_id": 0})
    if not rest:
        raise HTTPException(404, "No restaurant assigned to you yet. Contact admin.")
    categories = await _ocr_extract_menu(body.file_base64, body.mime_type)
    return _extract_payload(rest, categories, source="ocr")



# ----------------------------- Background: Rider simulation -----------------------------
@api.post("/orders/{oid}/simulate-rider-step")
async def simulate_step(oid: str):
    """Advances rider position 10% toward customer address (demo helper)."""
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    dest_lat = o["address"]["lat"]
    dest_lng = o["address"]["lng"]
    cur_lat = o.get("rider_lat") or dest_lat
    cur_lng = o.get("rider_lng") or dest_lng
    new_lat = cur_lat + (dest_lat - cur_lat) * 0.15
    new_lng = cur_lng + (dest_lng - cur_lng) * 0.15
    await db.orders.update_one({"id": oid}, {"$set": {"rider_lat": new_lat, "rider_lng": new_lng}})
    return {"rider_lat": new_lat, "rider_lng": new_lng}


# Demo timeline for auto progression (seconds after placed_at)
_SIM_SCHEDULE = [
    (0, "placed"),
    (15, "accepted"),
    (30, "preparing"),
    (45, "ready"),
    (60, "picked"),
]
_STATUS_ORDER = ["placed", "accepted", "preparing", "ready", "picked", "delivered"]


def _status_rank(s: str) -> int:
    try:
        return _STATUS_ORDER.index(s)
    except ValueError:
        return -1


@api.post("/orders/{oid}/simulate-progress")
async def simulate_progress(oid: str):
    """Time-driven demo progression: auto-advances order status based on
    seconds elapsed since `placed_at`, auto-assigns a demo rider when entering
    `picked`, and steps the rider toward the customer. Idempotent.
    Skips orders that are not flagged `simulated`, are `cancelled`, or already
    `delivered`. Will never roll a status backwards (if a real actor advanced
    it manually, the schedule catches up rather than reverting).
    """
    o = await db.orders.find_one({"id": oid}, {"_id": 0})
    if not o:
        raise HTTPException(404, "Not found")
    if not o.get("simulated", True):
        return {"order": o, "skipped": "not_simulated"}
    if o.get("status") in ("delivered", "cancelled"):
        return {"order": o, "skipped": "terminal"}

    # Parse placed_at
    try:
        placed = datetime.fromisoformat(o["placed_at"].replace("Z", "+00:00"))
    except Exception:
        placed = datetime.now(timezone.utc)
    elapsed = (datetime.now(timezone.utc) - placed).total_seconds()

    # Determine target status from schedule
    target = "placed"
    for sec, st in _SIM_SCHEDULE:
        if elapsed >= sec:
            target = st
    cur_status = o.get("status", "placed")
    new_status = target if _status_rank(target) > _status_rank(cur_status) else cur_status

    updates: dict = {}

    # Auto-assign a demo rider when entering `picked`
    if new_status == "picked" and not o.get("rider_id"):
        rider = await db.users.find_one({"role": "rider"}, {"_id": 0})
        if rider:
            updates["rider_id"] = rider["id"]
            updates["rider_name"] = rider.get("name") or "Demo Rider"
        # Initialize rider position at restaurant if missing
        if o.get("restaurant_lat") and o.get("restaurant_lng"):
            updates["rider_lat"] = o["restaurant_lat"]
            updates["rider_lng"] = o["restaurant_lng"]

    if new_status != cur_status:
        updates["status"] = new_status

    # While picked, step rider toward destination
    if (new_status == "picked") and o.get("address"):
        dest_lat = o["address"].get("lat")
        dest_lng = o["address"].get("lng")
        if dest_lat is not None and dest_lng is not None:
            cur_lat = updates.get("rider_lat", o.get("rider_lat") or dest_lat)
            cur_lng = updates.get("rider_lng", o.get("rider_lng") or dest_lng)
            new_lat = cur_lat + (dest_lat - cur_lat) * 0.22
            new_lng = cur_lng + (dest_lng - cur_lng) * 0.22
            updates["rider_lat"] = new_lat
            updates["rider_lng"] = new_lng
            # If very close, mark delivered
            d2 = (dest_lat - new_lat) ** 2 + (dest_lng - new_lng) ** 2
            if d2 < 1e-7:  # ~0.0003 degrees
                updates["status"] = "delivered"
                updates["rider_lat"] = dest_lat
                updates["rider_lng"] = dest_lng

    if updates:
        await db.orders.update_one({"id": oid}, {"$set": updates})

    fresh = await db.orders.find_one({"id": oid}, {"_id": 0})
    return {"order": fresh, "elapsed": int(elapsed), "applied": list(updates.keys())}


